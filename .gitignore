## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build Folders
[Bb]in/
[Oo]bj/

# Visual Studio specific files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet Packages
packages/
*.nupkg

# Tests
TestResults/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log