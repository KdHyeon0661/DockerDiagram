<Window x:Class="DockerDiagram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DockerDiagram.ViewModels"
        mc:Ignorable="d"
        Title="Visual Docker Manager"
        Height="720" Width="1280"
        MinHeight="640" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/MainWindow/MainWindow.Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="#F4F6F8" BorderBrush="#D5D9DE" BorderThickness="0,0,1,0" Padding="10,10,0,10" Panel.ZIndex="10">
            <ScrollViewer Style="{StaticResource SidebarScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          BorderThickness="0">
                <StackPanel Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Create" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,10" Foreground="#343A43"/>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Container" 
                    PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource ContainerIcon}" Fill="#007ACC" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Container" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Volume" 
                    PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource DatabaseIcon}" Fill="#E67E22" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Volume" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Internet" 
                            PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource GlobeIcon}" Fill="#3498DB" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Internet" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Network" 
                    PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource CloudIcon}" Fill="#9B59B6" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Network" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Group" 
                            PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                  Fill="#F1C40F" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Group" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Expander IsExpanded="False" Style="{StaticResource SidebarExpanderStyle}" Margin="0,8,0,0">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource ContainerIcon}" Fill="#3F6F95" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Stack Templates" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Explorer.StackTemplates.Count}" FontSize="10" Foreground="#59636F"/>
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <ListBox ItemsSource="{Binding Explorer.StackTemplates}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ResourceListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            Cursor="Hand"
                                            Padding="3,4"
                                            PreviewMouseLeftButtonDown="StackTemplate_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="StackTemplate_PreviewMouseLeftButtonUp"
                                            MouseMove="StackTemplate_MouseMove">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding AccentColor}" CornerRadius="2" Margin="0,1,0,1"/>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#303842" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResourceSummary}" FontSize="10" Foreground="#7B8591" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </StackPanel>

                <Separator Margin="0,14,0,12" Background="#D5D9DE"/>

                <StackPanel>
                        <StackPanel Margin="2,0,2,6">
                            <TextBlock Text="{Binding Explorer.ResourceHeader}" FontWeight="SemiBold" FontSize="13" Foreground="#343A43"/>
                            <TextBlock Text="{Binding Explorer.LastSyncTime}" FontSize="10" Foreground="#8A929D" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Expander IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}"
                                  Visibility="{Binding Explorer.IsDockerRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource ContainerIcon}" Fill="#4D7C6F" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Compose Projects" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Explorer.ComposeProjects.Count}" FontSize="10" Foreground="#59636F"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Explorer.ComposeProjects}" Margin="4,1,2,5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="Transparent"
                                                        Padding="0,3"
                                                        ToolTip="{Binding WorkingDirectory}"
                                                        Cursor="Hand"
                                                        PreviewMouseLeftButtonDown="ComposeProject_PreviewMouseLeftButtonDown"
                                                        PreviewMouseLeftButtonUp="ComposeProject_PreviewMouseLeftButtonUp"
                                                        MouseMove="ComposeProject_MouseMove">
                                                    <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#36434A" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="1" Background="#E7EEF4" CornerRadius="7" Padding="5,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="9" Foreground="#59636F"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding ResourceCount}" FontSize="10" Foreground="#7A858D" Margin="8,0,4,0"/>
                                                    </Grid>
                                                </Border>
                                                <ToggleButton x:Name="ComposeProjectDetailsToggle"
                                                              Grid.Column="1"
                                                              IsChecked="{Binding IsDetailsExpanded, Mode=TwoWay}"
                                                              Width="24"
                                                              Height="24"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Cursor="Hand"
                                                              FocusVisualStyle="{x:Null}"
                                                              ToolTip="프로젝트 리소스 목록 펼치기">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Chrome"
                                                                    Background="#F7F9FB"
                                                                    BorderBrush="#B8C2CC"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12">
                                                                <Grid>
                                                                    <Path x:Name="DownArrow"
                                                                          Data="M 1,2 L 5,6 L 9,2"
                                                                          Width="10"
                                                                          Height="6"
                                                                          Stroke="#4C5B66"
                                                                          StrokeThickness="1.6"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          Stretch="Fill"/>
                                                                    <Path x:Name="UpArrow"
                                                                          Data="M 1,6 L 5,2 L 9,6"
                                                                          Width="10"
                                                                          Height="6"
                                                                          Stroke="#287BAE"
                                                                          StrokeThickness="1.6"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          Stretch="Fill"
                                                                          Visibility="Collapsed"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Chrome" Property="Background" Value="#EAF4FA"/>
                                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#287BAE"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Chrome" Property="Background" Value="#D7EAF5"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="DownArrow" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="UpArrow" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="Chrome" Property="Background" Value="#EAF4FA"/>
                                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#287BAE"/>
                                                                    <Setter Property="ToolTip" Value="프로젝트 리소스 목록 접기"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </Grid>
                                            <StackPanel Grid.Row="1"
                                                        Margin="18,2,0,5"
                                                        Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Containers" FontSize="10" FontWeight="SemiBold" Foreground="#287BAE" Margin="0,2,0,1"/>
                                                <ItemsControl ItemsSource="{Binding Containers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding ComposeServiceName}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                <TextBlock Grid.Column="1" FontSize="10" Foreground="#7A858D" Margin="6,0,3,0">
                                                                    <Run Text="#"/><Run Text="{Binding ComposeContainerNumber}"/><Run Text="  "/><Run Text="{Binding State}"/>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Volumes" FontSize="10" FontWeight="SemiBold" Foreground="#D9822B" Margin="0,5,0,1"/>
                                                <ItemsControl ItemsSource="{Binding Volumes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding ComposeResourceName}"/>
                                                    </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Networks" FontSize="10" FontWeight="SemiBold" Foreground="#8D5BA6" Margin="0,5,0,1"/>
                                                <ItemsControl ItemsSource="{Binding Networks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding ComposeResourceName}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}"
                                  Visibility="{Binding Explorer.IsSwarmRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource CloudIcon}" Fill="#4D7C6F" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Swarm Nodes" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Explorer.SwarmNodes.Count}" FontSize="10" Foreground="#59636F"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ListBox ItemsSource="{Binding Explorer.SwarmNodes}" BorderThickness="0" Background="Transparent" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource ResourceListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5,4" Background="Transparent" ToolTip="{Binding Id}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                    <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="#7A858D" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding RoleLabel}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Availability}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Address}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Expander IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}"
                                  Visibility="{Binding Explorer.IsKubernetesRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource CloudIcon}" Fill="#326CE5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Kubernetes Nodes" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Explorer.KubernetesNodes.Count}" FontSize="10" Foreground="#59636F"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ListBox ItemsSource="{Binding Explorer.KubernetesNodes}" BorderThickness="0" Background="Transparent" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource ResourceListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5,4" Background="Transparent" ToolTip="{Binding OsImage}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="#7A858D" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding RoleLabel}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Version}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding InternalIp}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Expander IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}"
                                  Visibility="{Binding Explorer.IsKubernetesRuntime, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource ContainerIcon}" Fill="#326CE5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Kubernetes Resources" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Explorer.KubernetesResourceCount}" FontSize="10" Foreground="#59636F"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="4,2,2,5">
                                    <TextBlock Text="Deployments" FontSize="10" FontWeight="SemiBold" Foreground="#326CE5" Margin="0,2,0,1"/>
                                    <ItemsControl ItemsSource="{Binding Explorer.KubernetesDeployments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove" ToolTip="{Binding Ports}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Ports}" FontSize="10" Foreground="#7A858D" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="ReplicaSets" FontSize="10" FontWeight="SemiBold" Foreground="#326CE5" Margin="0,6,0,1"/>
                                    <ItemsControl ItemsSource="{Binding Explorer.KubernetesReplicaSets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove" ToolTip="{Binding Ports}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Ports}" FontSize="10" Foreground="#7A858D" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Services" FontSize="10" FontWeight="SemiBold" Foreground="#326CE5" Margin="0,6,0,1"/>
                                    <ItemsControl ItemsSource="{Binding Explorer.KubernetesServices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove" ToolTip="{Binding Ports}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Ports}" FontSize="10" Foreground="#7A858D" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="ConfigMaps / Secrets" FontSize="10" FontWeight="SemiBold" Foreground="#326CE5" Margin="0,6,0,1"/>
                                    <ItemsControl ItemsSource="{Binding Explorer.KubernetesConfigMaps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove" ToolTip="{Binding Ports}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Explorer.KubernetesSecrets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove" ToolTip="{Binding Ports}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Ingresses / PVCs" FontSize="10" FontWeight="SemiBold" Foreground="#326CE5" Margin="0,6,0,1"/>
                                    <ItemsControl ItemsSource="{Binding Explorer.KubernetesIngresses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove" ToolTip="{Binding Ports}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Ports}" FontSize="10" Foreground="#7A858D" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Explorer.KubernetesPersistentVolumeClaims}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove" ToolTip="{Binding Ports}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Ports}" FontSize="10" Foreground="#7A858D" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <TextBlock Text="Standalone Resources" FontSize="11" FontWeight="SemiBold" Foreground="#6B737C" Margin="4,9,4,4"
                                   Visibility="{Binding Explorer.IsDockerRuntime, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Expander IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource ContainerIcon}" Fill="#287BAE" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Explorer.PrimaryResourceLabel}" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Explorer.ExistingContainers.Count}" FontSize="10" Foreground="#59636F"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <StackPanel>
                                <TextBox Text="{Binding Explorer.ContainerSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBoxStyle}" Tag="{Binding Explorer.PrimaryResourceSearchPlaceholder}" Margin="4,2,4,5"/>
                                <ListBox ItemsSource="{Binding Explorer.ExistingContainers}" BorderThickness="0" Background="Transparent" MaxHeight="250" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource ResourceListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="×"
                                            Command="{Binding DataContext.Explorer.DeleteContainerItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ResourceDeleteButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSwarmService}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKubernetesPod}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="Gray"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="running">
                                                                            <Setter Property="Fill" Value="#28a745"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                                            <Setter Property="Fill" Value="#28a745"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <Expander IsExpanded="False" Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource DatabaseIcon}" Fill="#D9822B" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Volumes" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Explorer.ExistingVolumes.Count}" FontSize="10" Foreground="#59636F"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <StackPanel>
                                <TextBox Text="{Binding Explorer.VolumeSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBoxStyle}" Tag="Search volumes" Margin="4,2,4,5"/>
                                <ListBox ItemsSource="{Binding Explorer.ExistingVolumes}" BorderThickness="0" Background="Transparent" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource ResourceListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource ResourceDeleteButtonStyle}"
                                            Command="{Binding DataContext.Explorer.DeleteVolumeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>

                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource DatabaseIcon}" Fill="#E67E22" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <Expander IsExpanded="False" Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource CloudIcon}" Fill="#8D5BA6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Networks" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Explorer.ExistingNetworks.Count}" FontSize="10" Foreground="#59636F"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <StackPanel>
                                <TextBox Text="{Binding Explorer.NetworkSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBoxStyle}" Tag="Search networks" Margin="4,2,4,5"/>
                                <ListBox ItemsSource="{Binding Explorer.ExistingNetworks}" BorderThickness="0" Background="Transparent" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource ResourceListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="×"
                                            Command="{Binding DataContext.Explorer.DeleteNetworkItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ResourceDeleteButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name}" Value="bridge">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Name}" Value="host">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Name}" Value="none">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Border Padding="5,3" Background="Transparent" Cursor="Hand" Tag="{Binding}" PreviewMouseLeftButtonDown="ExistingItem_PreviewMouseDown" PreviewMouseLeftButtonUp="ExistingItem_PreviewMouseUp" MouseMove="ExistingItem_MouseMove">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource CloudIcon}" Fill="#9B59B6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                            <TextBlock Text="{Binding Driver}" FontSize="10" Foreground="Gray"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0" ClipToBounds="True" AllowDrop="True" Drop="Canvas_Drop"
              Background="#EFEFEF"
              MouseRightButtonDown="Diagram_MouseRightButtonDown"
              MouseRightButtonUp="Diagram_MouseRightButtonUp"
              PreviewMouseLeftButtonDown="Diagram_PreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="Diagram_PreviewMouseLeftButtonUp" 
              MouseMove="Diagram_MouseMove"
              PreviewMouseWheel="Diagram_PreviewMouseWheel">

            <Canvas x:Name="ViewportCanvas" ClipToBounds="True"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    SizeChanged="ViewportCanvas_SizeChanged">

                <Grid x:Name="ZoomPanGrid">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MapScale" ScaleX="{Binding SheetManager.ActiveSheet.Scale, Mode=TwoWay}" ScaleY="{Binding SheetManager.ActiveSheet.Scale, Mode=TwoWay}"/>
                            <TranslateTransform x:Name="MapTranslate" X="{Binding SheetManager.ActiveSheet.OffsetX, Mode=TwoWay}" Y="{Binding SheetManager.ActiveSheet.OffsetY, Mode=TwoWay}"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Grid Width="{Binding SheetManager.ActiveSheet.MapWidth}" Height="{Binding SheetManager.ActiveSheet.MapHeight}">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.3" ShadowDepth="0"/>
                        </Grid.Effect>

                        <Rectangle Fill="White"/>
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#C0C0C0" Thickness="1.0"/>
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <LineGeometry StartPoint="0,0" EndPoint="0,10"/>
                                                    <LineGeometry StartPoint="0,0" EndPoint="10,0"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <ItemsControl ItemsSource="{Binding SheetManager.ActiveSheet.Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" Background="Transparent">
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.5"/>
                                                        <DoubleAnimation Storyboard.TargetName="GroupBlur" Storyboard.TargetProperty="Radius" From="20" To="0" Duration="0:0:0.5">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>

                                        <Rectangle RadiusX="10" RadiusY="10" 
                                                   Stroke="{Binding BorderColor}" 
                                                   StrokeThickness="{Binding StrokeThickness}" 
                                                   StrokeDashArray="{Binding StrokeDashArray}"
                                                   Fill="#05000000" Cursor="Hand"
                                                   MouseLeftButtonDown="GroupBody_MouseDown">
                                            <Rectangle.Effect>
                                                <BlurEffect x:Name="GroupBlur" Radius="0" KernelType="Gaussian"/>
                                            </Rectangle.Effect>
                                        </Rectangle>

                                        <Border Background="{Binding HeaderColor}" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                Margin="15,-12,0,0" Padding="8,2" 
                                                BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="3"
                                                Cursor="SizeAll"
                                                MouseLeftButtonDown="GroupHeader_MouseDown">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📂 " FontSize="10"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{Binding HeaderFontColor}"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-6" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,0" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="Resize_MouseDown"/>
                                        </Grid>

                                        <Grid Panel.ZIndex="95" IsHitTestVisible="False"
                                              Visibility="{Binding IsDockerDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="72" FontWeight="Black" Foreground="#D32F2F" Opacity="0.85"/>
                                        </Grid>

                                        <Grid x:Name="CanvasGroupPortGrid" Opacity="1.0" Visibility="Hidden" Panel.ZIndex="100">
                                            <Border Style="{StaticResource TopArrowPortStyle}" Tag="Top" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowUp}"/>
                                                </Viewbox>
                                            </Border>
                                            <Border Style="{StaticResource BottomArrowPortStyle}" Tag="Bottom" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowDown}"/>
                                                </Viewbox>
                                            </Border>
                                            <Border Style="{StaticResource LeftArrowPortStyle}" Tag="Left" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowLeft}"/>
                                                </Viewbox>
                                            </Border>
                                            <Border Style="{StaticResource RightArrowPortStyle}" Tag="Right" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowRight}"/>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CanvasGroupPortGrid" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding SheetManager.ActiveSheet.Connectors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Canvas MouseLeftButtonDown="Connector_MouseDown" Background="Transparent" Cursor="Hand">
                                            <Polyline Points="{Binding Points}" Stroke="Transparent" StrokeThickness="10"/>
                                            <Polyline Points="{Binding Points}" Stroke="{Binding StrokeColor}" StrokeThickness="2"/>
                                            <Polygon Points="{Binding SourceArrowPoints}" Fill="{Binding StrokeColor}" Stroke="{Binding StrokeColor}" />
                                            <Polygon Points="{Binding ArrowPoints}" Fill="{Binding StrokeColor}" Stroke="{Binding StrokeColor}" />
                                        </Canvas>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Canvas x:Name="ConnectorPreviewCanvas" IsHitTestVisible="False">
                            <Polyline x:Name="TempPolyline" Stroke="Gray" StrokeThickness="2" StrokeDashArray="4 2" Opacity="0.6" Visibility="Collapsed"/>
                        </Canvas>

                        <ItemsControl ItemsSource="{Binding SheetManager.ActiveSheet.Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="99"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" ClipToBounds="False">

                                        <Border x:Name="ContainerView" Visibility="Visible" 
                                                BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="White">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.1"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="24"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{Binding StatusColor}" Height="4" CornerRadius="2,2,0,0"/>
                                                <Border Grid.Row="1" Background="#F0F0F0" Cursor="SizeAll" BorderBrush="#DDD" BorderThickness="0,0,0,1" 
                                                        MouseLeftButtonDown="Node_Header_MouseDown" MouseLeftButtonUp="Node_MouseLeftButtonUp" MouseMove="Node_MouseMove">
                                                    <Grid Margin="10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="🖥️" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" IsHitTestVisible="False"/>
                                                        <TextBlock Grid.Column="2" Text="⚠" Foreground="#D97706" FontSize="11" Margin="5,0,0,0"
                                                                   VerticalAlignment="Center" ToolTip="{Binding ComposePlacementWarning}" IsHitTestVisible="False"
                                                                   Visibility="{Binding HasComposePlacementWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="2" Background="White" Cursor="Hand" MouseLeftButtonDown="Node_Body_MouseDown">
                                                    <Grid Margin="8,2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0">
                                                        <TextBlock Text="{Binding ImageName}" FontSize="10" Foreground="Gray"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ImageName}" IsHitTestVisible="False"/>
                                                        <TextBlock Text="{Binding PortSummary}" FontSize="9" Foreground="#777" Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PortInfo}" IsHitTestVisible="False"/>
                                                        <StackPanel Margin="0,6,0,0"
                                                                    Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    IsHitTestVisible="False">
                                                            <ProgressBar Height="5"
                                                                         Maximum="100"
                                                                         Value="{Binding CreationProgressValue}"
                                                                         IsIndeterminate="{Binding IsCreationProgressIndeterminate}"
                                                                         Foreground="{Binding StatusColor}"
                                                                         Background="#E9ECEF"
                                                                         BorderThickness="0"/>
                                                            <TextBlock Text="{Binding CreationProgressMessage}"
                                                                       FontSize="9"
                                                                       Foreground="#666"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,6,0,0"
                                                                    Visibility="{Binding IsCreationFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="Creation failed"
                                                                       FontSize="10"
                                                                       Foreground="#DC3545"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <UniformGrid Rows="1" Columns="2" Margin="0,4,0,0">
                                                                <Button Content="Retry"
                                                                        Command="{Binding RetryFailedCreationCommand}"
                                                                        Height="20"
                                                                        Margin="0,0,3,0"
                                                                        FontSize="10"
                                                                        Padding="2,0"
                                                                        Background="#0D6EFD"
                                                                        Foreground="White"
                                                                        BorderThickness="0"/>
                                                                <Button Content="Remove"
                                                                        Command="{Binding RemoveFailedCreationCommand}"
                                                                        Height="20"
                                                                        Margin="3,0,0,0"
                                                                        FontSize="10"
                                                                        Padding="2,0"
                                                                        Background="#6C757D"
                                                                        Foreground="White"
                                                                        BorderThickness="0"/>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                        </StackPanel>

                                                        <Border Grid.Row="2" Margin="0,3,0,0" IsHitTestVisible="False">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsCreating}" Value="False"/>
                                                                                <Condition Binding="{Binding IsCreationFailed}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="28"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="CPU" FontSize="8" Foreground="#666" VerticalAlignment="Center"/>
                                                                <ProgressBar Grid.Column="1" Value="{Binding Monitoring.CpuValue, Mode=OneWay, FallbackValue=0}" Height="4" Maximum="100" Foreground="#28a745" Background="#E9ECEF" BorderThickness="0" VerticalAlignment="Center"/>
                                                                <ProgressBar Grid.Column="3" Value="{Binding Monitoring.MemoryValue, Mode=OneWay, FallbackValue=0}" Height="4" Maximum="100" Foreground="#007ACC" Background="#E9ECEF" BorderThickness="0" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                                                                <TextBlock Grid.Column="4" Text="RAM" FontSize="8" Foreground="#666" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid x:Name="VolumeView" Visibility="Collapsed">
                                            <Grid.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.2"/>
                                            </Grid.Effect>
                                            <Border Background="#FFF3E0" BorderBrush="#F57C00" BorderThickness="1,0,1,0" Margin="0,10,0,10"/>
                                            <Ellipse VerticalAlignment="Bottom" Height="20" Fill="#FFE0B2" Stroke="#F57C00" StrokeThickness="1"/>
                                            <Grid VerticalAlignment="Top" Height="20" Cursor="SizeAll" 
                                                  MouseLeftButtonDown="Node_Header_MouseDown" MouseLeftButtonUp="Node_MouseLeftButtonUp" MouseMove="Node_MouseMove">
                                                <Ellipse Fill="#FFB74D" Stroke="#F57C00" StrokeThickness="1"/>
                                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           FontSize="11" FontWeight="Bold" Foreground="#6D4C41" IsHitTestVisible="False"/>
                                            </Grid>
                                            <Border Margin="0,20,0,10" Cursor="Hand" MouseLeftButtonDown="Node_Body_MouseDown" Background="Transparent">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock Text="💾 Storage" FontSize="9" Foreground="#E65100" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ImageName}" FontSize="11" FontWeight="SemiBold" Foreground="#E65100" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid x:Name="InternetView" Visibility="Collapsed">
                                            <Grid.Effect>
                                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.1"/>
                                            </Grid.Effect>

                                            <Border x:Name="InternetNodeBorder" Background="White" BorderBrush="#333" BorderThickness="1" CornerRadius="3">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0" Background="#007ACC" Height="4" CornerRadius="2,2,0,0"/>

                                                    <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,0,0,1"
                                                            Cursor="SizeAll"
                                                            MouseLeftButtonDown="Node_Header_MouseDown" 
                                                            MouseLeftButtonUp="Node_MouseLeftButtonUp" 
                                                            MouseMove="Node_MouseMove">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="🌐" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#333" IsHitTestVisible="False"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Row="2" Background="White" Cursor="Hand"
                                                            MouseLeftButtonDown="Node_Body_MouseDown">
                                                        <Viewbox Margin="15">
                                                            <Path Data="{StaticResource GlobeIcon}" Fill="#007ACC" Stretch="Uniform" IsHitTestVisible="False"/>
                                                        </Viewbox>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Border x:Name="RectSelectionOutline"
                                                BorderBrush="#007ACC"
                                                BorderThickness="2"
                                                CornerRadius="3"
                                                Background="Transparent"
                                                IsHitTestVisible="False"
                                                Panel.ZIndex="90">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                <Condition Binding="{Binding Type}" Value="Container"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                <Condition Binding="{Binding Type}" Value="Internet"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Grid x:Name="VolumeSelectionOutline"
                                              IsHitTestVisible="False"
                                              Panel.ZIndex="90">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                <Condition Binding="{Binding Type}" Value="Volume"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Margin="0,10,0,10"
                                                    Background="Transparent"
                                                    BorderBrush="#007ACC"
                                                    BorderThickness="2,0,2,0"/>
                                            <Ellipse VerticalAlignment="Top"
                                                     Height="20"
                                                     Fill="Transparent"
                                                     Stroke="#007ACC"
                                                     StrokeThickness="2"/>
                                            <Ellipse VerticalAlignment="Bottom"
                                                     Height="20"
                                                     Fill="Transparent"
                                                     Stroke="#007ACC"
                                                     StrokeThickness="2"/>
                                        </Grid>
                                        <Grid Panel.ZIndex="95" IsHitTestVisible="False"
                                              Visibility="{Binding IsDockerDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="54" FontWeight="Black" Foreground="#D32F2F" Opacity="0.85"/>
                                        </Grid>

                                        <Grid x:Name="PortGrid" Opacity="1.0" Visibility="Hidden" Panel.ZIndex="100">
                                            <Border Style="{StaticResource TopArrowPortStyle}" Tag="Top" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowUp}"/>
                                                </Viewbox>
                                            </Border>
                                            <Border Style="{StaticResource BottomArrowPortStyle}" Tag="Bottom" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowDown}"/>
                                                </Viewbox>
                                            </Border>
                                            <Border Style="{StaticResource LeftArrowPortStyle}" Tag="Left" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowLeft}"/>
                                                </Viewbox>
                                            </Border>
                                            <Border Style="{StaticResource RightArrowPortStyle}" Tag="Right" MouseLeftButtonDown="Port_MouseDown">
                                                <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                    <Path Stroke="#007ACC" StrokeThickness="3" Fill="White" Data="{StaticResource ArrowRight}"/>
                                                </Viewbox>
                                            </Border>
                                        </Grid>

                                        <Grid x:Name="ResizeGrid" Visibility="Hidden" Panel.ZIndex="100">
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-5" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="Resize_MouseDown"/>
                                            <Ellipse Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="Resize_MouseDown"/>
                                        </Grid>

                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PortGrid" Property="Visibility" Value="Visible"/>
                                        </Trigger>

                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="ResizeGrid" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Type}" Value="Volume">
                                            <Setter TargetName="ContainerView" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="VolumeView" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="InternetView" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Type}" Value="Internet">
                                            <Setter TargetName="ContainerView" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="VolumeView" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="InternetView" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 6번째 계층: 연결선 양 끝의 데이터 라벨 -->
                        <ItemsControl ItemsSource="{Binding SheetManager.ActiveSheet.Connectors}"
                                      IsHitTestVisible="False"
                                      Panel.ZIndex="900">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Border Canvas.Left="{Binding SourceLabelX}"
                                                Canvas.Top="{Binding SourceLabelY}"
                                                MaxWidth="150"
                                                Padding="4,1"
                                                Background="#F2FFFFFF"
                                                BorderBrush="#B8C0C8"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceDataLabel}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SourceDataLabel}"
                                                       FontSize="10.5"
                                                       Foreground="#30343A"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <Border Canvas.Left="{Binding TargetLabelX}"
                                                Canvas.Top="{Binding TargetLabelY}"
                                                MaxWidth="150"
                                                Padding="4,1"
                                                Background="#F2FFFFFF"
                                                BorderBrush="#B8C0C8"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBidirectional}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TargetDataLabel}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TargetDataLabel}"
                                                       FontSize="10.5"
                                                       Foreground="#30343A"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 7번째 계층: 선택된 연결선의 끝점 조작 핸들 -->
                        <ItemsControl ItemsSource="{Binding SheetManager.ActiveSheet.Connectors}"
                                      Panel.ZIndex="1000">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Panel.ZIndex" Value="1000"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Canvas Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Ellipse Style="{StaticResource ConnectorGripStyle}" Fill="White" Stroke="#007ACC" StrokeThickness="2"
                                                 Canvas.Left="{Binding SourcePos.X}" Canvas.Top="{Binding SourcePos.Y}" Margin="-5,-5,0,0"
                                                 Tag="Source" MouseLeftButtonDown="ConnectorGrip_MouseDown"/>
                                            <Ellipse Style="{StaticResource ConnectorGripStyle}" Fill="#007ACC" Stroke="White" StrokeThickness="2"
                                                 Canvas.Left="{Binding TargetPos.X}" Canvas.Top="{Binding TargetPos.Y}" Margin="-5,-5,0,0"
                                                 Tag="Target" MouseLeftButtonDown="ConnectorGrip_MouseDown"/>
                                        </Canvas>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Canvas x:Name="DragCanvas" IsHitTestVisible="False">
                            <Rectangle x:Name="TempGroupRect" Stroke="#F1C40F" StrokeThickness="2" StrokeDashArray="2 2" Fill="#20F1C40F" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </Grid>
            </Canvas>

            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <StackPanel.Resources>
                    <Style x:Key="CanvasMenuButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#AEB8C2"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#EEF6FC"/>
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#287BAE"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#DCECF7"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#287BAE"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <Button x:Name="BtnOption"
                        Click="OptionButton_Click"
                        Style="{StaticResource CanvasMenuButtonStyle}"
                        ToolTip="파일 / 시트 / Compose">
                    <Viewbox Width="19" Height="19">
                        <Path Data="{StaticResource GlobalOptionsIcon}" Fill="#354A56" Stretch="Uniform"/>
                    </Viewbox>
                </Button>

                <Button x:Name="BtnImageDocker"
                        Click="ImageDockerButton_Click"
                        Style="{StaticResource CanvasMenuButtonStyle}"
                        ToolTip="이미지 / Docker">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,2 L22,7 L12,12 L2,7 Z M2,12 L12,17 L22,12 L22,16 L12,21 L2,16 Z"
                                  Fill="#354A56"
                                  SnapsToDevicePixels="True"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="BtnUndoRedoOptions"
                        Click="UndoRedoOptionsButton_Click"
                        Style="{StaticResource CanvasMenuButtonStyle}"
                        ToolTip="Undo / Redo 옵션">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Data="M9,4 L4,9 L9,14 M4,9 H14 C18,9 20,11 20,14"
                                  Fill="{x:Null}"
                                  Stroke="#354A56"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  SnapsToDevicePixels="True"/>
                            <Path Data="M15,10 L20,15 L15,20 M20,15 H10 C6,15 4,13 4,10"
                                  Fill="{x:Null}"
                                  Stroke="#354A56"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  SnapsToDevicePixels="True"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="BtnCanvasSize"
                        Click="CanvasSizeButton_Click"
                        Style="{StaticResource CanvasMenuButtonStyle}"
                        ToolTip="캔버스 크기">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Data="M9,4 H4 V9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"
                                  Fill="{x:Null}"
                                  Stroke="#354A56"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  SnapsToDevicePixels="True"/>
                            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                       Fill="{x:Null}"
                                       Stroke="#354A56"
                                       StrokeThickness="1.6"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Popup x:Name="OptionPopup" StaysOpen="False" Placement="Right" PlacementTarget="{Binding ElementName=BtnOption}" VerticalOffset="0" HorizontalOffset="4">
                    <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel Width="210" Background="White">
                            <Button Command="{Binding SheetManager.LoadCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="파일 불러오기">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="📂" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="열기..."/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Command="{Binding SheetManager.SaveCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="저장 (덮어쓰기)">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="💾" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="저장"/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Command="{Binding SheetManager.SaveAsCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="다른 이름으로 저장">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="📝" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="다른 이름으로 저장..."/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Separator Margin="0,2,0,2" Background="#DDDDDD"/>
                            <Button Command="{Binding Toolbox.FlowClearCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="현재 시트 초기화">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🧹" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="현재 시트 비우기"/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Command="{Binding Toolbox.FlowAllClearCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="모든 시트 내용 지우기">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🗑️" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="모든 시트 비우기"/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Command="{Binding SheetManager.DeleteAllSheetCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="모든 시트 삭제 후 초기화">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="❌" HorizontalAlignment="Center" Foreground="#dc3545"/><TextBlock Grid.Column="1" Text="모든 시트 삭제" Foreground="#dc3545" FontWeight="SemiBold"/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Separator Margin="0,2,0,2" Background="#DDDDDD"/>
                            <Button Command="{Binding Toolbox.ImportComposeCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="docker-compose.yml 파일에서 새 시트를 만듭니다.">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🐳" HorizontalAlignment="Center" Foreground="#007ACC"/><TextBlock Grid.Column="1" Text="Compose 불러오기..."/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Command="{Binding Toolbox.ExportComposeCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="현재 시트를 docker-compose.yml 파일로 내보냅니다.">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🐳" HorizontalAlignment="Center" Foreground="#007ACC"/><TextBlock Grid.Column="1" Text="Compose 내보내기..."/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Command="{Binding Toolbox.RearrangeComposeCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="선택한 Compose 묶음 다시 정렬">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="↔" HorizontalAlignment="Center" Foreground="#4D7C6F"/><TextBlock Grid.Column="1" Text="Compose 다시 정렬..."/></Grid>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="ImageDockerPopup" StaysOpen="False" Placement="Right" PlacementTarget="{Binding ElementName=BtnImageDocker}" VerticalOffset="0" HorizontalOffset="4">
                    <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel Width="230" Background="White">
                            <Button Click="ManageImages_Click" Style="{StaticResource MenuItemStyle}" ToolTip="도커 이미지 관리"><Button.ContentTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🖼️" HorizontalAlignment="Center" Foreground="#E67E22"/><TextBlock Grid.Column="1" Text="이미지 관리..."/></Grid></DataTemplate></Button.ContentTemplate></Button>
                            <Button Click="ImportImageFromTar_Click" Style="{StaticResource MenuItemStyle}" ToolTip="tar 파일을 현재 Docker 엔진의 이미지로 import합니다."><Button.ContentTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⇧" HorizontalAlignment="Center" Foreground="#28a745"/><TextBlock Grid.Column="1" Text="tar 이미지 가져오기(import)..."/></Grid></DataTemplate></Button.ContentTemplate></Button>
                            <Button Click="LoadImageFromTar_Click" Style="{StaticResource MenuItemStyle}" ToolTip="docker save로 만든 tar 파일을 현재 Docker 엔진에 load합니다."><Button.ContentTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⇪" HorizontalAlignment="Center" Foreground="#007ACC"/><TextBlock Grid.Column="1" Text="tar 이미지 불러오기(load)..."/></Grid></DataTemplate></Button.ContentTemplate></Button>
                            <Separator Margin="0,2,0,2" Background="#DDDDDD"/>
                            <Button Click="MenuBuildImage_Click" Style="{StaticResource MenuItemStyle}" ToolTip="도커파일을 빌드하여 새 이미지를 만듭니다."><Button.ContentTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🛠️" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="이미지만 빌드..."/></Grid></DataTemplate></Button.ContentTemplate></Button>
                            <Button Click="ShowDiskUsage_Click" Style="{StaticResource MenuItemStyle}" ToolTip="현재 Docker 엔진의 이미지, 컨테이너, 볼륨, 빌드 캐시 디스크 사용량을 봅니다."><Button.ContentTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="DU" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#007ACC"/><TextBlock Grid.Column="1" Text="디스크 사용량..."/></Grid></DataTemplate></Button.ContentTemplate></Button>
                            <Button Command="{Binding Toolbox.SystemPruneCommand}" Style="{StaticResource MenuItemStyle}" ToolTip="사용 안 하는 컨테이너/이미지/볼륨/네트워크 일괄 삭제"><Button.ContentTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🧹" HorizontalAlignment="Center" Foreground="#dc3545"/><TextBlock Grid.Column="1" Text="사용하지 않는 리소스 정리" Foreground="#dc3545" FontWeight="SemiBold"/></Grid></DataTemplate></Button.ContentTemplate></Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="UndoRedoOptionsPopup" StaysOpen="False" Placement="Right" PlacementTarget="{Binding ElementName=BtnUndoRedoOptions}" VerticalOffset="0" HorizontalOffset="4">
                    <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel Width="260" Background="White">
                            <CheckBox IsChecked="{Binding History.IncludeDockerResourceHistory, Mode=TwoWay}" Margin="12,8,8,7" ToolTip="체크하면 컨테이너/볼륨/네트워크 생성과 삭제도 Undo/Redo 스택에 저장합니다."><TextBlock Text="Docker 생성/삭제도 실행 취소 기록" FontSize="12" Foreground="#333"/></CheckBox>
                            <CheckBox IsChecked="{Binding History.IncludeVolumeBackupForUndo, Mode=TwoWay}" Margin="12,0,8,8" ToolTip="볼륨 삭제 전에 임시 tar 백업을 만들어 Undo 때 데이터를 복원합니다."><TextBlock Text="실행 취소 전에 볼륨 백업" FontSize="12" Foreground="#333"/></CheckBox>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="CanvasSizePopup" StaysOpen="False" Placement="Right" PlacementTarget="{Binding ElementName=BtnCanvasSize}" VerticalOffset="0" HorizontalOffset="4">
                    <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Border x:Name="MapSizePanel" Visibility="Collapsed" Background="#F5F5F5" Padding="15,10" Width="220">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="너비:" VerticalAlignment="Center" Foreground="#555"/>
                                    <TextBox Grid.Column="1" x:Name="txtMapWidth" Padding="2" BorderBrush="#CCC"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="높이:" VerticalAlignment="Center" Foreground="#555"/>
                                    <TextBox Grid.Column="1" x:Name="txtMapHeight" Padding="2" BorderBrush="#CCC"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="적용" Click="ApplyMapSize_Click" Width="60" Margin="0,0,5,0" Padding="3" Background="#DDD" BorderThickness="0"/>
                                    <Button Content="닫기" Click="CloseMapSize_Click" Width="50" Padding="3" Background="Transparent" BorderBrush="#CCC" BorderThickness="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Popup>
            </StackPanel>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                    Background="#F8FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="6,3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding History.UndoCommand}" Width="30" Height="24" Margin="0,0,6,0"
                            Background="Transparent" BorderBrush="#DDDDDD" ToolTip="Undo">
                        <TextBlock Text="↶" FontSize="16" Foreground="#333" HorizontalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="{Binding History.StatusText}" MinWidth="190" FontSize="11" Foreground="#555"
                               VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Command="{Binding History.RedoCommand}" Width="30" Height="24" Margin="6,0,0,0"
                            Background="Transparent" BorderBrush="#DDDDDD" ToolTip="Redo">
                        <TextBlock Text="↷" FontSize="16" Foreground="#333" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0"
                    Background="#FFFFF4D6" BorderBrush="#E0B84E" BorderThickness="1" CornerRadius="4" Padding="12,7"
                    Visibility="{Binding SheetManager.ActiveSheet.IsRuntimeUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" MaxWidth="560">
                    <TextBlock Text="Offline snapshot" FontWeight="Bold" Foreground="#7A5300" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding SheetManager.ActiveSheet.RuntimeStatusMessage}" Foreground="#6A5A2A" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Grid.Row="0" Width="300"
                HorizontalAlignment="Right" Panel.ZIndex="100" Background="White"
                BorderBrush="#ccc" BorderThickness="1,0,0,0"
                Visibility="{Binding Inspector.IsDetailPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border"/>
            </Border.Style>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Background="#FFF1F0" BorderBrush="#D32F2F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding Inspector.IsSelectedCreationFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Creation failed" FontWeight="Bold" Foreground="#B71C1C"/>
                            <TextBlock Text="{Binding Inspector.SelectedFailedCreationNode.LastCreationError}" FontSize="11" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,3,0,8" MaxHeight="52"/>
                            <Button Content="Retry"
                                    Command="{Binding Inspector.SelectedFailedCreationNode.RetryFailedCreationCommand}"
                                    Height="34" Margin="0,0,0,6"
                                    Background="#0D6EFD"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Remove"
                                        Command="{Binding Inspector.SelectedFailedCreationNode.RemoveFailedCreationCommand}"
                                        Height="32"
                                        Background="#6C757D"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                                <Button Grid.Column="2" Content="View Error"
                                        Command="{Binding Inspector.SelectedFailedCreationNode.ViewCreationErrorCommand}"
                                        Height="32"
                                        Background="#B71C1C"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF1F0" BorderBrush="#D32F2F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding Inspector.IsSelectedRuntimeDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Docker connection lost" FontWeight="Bold" Foreground="#B71C1C"/>
                            <TextBlock Text="Reconnect or delete this diagram item." FontSize="11" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFF4D6" BorderBrush="#E0B84E" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding Inspector.IsSelectedOfflineSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Offline snapshot" FontWeight="Bold" Foreground="#7A5300"/>
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="Saved layout and metadata are visible. Live runtime controls are disabled until the runtime is available again."
                                           FontSize="11" Foreground="#6A5A2A" TextWrapping="Wrap"/>
                                <Button Content="View snapshot details"
                                        Command="{Binding Inspector.SelectedOfflineSnapshotDetailCommand}"
                                        Margin="0,8,0,0" Padding="8,5" HorizontalAlignment="Left"
                                        Background="#E0B84E" Foreground="#3D2B00" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <ContentControl Content="{Binding Inspector.SelectedElement}" Grid.Row="1" IsEnabled="{Binding Inspector.IsSelectedDockerConnected}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="Connection Info" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="From:" Foreground="Gray"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="📦 "/>
                                            <TextBlock Text="{Binding Source.Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="To:" Foreground="Gray"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="👉 "/>
                                            <TextBlock Text="{Binding Target.Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="방향" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Button Content="⇄  연결 방향 뒤집기" Height="32" Margin="0,0,0,6" Padding="8,5"
                                                ToolTip="Source와 Target 바꾸기"
                                                Command="{Binding DataContext.Inspector.ReverseConnectorDirectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="단방향" Padding="8,5"
                                                    Command="{Binding DataContext.Inspector.SetConnectorDirectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="OneWay">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#F2F4F7"/>
                                                        <Setter Property="Foreground" Value="#333333"/>
                                                        <Setter Property="BorderBrush" Value="#C9CED6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBidirectional}" Value="False">
                                                                <Setter Property="Background" Value="#DCEEFF"/>
                                                                <Setter Property="Foreground" Value="#0067A3"/>
                                                                <Setter Property="BorderBrush" Value="#1684C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Grid.Column="2" Content="양방향" Padding="8,5"
                                                    Command="{Binding DataContext.Inspector.SetConnectorDirectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="Bidirectional">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#F2F4F7"/>
                                                        <Setter Property="Foreground" Value="#333333"/>
                                                        <Setter Property="BorderBrush" Value="#C9CED6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBidirectional}" Value="True">
                                                                <Setter Property="Background" Value="#DCEEFF"/>
                                                                <Setter Property="Foreground" Value="#0067A3"/>
                                                                <Setter Property="BorderBrush" Value="#1684C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="전송 데이터" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Margin="0,0,0,4" Foreground="#666666" FontSize="11">
                                            <Run Text="{Binding Source.Name}"/>
                                            <Run Text=" → "/>
                                            <Run Text="{Binding Target.Name}"/>
                                        </TextBlock>
                                        <TextBox Text="{Binding SourceDataLabel, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="80"
                                                 Padding="6,4"
                                                 ToolTip="출발점에서 도착점으로 보내는 데이터"/>

                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsBidirectional, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Margin="0,0,0,4" Foreground="#666666" FontSize="11">
                                                <Run Text="{Binding Target.Name}"/>
                                                <Run Text=" → "/>
                                                <Run Text="{Binding Source.Name}"/>
                                            </TextBlock>
                                            <TextBox Text="{Binding TargetDataLabel, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="80"
                                                     Padding="6,4"
                                                     ToolTip="도착점에서 출발점으로 보내는 데이터"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelationType}" Value="Dependency">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="Type: Execution Dependency" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,5"/>
                                            <Border Background="#E3F2FD" Padding="8" CornerRadius="3">
                                                <WrapPanel>
                                                    <TextBlock FontWeight="Bold" Text="{Binding Source.Name}" Foreground="#0D47A1" FontSize="11"/>
                                                    <TextBlock Text=" will start after " Foreground="#0D47A1" FontSize="11"/>
                                                    <TextBlock FontWeight="Bold" Text="{Binding Target.Name}" Foreground="#0D47A1" FontSize="11"/>
                                                    <TextBlock Text=" is running." Foreground="#0D47A1" FontSize="11"/>
                                                </WrapPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelationType}" Value="VolumeMount">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="Type: Volume Mount" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,10"/>

                                            <TextBlock Text="Mount Path (Inside Container) *" Foreground="#555" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding MountPath, UpdateSourceTrigger=PropertyChanged}" 
                                                     Padding="5" BorderBrush="#CCC" 
                                                     ToolTip="Example: /var/lib/mysql"/>
                                            <TextBlock Text="Enter the path where data will be stored inside the container." 
                                                     FontSize="10" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelationType}" Value="NetworkAttach">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="Type: Network Attach" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,0,0,10"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelationType}" Value="KubernetesOwner">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="Type: Kubernetes Owner" FontWeight="Bold" Foreground="#326CE5" Margin="0,0,0,5"/>
                                            <Border Background="#E8F0FE" Padding="8" CornerRadius="3">
                                                <WrapPanel>
                                                    <TextBlock FontWeight="Bold" Text="{Binding Source.Name}" Foreground="#174EA6" FontSize="11"/>
                                                    <TextBlock Text=" owns " Foreground="#174EA6" FontSize="11"/>
                                                    <TextBlock FontWeight="Bold" Text="{Binding Target.Name}" Foreground="#174EA6" FontSize="11"/>
                                                    <TextBlock Text="." Foreground="#174EA6" FontSize="11"/>
                                                </WrapPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelationType}" Value="KubernetesSelector">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="Type: Kubernetes Selector" FontWeight="Bold" Foreground="#0B8043" Margin="0,10,0,5"/>
                                            <Border Background="#E6F4EA" Padding="8" CornerRadius="3">
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <TextBlock FontWeight="Bold" Text="{Binding Source.Name}" Foreground="#0B4F2A" FontSize="11"/>
                                                        <TextBlock Text=" selects " Foreground="#0B4F2A" FontSize="11"/>
                                                        <TextBlock FontWeight="Bold" Text="{Binding Target.Name}" Foreground="#0B4F2A" FontSize="11"/>
                                                        <TextBlock Text="." Foreground="#0B4F2A" FontSize="11"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" FontSize="10" Foreground="#0B4F2A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelationType}" Value="KubernetesVolumeClaim">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="Type: Kubernetes PVC Mount" FontWeight="Bold" Foreground="#E65100" Margin="0,10,0,5"/>
                                            <Border Background="#FFF3E0" Padding="8" CornerRadius="3">
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <TextBlock FontWeight="Bold" Text="{Binding Source.Name}" Foreground="#8A3A00" FontSize="11"/>
                                                        <TextBlock Text=" uses " Foreground="#8A3A00" FontSize="11"/>
                                                        <TextBlock FontWeight="Bold" Text="{Binding Target.Name}" Foreground="#8A3A00" FontSize="11"/>
                                                        <TextBlock Text="." Foreground="#8A3A00" FontSize="11"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding MountPath}" FontFamily="Consolas" FontSize="10" Foreground="#8A3A00" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>

                            </Grid>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:GroupViewModel}">
                            <Grid Margin="5">
                                <!-- General diagram groups retain their existing layout controls. -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Network">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Group Name (Max 10):" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                             Padding="5" FontSize="14" FontWeight="Bold"
                                             BorderBrush="#CCC" BorderThickness="1" Background="White"
                                             Margin="0,0,0,15"/>

                                    <TextBlock Text="Contained Nodes:" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                                    <Border Height="170" BorderBrush="#DDD" BorderThickness="1" Background="#F9F9F9" Margin="0,0,0,15">
                                        <ListBox ItemsSource="{Binding ContainedNodes}" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="Gray"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DetailStatus}" Value="running">
                                                                            <Setter Property="Fill" Value="#28a745"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DetailStatus}" Value="exited">
                                                                            <Setter Property="Fill" Value="#dc3545"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <TextBlock Text="Batch Actions:" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                                    <UniformGrid Rows="1" Columns="2" Margin="0,0,0,5">
                                        <Button Command="{Binding StartAllCommand}" Margin="0,0,2,0" Height="30"
                                                Background="White" BorderBrush="#28a745" BorderThickness="1" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶" Foreground="#28a745" Margin="0,0,5,0"/>
                                                <TextBlock Text="Start All"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding StopAllCommand}" Margin="2,0,0,0" Height="30"
                                                Background="White" BorderBrush="#dc3545" BorderThickness="1" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="■" Foreground="#dc3545" Margin="0,0,5,0"/>
                                                <TextBlock Text="Stop All"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <Button Command="{Binding ArrangeCommand}" Height="30" Background="#F0F0F0"
                                            BorderBrush="#CCC" BorderThickness="1" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▦" Margin="0,0,5,0"/>
                                            <TextBlock Text="Arrange in Grid"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Docker networks use engine-backed inspect data, not visual group containment. -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Network">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>

                                    <StackPanel Margin="0,0,3,0">
                                        <TextBlock Text="Network Name" FontWeight="Bold" FontSize="12" Foreground="#555"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="17" Foreground="#222"
                                                   Margin="0,5,0,15" TextWrapping="Wrap"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Network Details" FontWeight="Bold" FontSize="13" Foreground="#555"/>
                                            <TextBlock Text="Loading..." Foreground="#777" FontSize="11" HorizontalAlignment="Right"
                                                       Visibility="{Binding IsNetworkDetailsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </DockPanel>

                                        <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                                                Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Driver" Foreground="#888"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Driver}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Scope" Foreground="#888"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NetworkScope}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Subnet" Foreground="#888"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NetworkSubnetSummary}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Gateway" Foreground="#888"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NetworkGatewaySummary}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="IPv6" Foreground="#888"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NetworkIPv6Text}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Internal" Foreground="#888"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NetworkInternalText}"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Attachable" Foreground="#888"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NetworkAttachableText}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding NetworkDetailsStatus}" Foreground="#B42318" FontSize="11"
                                                   TextWrapping="Wrap" Margin="2,0,2,8"
                                                   Visibility="{Binding HasNetworkDetailsStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <DockPanel Margin="0,8,0,5">
                                            <TextBlock Text="Connected Containers" FontWeight="Bold" FontSize="12" Foreground="#555"/>
                                            <Border Background="#E9EEF3" CornerRadius="9" Padding="7,1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding NetworkConnectedContainerCount}" FontSize="10" Foreground="#59636F"/>
                                            </Border>
                                        </DockPanel>

                                        <Border Height="190" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <ListBox ItemsSource="{Binding NetworkConnectedContainers}" Background="Transparent" BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="3,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#888"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="running">
                                                                                    <Setter Property="Fill" Value="#28a745"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="exited">
                                                                                    <Setter Property="Fill" Value="#dc3545"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding AddressSummary}" Foreground="#777" FontSize="10" FontFamily="Consolas"
                                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="No connected containers" Foreground="#888" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasNetworkConnectedContainers}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="Built-in Docker networks cannot be deleted." Foreground="#777" FontSize="10"
                                                   Margin="2,8,2,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBuiltInDockerNetwork}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                            <Grid Margin="5">

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="💾 로컬 PC로 백업 (.tar)" Command="{Binding BackupVolumeCommand}"
                                                  Style="{StaticResource VolumeVisibilityMenuItemStyle}"/>

                                        <MenuItem Header="📂 로컬 백업 복원 (.tar)" Command="{Binding RestoreVolumeCommand}"
                                                  Style="{StaticResource VolumeVisibilityMenuItemStyle}"/>

                                        <MenuItem Header="⚙ 옵션 편집 / 재생성" Command="{Binding RecreateVolumeCommand}"
                                                  Style="{StaticResource VolumeVisibilityMenuItemStyle}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBox MaxLength="25" Padding="0,2" FontSize="16" FontWeight="Bold" ToolTip="{Binding Name}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Text" Value="{Binding Name, StringFormat='Name: {0}', UpdateSourceTrigger=PropertyChanged}"/>
                                                <Setter Property="IsReadOnly" Value="True"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#333"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Internet">
                                                        <Setter Property="Text" Value="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Setter Property="IsReadOnly" Value="False"/>
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Background" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0"
                                                Style="{StaticResource ContainerVisibilityStackPanelStyle}">
                                        <TextBlock Text="{Binding ShortContainerId, StringFormat='Id: {0}'}" FontSize="11" Foreground="#555555" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <Button Content="📋" ToolTip="ID 복사" Command="{Binding CopyContainerIdCommand}"
                                                Background="Transparent" BorderThickness="0" Margin="5,0,0,0" Padding="0"
                                                Cursor="Hand" Foreground="#555555"/>
                                    </StackPanel>
                                    <Separator Margin="0,8,0,0" Background="#EEE"/>
                                </StackPanel>

                                <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Background="#FDFDFD" Padding="8" Margin="0,0,0,8"
                                        Style="{StaticResource ContainerVisibilityBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Image:" Foreground="#888" FontSize="11"/>
                                            <TextBlock Text="Status:" Foreground="#888" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ImageName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DetailStatus}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            <ProgressBar Height="4"
                                                         Margin="0,4,0,0"
                                                         Maximum="100"
                                                         Value="{Binding CreationProgressValue}"
                                                         IsIndeterminate="{Binding IsCreationProgressIndeterminate}"
                                                         Foreground="{Binding StatusColor}"
                                                         Background="#E9ECEF"
                                                         BorderThickness="0"
                                                         Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding CreationProgressMessage}"
                                                       FontSize="10"
                                                       Foreground="#666"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="3" Margin="0,0,0,10"
                                            Style="{StaticResource ContainerVisibilityStackPanelStyle}">

                                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,5">
                                        <UniformGrid Rows="1" Columns="4">
                                            <Button Command="{Binding StartCommand}" Background="White" BorderThickness="0,0,1,0" BorderBrush="#EEE" Cursor="Hand" Height="30" ToolTip="Start">
                                                <TextBlock Text="▶" Foreground="#28a745" FontSize="12"/>
                                            </Button>
                                            <Button Command="{Binding StopCommand}" Background="White" BorderThickness="0,0,1,0" BorderBrush="#EEE" Cursor="Hand" Height="30" ToolTip="Stop">
                                                <TextBlock Text="■" Foreground="#dc3545" FontSize="12"/>
                                            </Button>
                                            <Button Command="{Binding PauseCommand}" Background="White" BorderThickness="0,0,1,0" BorderBrush="#EEE" Cursor="Hand" Height="30" ToolTip="Pause">
                                                <TextBlock Text="⏸" Foreground="#ffc107" FontSize="12"/>
                                            </Button>
                                            <Button Command="{Binding RestartCommand}" Background="White" BorderThickness="0" Cursor="Hand" Height="30" ToolTip="Restart">
                                                <TextBlock Text="🔄" Foreground="#17a2b8" FontSize="12"/>
                                            </Button>
                                        </UniformGrid>
                                    </Border>

                                    <Button Command="{Binding TerminalCommand}" Height="32" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Open Terminal">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text=">_" Foreground="#00FF00" Margin="0,0,8,0" FontWeight="Bold" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Terminal" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Border Grid.Row="4" Background="#F9F9F9" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10"
                                        Style="{StaticResource ContainerVisibilityBorderStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📍 IP Address:" Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding IPAddress, FallbackValue='172.17.0.x'}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="#333" FontFamily="Consolas"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔌 Ports:" Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PortSummary}" ToolTip="{Binding PortInfo}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#007ACC"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔁 Restart:" Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RestartPolicy, FallbackValue='unless-stopped'}" 
                               FontSize="11" Foreground="#555"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⏱️ Uptime:" Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CreatedDate, StringFormat='Created at {0}'}"
                               FontSize="11" Foreground="#555"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🩺 Health:" Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HealthStatus, FallbackValue='No Check'}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{Binding HealthColor, FallbackValue='#888'}"/>
                                        </Grid>

                                        <Separator Background="#E5E5E5" Margin="0,4,0,10"/>

                                        <UniformGrid Columns="2">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="💾 Vol:" Foreground="#888" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding MountCount, FallbackValue='0'}" FontSize="11" FontWeight="Bold" Foreground="#333"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="⚙️ Env:" Foreground="#888" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding EnvironmentVariables.Count, FallbackValue='0'}" FontSize="11" FontWeight="Bold" Foreground="#333"/>
                                            </StackPanel>
                                        </UniformGrid>

                                        <Separator Background="#E5E5E5" Margin="0,10,0,6"/>

                                        <Border Background="#F8FAFC" BorderBrush="#E1E5EA" BorderThickness="1"
                                                CornerRadius="4" Padding="9,3">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Net" FontSize="11" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Network.NetworkSummary}"
                                                                   ToolTip="{Binding Network.NetworkDetails}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#333"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="IPv4" FontSize="11" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Network.IPv4Summary}"
                                                                   ToolTip="{Binding Network.IPv4Details}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#333"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Row="2" Padding="0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="IPv6" FontSize="11" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Network.IPv6Summary}"
                                                                   ToolTip="{Binding Network.IPv6Details}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#333"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="5" Margin="0,0,0,5">
                                    <Button Command="{Binding OpenDetailWindowCommand}" Height="36" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            Style="{StaticResource ContainerVisibilityButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="View Details &amp; Logs" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Content="📝 Extract Dockerfile"
                                            Command="{Binding ExtractDockerfileCommand}"
                                            Background="#6c757d" Foreground="White"
                                            Margin="0,10,0,0" Padding="10,8" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Style="{StaticResource ContainerVisibilityButtonStyle}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                </StackPanel>

                                <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Volume">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Internet">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <StackPanel Margin="0,0,0,10">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Volume">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Volume Summary" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#555"/>
                                            <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Driver" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Driver}" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,5" Visibility="Collapsed">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Created" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CreatedDate}"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,5" Visibility="Collapsed">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Mountpoint" Foreground="#888" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Mountpoint}" TextWrapping="Wrap" FontSize="11"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Size" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Volume.DisplaySizeText}"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Used By" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Volume.UsedContainerCountText}"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="External" Foreground="#888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Volume.ExternalText}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Labels" FontWeight="Bold" FontSize="12" Margin="0,15,0,5" Foreground="#555" Visibility="Collapsed"/>
                                            <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="8" MinHeight="52" Visibility="Collapsed">
                                                <TextBlock Text="{Binding VolumeLabelsText}" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
                                            </Border>
                                            <TextBlock Text="Driver Options" FontWeight="Bold" FontSize="12" Margin="0,15,0,5" Foreground="#555" Visibility="Collapsed"/>
                                            <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="8" MinHeight="52" Visibility="Collapsed">
                                                <TextBlock Text="{Binding VolumeDriverOptionsText}" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
                                            </Border>
                                            <TextBlock Text="Used By Containers" FontWeight="Bold" FontSize="12" Margin="0,15,0,5" Foreground="#555"/>
                                            <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="8" MinHeight="42">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Volume.SidebarUsageDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" Margin="3,2" Foreground="#007ACC" TextWrapping="Wrap"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="None" FontSize="11" Margin="3,2" Foreground="#888">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Volume.HasVolumeUsage}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Volume.SidebarUsageOverflowText}" FontSize="11" Margin="3,4,3,2" Foreground="#666" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Volume.HasSidebarUsageOverflow}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <Button Content="View Full Details"
                                                    Command="{Binding OpenVolumeDetailWindowCommand}"
                                                    Height="34" Margin="0,10,0,0"
                                                    Background="#E65100" Foreground="White"
                                                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Internet">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="External Network" FontWeight="Bold" FontSize="12" Foreground="#555" Margin="0,0,0,5"/>
                                            <TextBlock Text="Represents an external connection or the public internet." TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,0,0,15"/>
                                            <TextBlock Text="Connected Nodes" FontWeight="Bold" FontSize="12" Foreground="#555" Margin="0,0,0,5"/>
                                            <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Height="160">
                                                <ListBox ItemsSource="{Binding ConnectedNodes}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="11" Margin="3" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>

                    </ContentControl.Resources>
                </ContentControl>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <Button Content="Reconnect" Height="36" Margin="0,0,0,8"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" HorizontalAlignment="Stretch"
                            Command="{Binding Inspector.ReconnectCommand}"
                            Visibility="{Binding Inspector.IsSelectedDockerDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Delete" Height="34" Background="#dc3545" Foreground="White" BorderThickness="0"
                                IsEnabled="{Binding Inspector.CanDeleteSelected}"
                                Command="{Binding Inspector.DeleteCommand}"/>
                        <Button Grid.Column="2" Content="Close" Height="34"
                                Command="{Binding Inspector.ClosePanelCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#E6E6E6" BorderBrush="#ccc" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F0FDFC" BorderBrush="#CFE8E6" BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Horizontal" Margin="5,0">
                        <Button x:Name="BtnScrollLeft" Click="ScrollLeft_Click" ToolTip="Scroll Left" Style="{StaticResource NavButtonStyle}">
                            <Path Data="{StaticResource PrevIcon}" Fill="#555" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnScrollRight" Click="ScrollRight_Click" ToolTip="Scroll Right" Style="{StaticResource NavButtonStyle}">
                            <Path Data="{StaticResource NextIcon}" Fill="#555" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Click="AddContextButton_Click" ToolTip="New session or add sheet" Style="{StaticResource NavButtonStyle}">
                            <Path Data="{StaticResource PlusIcon}" Fill="#555" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Click="SheetMenuButton_Click" ToolTip="Sheet List" Style="{StaticResource NavButtonStyle}">
                            <Path Data="{StaticResource MenuIcon}" Fill="#555" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Click="ConnectionManagerButton_Click" ToolTip="Connection Manager" Style="{StaticResource NavButtonStyle}">
                            <Path Data="{StaticResource GlobeIcon}" Fill="#555" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Popup x:Name="SheetMenuPopup" StaysOpen="False" Placement="Top">
                            <Border Background="White" BorderBrush="#999" BorderThickness="1" MaxHeight="300" MinWidth="150">
                                <ListBox ItemsSource="{Binding SheetManager.Sheets}" SelectedItem="{Binding SheetManager.ActiveSheet}" 
                                     BorderThickness="0" DisplayMemberPath="Title" 
                                     SelectionChanged="SheetMenuList_SelectionChanged"
                                     MaxHeight="300"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0" 
                              ScrollChanged="TabScrollViewer_ScrollChanged"
                              SizeChanged="TabScrollViewer_SizeChanged">
                    <Grid>
                        <ListBox x:Name="WorkspaceListBox"
                         ItemsSource="{Binding SheetManager.Workspaces}"
                         SelectedItem="{Binding SheetManager.ActiveWorkspace, Mode=TwoWay}"
                         Visibility="{Binding SheetManager.IsWorkspaceLayer, Converter={StaticResource BooleanToVisibilityConverter}}"
                         PreviewMouseLeftButtonUp="WorkspaceListBox_MouseLeftButtonUp"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="WorkspaceTabBorder" Background="Transparent" BorderBrush="#ccc" BorderThickness="0,0,1,0" Padding="15,5" MinWidth="120" Cursor="Hand">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="이름 바꾸기" Click="RenameWorkspace_Click"/>
                                                            <MenuItem Header="삭제" Click="DeleteWorkspace_Click" Foreground="#dc3545"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Bold" Foreground="#777" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="#E7EEF4" CornerRadius="7" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding RuntimeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#59636F"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="WorkspaceTabBorder" Property="Background" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="WorkspaceTabBorder" Property="Background" Value="#F2F2F2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>

                        <StackPanel x:Name="SheetLayerPanel" Orientation="Horizontal" Visibility="{Binding SheetManager.IsSheetLayer, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Click="WorkspaceCrumb_Click" Background="White" BorderBrush="#ccc" BorderThickness="0,0,1,0" Padding="15,5" MinWidth="120" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SheetManager.ActiveWorkspace.KindLabel}" FontSize="10" FontWeight="Bold" Foreground="#777" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding SheetManager.ActiveWorkspace.DisplayName}" FontWeight="SemiBold" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                    <Border Background="#E7EEF4" CornerRadius="7" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding SheetManager.ActiveWorkspace.RuntimeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#59636F"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <ListBox x:Name="SheetListBox" ItemsSource="{Binding SheetManager.Sheets}" SelectedItem="{Binding SheetManager.ActiveSheet}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseLeftButtonDown="SheetTab_PreviewMouseLeftButtonDown"
                             Drop="SheetTab_Drop" AllowDrop="True"
                             SelectionChanged="SheetListBox_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="AllowDrop" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="#ccc" BorderThickness="0,0,1,0" Padding="15,5" MinWidth="100" Cursor="Hand">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="이름 바꾸기" Click="RenameSheet_Click"/>

                                                        <MenuItem Header="시트 비우기" Click="ClearSheet_Click">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="🧹" HorizontalAlignment="Center"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="삭제" Click="DeleteSheet_Click" Foreground="#dc3545"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                                    <Setter TargetName="TabBorder" Property="TextBlock.FontWeight" Value="Bold"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#F2F2F2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid x:Name="RenameOverlay" Visibility="Collapsed" Background="#80000000" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="200">
            <Border Background="White" Width="300" Height="150" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="20">
                    <TextBlock x:Name="txtRenameTitle" Text="Rename Sheet" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                    <TextBox x:Name="txtRename" Padding="5" Margin="0,0,0,15"/>
                    <UniformGrid Rows="1" Columns="2">
                        <Button Content="OK" Background="#007ACC" Foreground="White" Padding="5" Margin="0,0,5,0" Click="RenameOK_Click"/>
                        <Button Content="Cancel" Background="#DDDDDD" Padding="5" Margin="5,0,0,0" Click="RenameCancel_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
