        <Geometry x:Key="ArrowUp">M 0,10 L 10,0 L 20,10</Geometry>
        <Geometry x:Key="ArrowDown">M 0,0 L 10,10 L 20,0</Geometry>
        <Geometry x:Key="ArrowLeft">M 10,0 L 0,10 L 10,20</Geometry>
        <Geometry x:Key="ArrowRight">M 0,0 L 10,10 L 0,20</Geometry>
        <Geometry x:Key="PrevIcon">M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z</Geometry>
        <Geometry x:Key="NextIcon">M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z</Geometry>
        <Geometry x:Key="PlusIcon">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</Geometry>
        <Geometry x:Key="MenuIcon">M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z</Geometry>
        <Geometry x:Key="GlobalOptionsIcon">M3 17v2h6v-2H3z M3 5v2h10V5H3z M13 21v-2h8v-2h-8v-2h-2v6h2z M7 9v2H3v2h4v2h2V9H7z M21 13v-2H11v2h10z M15 9h2V7h4V5h-4V3h-2v6z</Geometry>
        <Geometry x:Key="InspectIcon">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5z M12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5s5 2.24 5 5s-2.24 5-5 5z M12 9c1.66 0 3 1.34 3 3s-1.34 3-3 3s-3-1.34-3-3s1.34-3 3-3z</Geometry>
        <Geometry x:Key="ContainerIcon">M3,5H21V19H3V5M3,3A2,2 0 0,0 1,5V19A2,2 0 0,0 3,21H21A2,2 0 0,0 23,19V5A2,2 0 0,0 21,3H3Z</Geometry>
        <Geometry x:Key="DatabaseIcon">M12,3C17.5,3 22,4.34 22,6V18C22,19.66 17.5,21 12,21C6.5,21 2,19.66 2,18V6C2,4.34 6.5,3 12,3M12,19C16.5,19 20,18.1 20,17V15.64C18.2,16.5 15.3,17 12,17C8.7,17 5.8,16.5 4,15.64V17C4,18.1 7.5,19 12,19M12,15C16.5,15 20,14.1 20,13V11.64C18.2,12.5 15.3,13 12,13C8.7,13 5.8,12.5 4,11.64V13C4,14.1 7.5,15 12,15M12,11C16.5,11 20,10.1 20,9V7.64C18.2,8.5 15.3,9 12,9C8.7,9 5.8,8.5 4,7.64V9C4,10.1 7.5,11 12,11M12,5C7.5,5 4,5.9 4,6C4,6.1 7.5,7 12,7C16.5,7 20,6.1 20,6C20,5.9 16.5,5 12,5Z</Geometry>
        <Geometry x:Key="CloudIcon">M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04Z</Geometry>
