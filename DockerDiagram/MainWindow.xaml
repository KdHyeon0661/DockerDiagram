    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="#F4F6F8" BorderBrush="#D5D9DE" BorderThickness="0,0,1,0" Padding="10" Panel.ZIndex="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          BorderThickness="0">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                <StackPanel>
                    <TextBlock Text="Create" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,10" Foreground="#343A43"/>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Container" 
                    PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource ContainerIcon}" Fill="#007ACC" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Container" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Volume" 
                    PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource DatabaseIcon}" Fill="#E67E22" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Volume" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Internet" 
                            PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource GlobeIcon}" Fill="#3498DB" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Internet" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Network" 
                    PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="{StaticResource CloudIcon}" Fill="#9B59B6" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Network" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Height="40" Margin="0,0,0,5" Cursor="Hand" Tag="Group" 
                            PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown" PreviewMouseMove="Tool_PreviewMouseMove" PreviewMouseLeftButtonUp="Tool_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                  Fill="#F1C40F" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="New Group" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Expander IsExpanded="False" Style="{StaticResource SidebarExpanderStyle}" Margin="0,8,0,0">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource ContainerIcon}" Fill="#3F6F95" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Stack Templates" FontWeight="SemiBold" Foreground="#3D4651" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#DDE4EB" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Explorer.StackTemplates.Count}" FontSize="10" Foreground="#59636F"/>
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <ListBox ItemsSource="{Binding Explorer.StackTemplates}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ResourceListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            Cursor="Hand"
                                            Padding="3,4"
                                            PreviewMouseLeftButtonDown="StackTemplate_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="StackTemplate_PreviewMouseLeftButtonUp"
                                            MouseMove="StackTemplate_MouseMove">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding AccentColor}" CornerRadius="2" Margin="0,1,0,1"/>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#303842" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ResourceSummary}" FontSize="10" Foreground="#7B8591" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </StackPanel>

                <Separator Margin="0,14,0,12" Background="#D5D9DE"/>

                <StackPanel>
                        <Grid Margin="2,0,2,6">
                            <TextBlock Text="{Binding Explorer.ResourceHeader}" FontWeight="SemiBold" FontSize="13" Foreground="#343A43"/>
                            <TextBlock Text="{Binding Explorer.LastSyncTime}" FontSize="10" Foreground="#8A929D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
