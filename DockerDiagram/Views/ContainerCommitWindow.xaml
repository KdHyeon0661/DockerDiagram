<Window x:Class="DockerDiagram.Views.ContainerCommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="컨테이너를 이미지로 저장"
        Width="480"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="컨테이너를 이미지로 저장" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock x:Name="ContainerText" Style="{StaticResource DialogHintStyle}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="저장소" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}"/>
            <TextBox x:Name="RepositoryBox" Grid.Column="1" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>

            <TextBlock Grid.Row="1" Text="태그" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}" Margin="0,10,0,0"/>
            <TextBox x:Name="ImageTagBox" Grid.Row="1" Grid.Column="1" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="2" Text="메시지" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}" Margin="0,10,0,0"/>
            <TextBox x:Name="CommitMessageBox" Grid.Row="2" Grid.Column="1" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="3" Text="작성자" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}" Margin="0,10,0,0"/>
            <TextBox x:Name="AuthorBox" Grid.Row="3" Grid.Column="1" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}" Margin="0,10,0,0"/>

            <CheckBox x:Name="PauseBox" Grid.Row="4" Grid.Column="1" Content="저장하는 동안 컨테이너 일시정지" IsChecked="True" Margin="0,12,0,0"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="저장" Click="CommitButton_Click" Width="88" Margin="0,0,8,0" Style="{StaticResource DialogPrimaryButtonStyle}"/>
            <Button Content="취소" Click="CancelButton_Click" Width="82" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
