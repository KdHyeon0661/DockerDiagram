<Window x:Class="DockerDiagram.Views.VolumeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, StringFormat='Volume Details : {0}'}"
        Width="720" Height="560" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
            <TextBlock Text="{Binding EffectiveVolumeName}" FontSize="22" FontWeight="Bold" Foreground="#333"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveVolumeName}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <StackPanel>
                <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
                <Border Background="White" BorderBrush="#DADDE2" BorderThickness="1" CornerRadius="5" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Driver" Foreground="#777" Margin="0,0,10,8"/>
                        <TextBlock Grid.Column="1" Text="{Binding Driver}" FontWeight="SemiBold" Margin="0,0,12,8"/>
                        <TextBlock Grid.Column="2" Text="Created" Foreground="#777" Margin="0,0,10,8"/>
                        <TextBlock Grid.Column="3" Text="{Binding CreatedDate}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="Size" Foreground="#777" Margin="0,0,10,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Volume.DisplaySizeText}" Margin="0,0,12,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="External" Foreground="#777" Margin="0,0,10,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Volume.ExternalText}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Used By" Foreground="#777" Margin="0,0,10,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Volume.UsedContainerCountText}" Margin="0,0,12,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Ref Count" Foreground="#777" Margin="0,0,10,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding VolumeRefCount}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Text="Mountpoint" Foreground="#777" Margin="0,0,10,8" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Mountpoint}" IsReadOnly="True"
                                 Background="#F8F9FA" BorderBrush="#E2E5E9" Padding="7,5"
                                 FontFamily="Consolas" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Labels" FontSize="14" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#DADDE2" BorderThickness="1" CornerRadius="5" Padding="10">
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding VolumeLabelsText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Driver Options" FontSize="14" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8"/>
                        <Border Background="White" BorderBrush="#DADDE2" BorderThickness="1" CornerRadius="5" Padding="10">
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding VolumeDriverOptionsText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Used By Containers" FontSize="14" FontWeight="SemiBold" Foreground="#444" Margin="0,18,0,8"/>
                <Border Background="White" BorderBrush="#DADDE2" BorderThickness="1" CornerRadius="5" Padding="8">
                    <StackPanel>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VolumeUsageDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12" Margin="3,2" Foreground="#007ACC" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="None" FontSize="12" Margin="3,2" Foreground="#888">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Volume.HasVolumeUsage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Close" Width="100" Height="34" HorizontalAlignment="Right" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
