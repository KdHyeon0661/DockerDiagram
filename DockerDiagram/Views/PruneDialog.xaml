<Window x:Class="DockerDiagram.Views.PruneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Docker 리소스 정리"
        Width="760"
        Height="720"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ResourceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="MinHeight" Value="88"/>
            </Style>
            <Style x:Key="OptionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DialogSubtleSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogDangerButtonStyle}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="MinWidth" Value="108"/>
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="MinWidth" Value="96"/>
            </Style>
            <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="26,22,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource DialogErrorSurfaceBrush}" Margin="0,0,14,0">
                        <Path Data="{StaticResource DialogTrashIcon}" Width="22" Height="22" Fill="{StaticResource DialogDangerBrush}"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Docker 리소스 정리" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                        <TextBlock Text="서로 다른 정리 대상을 한 번에 선택할 수 있습니다. 사용 중인 리소스는 보호됩니다."
                                   Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="정리 대상" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                        <TextBlock x:Name="TargetHelpText" Text="체크한 항목을 함께 정리합니다."
                                   Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="전체 선택" Click="SelectAll_Click" Style="{StaticResource CompactButtonStyle}"/>
                        <Border Width="1" Height="14" Background="{StaticResource DialogBorderBrush}" Margin="4,0"/>
                        <Button Content="선택 해제" Click="ClearAll_Click" Style="{StaticResource CompactButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ResourceCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkContainers}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogInfoSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox x:Name="chkContainers" IsChecked="True" Checked="PruneTarget_Changed" Unchecked="PruneTarget_Changed">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="중지된 컨테이너" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                                <TextBlock Text="실행 중이지 않은 컨테이너를 삭제합니다." Margin="0,4,0,0"
                                           FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Grid.Column="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ResourceCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkImages}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogInfoSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox x:Name="chkImages" IsChecked="True" Checked="PruneTarget_Changed" Unchecked="PruneTarget_Changed">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="미사용 이미지" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                                <TextBlock Text="컨테이너가 참조하지 않는 이미지를 정리합니다." Margin="0,4,0,0"
                                           FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Grid.Row="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ResourceCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkVolumesTarget}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogInfoSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox x:Name="chkVolumesTarget" IsChecked="True" Checked="PruneTarget_Changed" Unchecked="PruneTarget_Changed">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="미사용 볼륨" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                                <TextBlock Text="연결된 컨테이너가 없는 Docker 볼륨을 정리합니다." Margin="0,4,0,0"
                                           FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ResourceCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkNetworks}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogInfoSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox x:Name="chkNetworks" IsChecked="True" Checked="PruneTarget_Changed" Unchecked="PruneTarget_Changed">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="미사용 네트워크" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                                <TextBlock Text="컨테이너가 연결되지 않은 사용자 네트워크를 삭제합니다." Margin="0,4,0,0"
                                           FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Grid.Row="4" Grid.ColumnSpan="3">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ResourceCardStyle}">
                                <Setter Property="MinHeight" Value="76"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkBuildCache}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogInfoSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox x:Name="chkBuildCache" IsChecked="True" Checked="PruneTarget_Changed" Unchecked="PruneTarget_Changed">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="빌드 캐시" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                                <TextBlock Text="이미지 빌드에서 더 이상 사용하지 않는 캐시를 정리합니다." Margin="0,4,0,0"
                                           FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,20,0,9">
                    <TextBlock Text="세부 범위" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                    <TextBlock Text="선택한 대상에 해당하는 옵션만 사용할 수 있습니다."
                               Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource DialogMutedTextBrush}"/>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ImageOptionsCard" Style="{StaticResource OptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="이미지 범위" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                            <CheckBox x:Name="chkAllImages" IsChecked="True" Margin="0,9,0,0"
                                      Content="태그가 있는 미사용 이미지도 포함"
                                      Checked="PruneOption_Changed" Unchecked="PruneOption_Changed"/>
                            <TextBlock Text="해제하면 dangling 이미지만 삭제합니다."
                                       Margin="24,3,0,0" FontSize="10.5" Foreground="{StaticResource DialogMutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="VolumeOptionsCard" Grid.Column="2" Style="{StaticResource OptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="볼륨 범위" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <CheckBox x:Name="chkAnonymousVolumes" IsChecked="True" Content="익명 볼륨"
                                          Checked="PruneOption_Changed" Unchecked="PruneOption_Changed"/>
                                <CheckBox x:Name="chkNamedVolumes" IsChecked="True" Content="이름 있는 볼륨" Margin="20,0,0,0"
                                          Checked="PruneOption_Changed" Unchecked="PruneOption_Changed"/>
                            </StackPanel>
                            <TextBlock Text="둘 다 미사용 상태인 볼륨만 삭제합니다."
                                       Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource DialogMutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="5" Margin="0,18,0,0" Background="{StaticResource DialogErrorSurfaceBrush}"
                        BorderBrush="{StaticResource DialogDangerBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="위험 옵션" FontWeight="SemiBold" Foreground="{StaticResource DialogDangerBrush}"/>
                            <TextBlock Text="활성화하면 실행 중인 일반 컨테이너도 중지한 뒤 삭제합니다. Swarm·Kubernetes 관리 대상은 보호됩니다."
                                       Margin="0,3,16,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource DialogErrorTextBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="chkRunningContainers" Grid.Column="1" Content="실행 중 포함" VerticalAlignment="Center"
                                  Checked="PruneOption_Changed" Unchecked="PruneOption_Changed"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource DialogSurfaceBrush}" BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="0,1,0,0" Padding="26,14,26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ScopeTitleText" Text="삭제 예정 범위" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                    <TextBlock x:Name="ScopeSummaryText" Margin="0,4,0,0" FontSize="11"
                               Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="취소" IsCancel="True" Click="BtnCancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="ExecuteButton" Content="정리 실행" IsDefault="True" Click="BtnRun_Click"
                            Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
