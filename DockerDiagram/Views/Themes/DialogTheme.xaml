    <Style x:Key="DialogWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource DialogWindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DialogHeaderPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="18,14"/>
    </Style>

    <Style x:Key="DialogBodyCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="DialogFooterPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
    </Style>

    <Style x:Key="DialogSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DialogHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DialogButtonBaseStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogStrongBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DialogHoverSurfaceBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DialogPressedSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogSolidButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonBaseStyle}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DialogTextBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSolidButtonStyle}">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
    </Style>

    <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonBaseStyle}">
        <Setter Property="MinWidth" Value="88"/>
    </Style>

    <Style x:Key="DialogDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSolidButtonStyle}">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Background" Value="{StaticResource DialogDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBrush}"/>
    </Style>

    <Style x:Key="DialogSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSolidButtonStyle}">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Background" Value="{StaticResource DialogSuccessBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBrush}"/>
    </Style>

    <Style x:Key="DialogWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSolidButtonStyle}">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Background" Value="{StaticResource DialogWarningBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBrush}"/>
    </Style>

    <Style x:Key="DialogSwarmButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSolidButtonStyle}">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Background" Value="{StaticResource DialogSwarmBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogSwarmBrush}"/>
    </Style>

    <Style x:Key="DialogKubernetesButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSolidButtonStyle}">
