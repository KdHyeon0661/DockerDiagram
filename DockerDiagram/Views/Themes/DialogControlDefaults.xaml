<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scoped defaults: this dictionary is merged only by secondary windows. -->
    <Style TargetType="Button" BasedOn="{StaticResource DialogButtonBaseStyle}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}"/>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DialogPasswordBoxStyle}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DialogComboBoxStyle}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DialogCheckBoxStyle}"/>
    <Style TargetType="RadioButton" BasedOn="{StaticResource DialogRadioButtonStyle}"/>
    <Style TargetType="TabControl" BasedOn="{StaticResource DialogTabControlStyle}"/>
    <Style TargetType="TabItem" BasedOn="{StaticResource DialogTabItemStyle}"/>
    <Style TargetType="DataGrid" BasedOn="{StaticResource DialogDataGridStyle}"/>
    <Style TargetType="ListView" BasedOn="{StaticResource DialogListViewStyle}"/>
</ResourceDictionary>
