<Window x:Class="DockerDiagram.Views.ImageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="도커 이미지 관리 &amp; Hub" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <TabControl>

            <TabItem Header="로컬 이미지" FontSize="14" Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Path Data="{StaticResource DialogSearchIcon}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource DialogMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="로컬 검색" VerticalAlignment="Center" Style="{StaticResource DialogSectionTitleStyle}" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding ImageSearchText, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                        <TextBlock Text="내 PC에 다운로드된 Repository 이름 검색" VerticalAlignment="Center"
                                   Style="{StaticResource DialogHintStyle}" Margin="10,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="LocalImagesGrid" Grid.Row="1" ItemsSource="{Binding LocalImages}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              RowHeight="46" HeadersVisibility="Column">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource DialogSubtleSurfaceBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                                        <DataGridTextColumn Header="저장소" Binding="{Binding Repository}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="100" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="이미지 ID" Binding="{Binding Id}" Width="120" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="크기" Binding="{Binding FormattedSize}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="관리" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="태그" Style="{StaticResource DialogCompactButtonStyle}"
                                                    Command="{Binding DataContext.TagImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="3,4"/>
                                <Button Content="Push" Style="{StaticResource DialogPrimaryButtonStyle}"
                                                    Command="{Binding DataContext.PushImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" MinWidth="0" MinHeight="34" Margin="3,4" Padding="9,4"/>
                                <Button Content="저장" Style="{StaticResource DialogSuccessButtonStyle}"
                                                    Command="{Binding DataContext.SaveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" MinWidth="0" MinHeight="34" Margin="3,4" Padding="9,4"/>
                                <Button Content="삭제" Style="{StaticResource DialogDangerButtonStyle}"
                                                    Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" MinWidth="0" MinHeight="34" Margin="3,4" Padding="9,4"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="로컬 이미지가 없습니다." IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DialogEmptyStateTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=LocalImagesGrid, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Docker Hub (Registry)" FontSize="14" Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HubSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="38" Padding="10,6" FontSize="14" ToolTip="검색어 입력 후 Enter 또는 검색 버튼 클릭">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchHubCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                            <Button Grid.Column="1" Command="{Binding SearchHubCommand}" Content="검색"
                                Width="100" MinHeight="38" Margin="10,0,0,0" Style="{StaticResource DialogPrimaryButtonStyle}"/>
                    </Grid>

                    <DataGrid x:Name="HubResultsGrid" Grid.Row="1" ItemsSource="{Binding HubSearchResults}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              RowHeight="50" HeadersVisibility="Column">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource DialogSubtleSurfaceBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                                    <DataGridTextColumn Header="이미지 이름" Binding="{Binding Name}" Width="200" FontWeight="Bold" IsReadOnly="True" Foreground="{StaticResource DialogPrimaryBrush}"/>
                                    <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                                    <DataGridTextColumn Header="별점" Binding="{Binding StarCount}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="작업" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Pull" Style="{StaticResource DialogSuccessButtonStyle}"
                                                Command="{Binding DataContext.PullImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" MinHeight="38" Margin="5" Padding="10,5"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="검색 결과가 없습니다." IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DialogEmptyStateTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=HubResultsGrid, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSearchingHub}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="1" Background="{StaticResource DialogOverlayBrush}" Visibility="{Binding IsSearchingHub, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Docker Hub 검색 중..." FontSize="14" FontWeight="SemiBold"
                                       Style="{StaticResource DialogLoadingTextStyle}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,15,0,0" Padding="15" Style="{StaticResource DialogInfoPanelStyle}"
                            Visibility="{Binding IsPulling, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PullProgressMessage}" FontWeight="SemiBold" Foreground="{StaticResource DialogInfoTextBrush}"
                                       FontFamily="Consolas" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ProgressBar Value="{Binding PullProgressValue}" Maximum="100" Height="18"
                                         Foreground="{StaticResource DialogSuccessBrush}" Background="{StaticResource DialogDisabledSurfaceBrush}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
