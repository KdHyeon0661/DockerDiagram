<Window x:Class="DockerDiagram.Views.ImageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="도커 이미지 관리 &amp; Hub" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <TabControl Background="White" BorderBrush="#DDD" BorderThickness="1">

            <TabItem Header="💻 Local Images" FontSize="14" Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🔍 로컬 검색:" VerticalAlignment="Center" Foreground="#555" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding ImageSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="250" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CCC"/>
                        <TextBlock Text="(내 PC에 다운로드된 Repository 이름 검색)" VerticalAlignment="Center" Foreground="#999" Margin="10,0,0,0" FontSize="11"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LocalImages}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              Background="White" RowHeight="38" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#CCC">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F9FA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#EEE"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Image ID" Binding="{Binding Id}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="관리" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ 삭제" Background="#dc3545" Foreground="White" BorderThickness="0"
                                                Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Margin="5,4" Padding="0" Height="26">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🌐 Docker Hub (Registry)" FontSize="14" Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HubSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="14" BorderBrush="#CCC" ToolTip="검색어 입력 후 Enter 또는 검색 버튼 클릭">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchHubCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Command="{Binding SearchHubCommand}" Content="🔍 Search"
                                Width="100" Margin="10,0,0,0" Background="#17a2b8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding HubSearchResults}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              Background="White" RowHeight="45" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#CCC">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F9FA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#EEE"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Image Name" Binding="{Binding Name}" Width="200" FontWeight="Bold" IsReadOnly="True" Foreground="#007ACC"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="⭐ Stars" Binding="{Binding StarCount}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⬇️ Pull" Background="#28a745" Foreground="White" BorderThickness="0"
                                                Command="{Binding DataContext.PullImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Margin="5,5" Padding="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Background="#99FFFFFF" Visibility="{Binding IsSearchingHub, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳ 도커 허브에서 검색 중입니다..." FontSize="16" FontWeight="Bold" Foreground="#555" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,15,0,0" Padding="15" Background="#F8F9FA" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="5"
                            Visibility="{Binding IsPulling, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PullProgressMessage}" FontWeight="Bold" Foreground="#333" FontFamily="Consolas" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ProgressBar Value="{Binding PullProgressValue}" Maximum="100" Height="20" Foreground="#28a745" Background="#E9ECEF" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>