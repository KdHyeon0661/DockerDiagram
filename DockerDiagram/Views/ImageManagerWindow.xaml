<Window x:Class="DockerDiagram.Views.ImageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="도커 이미지 관리 (Docker Images)" Height="500" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Margin="0,0,0,15">
			<TextBlock Text="🔍 검색:" VerticalAlignment="Center" Foreground="#555" FontWeight="Bold" Margin="0,0,10,0"/>
			<TextBox Text="{Binding ImageSearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CCC"/>
			<TextBlock Text="(Repository 이름으로 검색됩니다)" VerticalAlignment="Center" Foreground="#999" Margin="10,0,0,0" FontSize="11"/>
		</StackPanel>

		<DataGrid Grid.Row="1" ItemsSource="{Binding LocalImages}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  Background="White" RowHeight="38" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#CCC">

			<DataGrid.Resources>
				<Style TargetType="DataGridColumnHeader">
					<Setter Property="Background" Value="#F0F0F0"/>
					<Setter Property="Padding" Value="10,5"/>
					<Setter Property="FontWeight" Value="Bold"/>
					<Setter Property="BorderBrush" Value="#CCC"/>
					<Setter Property="BorderThickness" Value="0,0,1,1"/>
				</Style>

				<Style TargetType="DataGridCell">
					<Setter Property="Padding" Value="10,0"/>
					<Setter Property="VerticalContentAlignment" Value="Center"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="DataGridCell">
								<Border Padding="{TemplateBinding Padding}" Background="Transparent">
									<ContentPresenter VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</DataGrid.Resources>

			<DataGrid.Columns>
				<DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="*" IsReadOnly="True"/>
				<DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="100" IsReadOnly="True"/>
				<DataGridTextColumn Header="Image ID" Binding="{Binding Id}" Width="120" IsReadOnly="True"/>

				<DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100" IsReadOnly="True">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="TextAlignment" Value="Right"/>
							<Setter Property="Margin" Value="0,0,10,0"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>

				<DataGridTemplateColumn Header="관리" Width="100">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="🗑️ 삭제" Background="#dc3545" Foreground="White" BorderThickness="0"
                                    Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Cursor="Hand" Margin="5,4" Padding="0" Height="26">
								<Button.Resources>
									<Style TargetType="Border">
										<Setter Property="CornerRadius" Value="4"/>
									</Style>
								</Button.Resources>
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</Window>