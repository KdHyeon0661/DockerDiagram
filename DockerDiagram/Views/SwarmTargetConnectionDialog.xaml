<Window x:Class="DockerDiagram.Views.SwarmTargetConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm 대상 PC 연결" Width="610" Height="590"
        MinWidth="560" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="다른 PC를 Swarm 노드로 준비" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock Text="SSH 터널을 통해 Docker 응답과 미가입 상태만 확인합니다. 아직 Join은 실행하지 않습니다."
                       Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="16" Style="{StaticResource DialogBodyCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="대상 PC 주소" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            <TextBox x:Name="HostTextBox" Margin="0,4,0,10" MinHeight="38" Padding="7,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
            <TextBlock Text="SSH 포트" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            <TextBox x:Name="SshPortTextBox" Text="22" Margin="0,4,0,10" MinHeight="38" Padding="7,5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="SSH 사용자" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    <TextBox x:Name="UsernameTextBox" Margin="0,4,0,10" MinHeight="38" Padding="7,5"/>

                    <TextBlock Text="SSH 프라이빗 키" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyPathTextBox" MinHeight="38" Padding="7,5"/>
                        <Button Grid.Column="2" Content="찾아보기" Click="BrowseKey_Click"/>
                    </Grid>

                    <TextBlock Text="원격 Docker Socket" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    <TextBox x:Name="RemoteSocketTextBox" Text="/var/run/docker.sock"
                             Margin="0,4,0,10" MinHeight="38" Padding="7,5"/>

                    <TextBlock Text="Swarm 역할" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                        <RadioButton x:Name="WorkerRoleRadio" Content="Worker" GroupName="TargetRole" IsChecked="True" Margin="0,0,20,0"/>
                        <RadioButton x:Name="ManagerRoleRadio" Content="Manager" GroupName="TargetRole"/>
                    </StackPanel>

                    <TextBlock Text="대상 Advertise Address" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    <TextBox x:Name="AdvertiseAddressTextBox" Margin="0,4,0,4" MinHeight="38" Padding="7,5"/>
                    <TextBlock Text="다른 Swarm 노드에서 이 PC에 접근할 수 있는 주소입니다. 보통 대상 PC의 LAN IP를 사용합니다."
                               FontSize="10" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>

                    <Border Margin="0,14,0,0" Padding="10" Style="{StaticResource DialogInfoPanelStyle}" Background="{StaticResource DialogSwarmSurfaceBrush}" BorderBrush="{StaticResource DialogSwarmBorderBrush}">
                        <TextBlock Text="검증된 연결은 이 Swarm 설정 창에서만 유지되며 창을 닫으면 SSH 터널과 Docker 연결을 정리합니다."
                                   FontSize="10.5" Foreground="{StaticResource DialogSwarmTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource DialogMutedTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Width="86" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True"/>
                <Button x:Name="ValidateButton" Content="연결 검증" Width="112" MinHeight="38"
                        Style="{StaticResource DialogSwarmButtonStyle}"
                        Click="ValidateConnection_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
