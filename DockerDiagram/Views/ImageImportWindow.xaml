<Window x:Class="DockerDiagram.Views.ImageImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Tar에서 이미지 가져오기"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Tar에서 이미지 가져오기" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock Text="docker export로 만든 것과 같은 루트 파일 시스템 tar를 사용합니다." Style="{StaticResource DialogHintStyle}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Tar 파일" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}"/>
            <TextBox x:Name="TarPathBox" Grid.Column="1" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>
            <Button Grid.Column="2" Content="찾아보기..." Click="BrowseButton_Click" Width="88" MinHeight="38" Margin="8,0,0,0" Style="{StaticResource DialogSecondaryButtonStyle}"/>

            <TextBlock Grid.Row="1" Text="저장소" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}" Margin="0,10,0,0"/>
            <TextBox x:Name="RepositoryBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="2" Text="태그" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}" Margin="0,10,0,0"/>
            <TextBox x:Name="ImageTagBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="3" Text="메시지" VerticalAlignment="Center" Foreground="{StaticResource DialogTextBrush}" Margin="0,10,0,0"/>
            <TextBox x:Name="ImportMessageBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="38" Padding="6" VerticalContentAlignment="Center" BorderBrush="{StaticResource DialogStrongBorderBrush}" Margin="0,10,0,0"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="가져오기" Click="ImportButton_Click" Width="88" Margin="0,0,8,0" Style="{StaticResource DialogPrimaryButtonStyle}"/>
            <Button Content="취소" Click="CancelButton_Click" Width="82" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
