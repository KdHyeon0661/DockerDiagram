<Window x:Class="DockerDiagram.Views.RawInspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="원본 Inspect JSON"
        Width="900"
        Height="650"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeaderPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
            <TextBlock Text="docker inspect 원본 응답" FontSize="12" Foreground="{StaticResource DialogMutedTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="복사" Click="CopyButton_Click" Width="72" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}"/>
                <Button Content="저장..." Click="SaveButton_Click" Width="76" MinHeight="38" Style="{StaticResource DialogSecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14" Style="{StaticResource DialogBodyCardStyle}" Padding="0">
            <TextBox x:Name="JsonTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="12"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Style="{StaticResource DialogCodeTextBoxStyle}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="닫기" Click="CloseButton_Click" Width="82" MinHeight="38" Style="{StaticResource DialogSecondaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
