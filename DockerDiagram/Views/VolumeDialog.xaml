<Window x:Class="DockerDiagram.Views.VolumeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Volume"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Volume Name:" FontWeight="Bold" Margin="0,0,0,5"/>
		<TextBox Grid.Row="1" x:Name="txtName" Padding="5" Margin="0,0,0,15"/>

		<TextBlock Grid.Row="2" Text="Driver (Default: local):" FontWeight="Bold" Margin="0,0,0,5"/>
		<TextBox Grid.Row="3" x:Name="txtDriver" Padding="5" Margin="0,0,0,15" Text="local"/>

		<Expander Grid.Row="4" Header="Advanced" Margin="0,0,0,10">
			<Grid Margin="0,10,0,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<CheckBox Grid.Row="0" x:Name="chkExternal" Content="External volume (use existing Docker volume)" Margin="0,0,0,10"/>

				<TextBlock Grid.Row="1" Text="Docker Volume Name:" FontWeight="Bold" Margin="0,0,0,5"/>
				<TextBox Grid.Row="2" x:Name="txtDockerVolumeName" Padding="5" Margin="0,0,0,12"/>

				<TextBlock Grid.Row="3" Text="Labels (key=value, one per line):" FontWeight="Bold" Margin="0,0,0,5"/>
				<TextBox Grid.Row="4" x:Name="txtLabels" Padding="5" Margin="0,0,0,12" MinHeight="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

				<TextBlock Grid.Row="5" Text="Driver Options (key=value, one per line):" FontWeight="Bold" Margin="0,0,0,5"/>
				<TextBox Grid.Row="6" x:Name="txtDriverOptions" Padding="5" MinHeight="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
			</Grid>
		</Expander>

		<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button x:Name="btnOk" Content="Create" IsDefault="True" Click="BtnOk_Click" Width="80" Height="30" Margin="0,0,10,0" Background="#E67E22" Foreground="White"/>
			<Button Content="Cancel" IsCancel="True" Width="80" Height="30"/>
		</StackPanel>
	</Grid>
</Window>
