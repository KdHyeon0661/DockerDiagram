<Window x:Class="DockerDiagram.Views.VolumeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="볼륨 생성"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border x:Name="SwarmDefinitionNotice" Grid.Row="0" Visibility="Collapsed"
				Style="{StaticResource DialogWarningPanelStyle}" BorderBrush="{StaticResource DialogVolumeBrush}" Margin="0,0,0,14">
			<TextBlock Text="Swarm 서비스용 볼륨 정의를 만듭니다. local 볼륨은 Task가 실행되는 각 노드에서 생성됩니다."
					   Foreground="{StaticResource DialogWarningTextBrush}" TextWrapping="Wrap"/>
		</Border>

        <TextBlock Grid.Row="1" Text="볼륨 이름:" FontWeight="Bold" Margin="0,0,0,5"/>
		<TextBox Grid.Row="2" x:Name="txtName" Padding="5" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Text="드라이버 (기본값: local):" FontWeight="Bold" Margin="0,0,0,5"/>
		<TextBox Grid.Row="4" x:Name="txtDriver" Padding="5" Margin="0,0,0,15" Text="local"/>

        <Expander Grid.Row="5" Header="고급 설정" Background="{StaticResource DialogSurfaceBrush}" Foreground="{StaticResource DialogVolumeBrush}" FontWeight="SemiBold" Margin="0,0,0,10">
			<Grid Margin="0,10,0,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

                <CheckBox Grid.Row="0" x:Name="chkExternal" Content="외부 볼륨 (기존 Docker 볼륨 사용)" Margin="0,0,0,10"/>

                <TextBlock x:Name="DockerVolumeNameLabel" Grid.Row="1" Text="Docker 볼륨 이름:" FontWeight="Bold" Margin="0,0,0,5"/>
				<TextBox Grid.Row="2" x:Name="txtDockerVolumeName" Padding="5" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3" Text="레이블 (key=value, 한 줄에 하나):" FontWeight="Bold" Margin="0,0,0,5"/>
				<TextBox Grid.Row="4" x:Name="txtLabels" Padding="5" Margin="0,0,0,12" MinHeight="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="5" Text="드라이버 옵션 (key=value, 한 줄에 하나):" FontWeight="Bold" Margin="0,0,0,5"/>
				<TextBox Grid.Row="6" x:Name="txtDriverOptions" Padding="5" MinHeight="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
			</Grid>
		</Expander>

		<StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button x:Name="btnOk" Content="생성" IsDefault="True" Click="BtnOk_Click" Width="88" Margin="0,0,10,0" Style="{StaticResource DialogVolumeButtonStyle}"/>
        <Button Content="취소" IsCancel="True" Width="80" Style="{StaticResource DialogSecondaryButtonStyle}"/>
		</StackPanel>
	</Grid>
</Window>
