<Window x:Class="DockerDiagram.Views.SwarmServiceCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm Service 생성" Height="720" Width="780"
        MinHeight="620" MinWidth="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogStrongBorderBrush}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DialogComboBoxStyle}">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-6,0,10"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
        <TextBlock x:Name="DialogTitleTextBlock" Text="Swarm Service 생성" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock x:Name="DialogDescriptionTextBlock" Text="Docker Engine에 실제 서비스를 생성하고 현재 Swarm 다이어그램에 연결합니다."
                       Style="{StaticResource DialogHintStyle}" Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{StaticResource DialogSurfaceBrush}" BorderBrush="{StaticResource DialogBorderBrush}">
            <TabItem Header="일반">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                    <TextBlock Text="Service 이름 *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ServiceNameTextBox" Text="web"/>

                    <TextBlock Text="이미지 *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ImageTextBox" Text="nginx:latest"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                    <TextBlock Text="모드" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ModeComboBox" SelectionChanged="ModeComboBox_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Tag="replicated" Content="복제 모드"/>
                            <ComboBoxItem Tag="global" Content="전역 모드"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                    <TextBlock Text="Replica 수" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ReplicasTextBox" Text="1"/>
                            </StackPanel>
                        </Grid>

                    <TextBlock Text="명령" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CommandTextBox"/>
                        <TextBlock Text="실행 파일 하나를 입력합니다. 예: /bin/sh" Style="{StaticResource Hint}"/>

                    <TextBlock Text="인수 (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ArgumentsTextBox" Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="환경 변수 (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EnvironmentTextBox" Height="88" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="KEY=value 또는 KEY" Style="{StaticResource Hint}"/>

                    <TextBlock Text="레이블 (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="LabelsTextBox" Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="key=value 형식. 값이 없는 key도 허용됩니다." Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="연결">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                    <TextBlock Text="공개 포트 (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PortsTextBox" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="[published:]target[/tcp|udp|sctp][@ingress|host]  예: 8080:80/tcp@ingress" Style="{StaticResource Hint}"/>

                    <TextBlock Text="Overlay Network (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NetworksTextBox" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="network|alias1,alias2  예: frontend|web,public" Style="{StaticResource Hint}"/>

                    <TextBlock Text="마운트 (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MountsTextBox" Height="130" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="volume|source|target|ro 또는 bind|source|target|rw. tmpfs는 source를 비울 수 있습니다."
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="정책">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                    <TextBlock Text="재시작 정책" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DialogTextBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                        <TextBlock Text="조건" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="RestartConditionComboBox" SelectedIndex="2">
                                <ComboBoxItem Tag="none" Content="없음"/>
                                <ComboBoxItem Tag="on-failure" Content="실패 시"/>
                                <ComboBoxItem Tag="any" Content="항상"/>
                                </ComboBox>
                            </StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="지연 (초)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RestartDelayTextBox" Text="5"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="최대 시도 횟수" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RestartMaxAttemptsTextBox"/></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Text="판정 시간 (초)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RestartWindowTextBox"/></StackPanel>
                        </Grid>

                        <Separator Margin="0,8,0,14"/>
                    <TextBlock Text="업데이트 정책" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DialogTextBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="동시 처리 수" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UpdateParallelismTextBox" Text="1"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="지연 (초)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UpdateDelayTextBox" Text="0"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="감시 시간 (초)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UpdateMonitorTextBox"/></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Text="실패 비율" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UpdateRatioTextBox"/></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="실패 시 작업" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UpdateActionComboBox" SelectedIndex="0"><ComboBoxItem Tag="pause" Content="일시정지"/><ComboBoxItem Tag="continue" Content="계속"/><ComboBoxItem Tag="rollback" Content="롤백"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="순서" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UpdateOrderComboBox" SelectedIndex="0"><ComboBoxItem Tag="stop-first" Content="먼저 중지"/><ComboBoxItem Tag="start-first" Content="먼저 시작"/></ComboBox></StackPanel>
                        </Grid>

                        <Separator Margin="0,8,0,14"/>
                    <TextBlock Text="롤백 정책" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DialogTextBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="동시 처리 수" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RollbackParallelismTextBox" Text="1"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="지연 (초)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RollbackDelayTextBox" Text="0"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="감시 시간 (초)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RollbackMonitorTextBox"/></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Text="실패 비율" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RollbackRatioTextBox"/></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="실패 시 작업" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RollbackActionComboBox" SelectedIndex="0"><ComboBoxItem Tag="pause" Content="일시정지"/><ComboBoxItem Tag="continue" Content="계속"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="순서" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RollbackOrderComboBox" SelectedIndex="0"><ComboBoxItem Tag="stop-first" Content="먼저 중지"/><ComboBoxItem Tag="start-first" Content="먼저 시작"/></ComboBox></StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PlacementResourcesTab" Header="배치 및 리소스">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                    <TextBlock Text="배치 제약 조건 (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PlacementConstraintsTextBox" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Docker constraint 문법을 사용합니다. 예: node.role==worker 또는 node.labels.zone==seoul" Style="{StaticResource Hint}"/>

                    <TextBlock Text="기존 Secret (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SecretsTextBox" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="name[|target|uid|gid|mode]  예: db_password|/run/secrets/db_password|0|0|0400" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="AvailableSecretsTextBlock" Foreground="{StaticResource DialogMutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,12"/>

                    <TextBlock Text="기존 Config (한 줄에 하나)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ConfigsTextBox" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="name[|target|uid|gid|mode]  예: nginx_conf|/etc/nginx/nginx.conf|0|0|0444" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="AvailableConfigsTextBlock" Foreground="{StaticResource DialogMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationMessageTextBlock" Foreground="{StaticResource DialogDangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="취소" Width="96" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True"/>
        <Button x:Name="SubmitButton" Content="Service 생성" Width="132" MinHeight="38" Click="CreateButton_Click" IsDefault="True" Style="{StaticResource DialogSwarmButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
