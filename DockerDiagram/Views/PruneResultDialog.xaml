<Window x:Class="DockerDiagram.Views.PruneResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Docker 정리 결과"
        Width="600"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ResultCardStyle" TargetType="Border" BasedOn="{StaticResource DialogBodyCardStyle}">
                <Setter Property="Background" Value="{StaticResource DialogSubtleSurfaceBrush}"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="4"/>
            </Style>

            <Style x:Key="ResultValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            </Style>

            <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}"/>
            </Style>

            <Style x:Key="DetailExpanderStyle" TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeaderPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ResultIconBorder" Width="44" Height="44" CornerRadius="22"
                        Background="{StaticResource DialogSuccessSurfaceBrush}"
                        BorderBrush="{StaticResource DialogSuccessBorderBrush}"
                        BorderThickness="1" Margin="0,0,14,0">
                    <Grid>
                        <Path x:Name="SuccessIconPath"
                              Data="M9,16.2L4.8,12L3.4,13.4L9,19L21,7L19.6,5.6Z"
                              Width="23" Height="23" Stretch="Uniform"
                              Fill="{StaticResource DialogSuccessBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="FailureIconPath"
                              Data="M13,14H11V10H13V14M13,18H11V16H13V18M1,21H23L12,2L1,21Z"
                              Width="23" Height="23" Stretch="Uniform"
                              Fill="{StaticResource DialogDangerBrush}" Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultTitleText" Text="정리 완료"
                               Style="{StaticResource DialogTitleStyle}"/>
                    <TextBlock x:Name="OperationNameText" Margin="0,4,0,0"
                               FontSize="11" Foreground="{StaticResource DialogMutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="570">
            <StackPanel Margin="20,18">
                <Border Style="{StaticResource DialogInfoPanelStyle}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SummaryText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource DialogInfoTextBrush}"/>
                            <TextBlock x:Name="DetailHintText"
                                       Text="삭제된 리소스 목록은 아래 상세 보기에서 확인할 수 있습니다."
                                       Margin="0,3,0,0" FontSize="10.5"
                                       Foreground="{StaticResource DialogInfoTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right">
                            <TextBlock x:Name="ReclaimedSpaceText" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource DialogSuccessBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="확보한 공간" FontSize="10.5"
                                       Foreground="{StaticResource DialogMutedTextBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Rows="2" Columns="3" Margin="-4,12,-4,0">
                    <Border Style="{StaticResource ResultCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="ContainerCountText" Style="{StaticResource ResultValueStyle}"/>
                            <TextBlock Text="컨테이너" Style="{StaticResource ResultLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ResultCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="ImageCountText" Style="{StaticResource ResultValueStyle}"/>
                            <TextBlock Text="이미지" Style="{StaticResource ResultLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ResultCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="VolumeCountText" Style="{StaticResource ResultValueStyle}"/>
                            <TextBlock Text="볼륨" Style="{StaticResource ResultLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ResultCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="NetworkCountText" Style="{StaticResource ResultValueStyle}"/>
                            <TextBlock Text="네트워크" Style="{StaticResource ResultLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ResultCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="BuildCacheCountText" Style="{StaticResource ResultValueStyle}"/>
                            <TextBlock Text="빌드 캐시" Style="{StaticResource ResultLabelStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ResultCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="FailureCountText" Style="{StaticResource ResultValueStyle}"/>
                            <TextBlock Text="실패" Style="{StaticResource ResultLabelStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border x:Name="FailurePanel" Style="{StaticResource DialogErrorPanelStyle}"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FailureSummaryText" FontWeight="SemiBold"
                                   Foreground="{StaticResource DialogErrorTextBrush}"/>
                        <TextBlock Text="삭제하지 못한 항목은 아래 실패 상세에서 확인하세요."
                                   Margin="0,3,0,0" FontSize="10.5"
                                   Foreground="{StaticResource DialogErrorTextBrush}"/>
                    </StackPanel>
                </Border>

                <Expander x:Name="DeletedItemsExpander" Style="{StaticResource DetailExpanderStyle}"
                          Visibility="Collapsed">
                    <Border Margin="0,8,0,0" CornerRadius="6"
                            BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1"
                            Background="{StaticResource DialogSurfaceBrush}" Padding="6">
                        <ListView x:Name="DeletedItemsList" Height="176"
                                  Style="{StaticResource DialogListViewStyle}"
                                  BorderThickness="0" FontWeight="Normal"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4" ToolTip="{Binding Value}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" FontSize="10.5"
                                                   Foreground="{StaticResource DialogMutedTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   TextTrimming="CharacterEllipsis" FontFamily="Consolas"
                                                   Foreground="{StaticResource DialogTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Expander>

                <Expander x:Name="FailedItemsExpander" Style="{StaticResource DetailExpanderStyle}"
                          Visibility="Collapsed">
                    <Border Margin="0,8,0,0" CornerRadius="6"
                            BorderBrush="{StaticResource DialogErrorBorderBrush}" BorderThickness="1"
                            Background="{StaticResource DialogErrorSurfaceBrush}" Padding="6">
                        <ListView x:Name="FailedItemsList" MaxHeight="132"
                                  Background="Transparent" BorderThickness="0" FontWeight="Normal"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyDetailsButton" Content="상세 복사"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Margin="0,0,10,0" Click="CopyDetailsButton_Click"/>
                <Button Content="닫기" IsDefault="True" IsCancel="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
