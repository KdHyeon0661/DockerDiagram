<Window x:Class="DockerDiagram.Views.MountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="볼륨 연결"
        SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogWarningPanelStyle}" BorderBrush="{StaticResource DialogVolumeBrush}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="주의: 컨테이너가 재생성됩니다." FontWeight="SemiBold" Foreground="{StaticResource DialogWarningBrush}" Margin="0,0,0,5"/>
                <TextBlock Text="데이터를 보존하기 위해 [백업 → 삭제 → 재생성 → 복원] 과정을 자동으로 수행합니다." 
                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource DialogWarningTextBrush}"/>
            </StackPanel>
        </Border>

            <TextBlock Grid.Row="1" Text="컨테이너 경로 (필수):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="txtPath" Padding="5" Margin="0,0,0,15" 
                 ToolTip="컨테이너 내부에서 데이터가 저장될 경로입니다. (예: /var/lib/mysql)"/>

        <StackPanel Grid.Row="3" Margin="0,0,0,5">
            <TextBlock Text="소유자 User:Group (선택):" FontWeight="Bold"/>
            <TextBlock Text="복원된 파일의 권한 오류를 수정합니다." FontSize="10" Foreground="{StaticResource DialogMutedTextBrush}" Margin="0,2,0,0"/>
        </StackPanel>
        <TextBox Grid.Row="4" x:Name="txtOwner" Padding="5" Margin="0,0,0,15" 
                 ToolTip="예: mysql:mysql 또는 1000:1000. 비워두면 기본값(root)이 유지됩니다."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="연결" IsDefault="True" Click="BtnOk_Click" Width="88" Margin="0,0,10,0" Style="{StaticResource DialogVolumeButtonStyle}"/>
            <Button Content="취소" IsCancel="True" Width="80" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
