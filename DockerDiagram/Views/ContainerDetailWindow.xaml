<Window x:Class="DockerDiagram.ContainerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="{Binding Name, StringFormat='Details &amp; Logs : {0}'}" 
        Height="650" Width="850" 
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding ContainerId, StringFormat='ID: {0}'}" FontSize="12" Foreground="#888" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding ImageName, StringFormat=' | {0}'}" FontSize="12" Foreground="#007ACC" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DetailStatus}" FontSize="16" FontWeight="Bold" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Uptime}" FontSize="11" Foreground="#888" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="15" Background="White" BorderBrush="#DDD" BorderThickness="1">

            <TabItem Header="📊 Status" FontSize="14" Padding="15,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <TextBlock Text="Resource Usage (Live)" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="60"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,2">
                                        <TextBlock Text="CPU Usage" Foreground="#888" FontSize="12"/>
                                        <TextBlock Text="{Binding CpuUsage}" Foreground="#28a745" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1" DisableAnimations="True" Hoverable="False">
                                        <lvc:CartesianChart.Series>
                                            <lvc:LineSeries Values="{Binding CpuChartValues}" Stroke="#28a745" Fill="#3328a745" PointGeometry="{x:Null}" LineSmoothness="0.5"/>
                                        </lvc:CartesianChart.Series>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis MinValue="0" MaxValue="100"/>
                                        </lvc:CartesianChart.AxisY>
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding TimeLabels}" ShowLabels="False" />
                                        </lvc:CartesianChart.AxisX>
                                    </lvc:CartesianChart>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="60"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,2">
                                        <TextBlock Text="Memory Usage" Foreground="#888" FontSize="12"/>
                                        <TextBlock Text="{Binding MemoryUsage}" Foreground="#007ACC" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1" DisableAnimations="True" Hoverable="False">
                                        <lvc:CartesianChart.Series>
                                            <lvc:LineSeries Values="{Binding MemoryChartValues}" Stroke="#007ACC" Fill="#33007ACC" PointGeometry="{x:Null}" LineSmoothness="0.5"/>
                                        </lvc:CartesianChart.Series>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis MinValue="0" />
                                        </lvc:CartesianChart.AxisY>
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding TimeLabels}" ShowLabels="False" />
                                        </lvc:CartesianChart.AxisX>
                                    </lvc:CartesianChart>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="Live Resource Limiter (동적 자원 제한)" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#F8F0FF" BorderBrush="#E5D0FF" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="CPU" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>

                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="{Binding MaxCpuCount}" IsSnapToTickEnabled="False" 
                                            SmallChange="0.1" LargeChange="1.0" Value="{Binding TargetCpuCount}" Margin="10,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox Text="{Binding TargetCpuCount, UpdateSourceTrigger=PropertyChanged}" Width="45" Padding="2" TextAlignment="Right" VerticalContentAlignment="Center" BorderBrush="#CCC"/>
                                        <TextBlock Text=" Core" FontWeight="SemiBold" Foreground="#6f42c1" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="정확한 값을 직접 입력하거나 슬라이더로 대략적으로 조절하세요." FontSize="11" Foreground="#888" Margin="10,5,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Memory" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>

                                    <Slider Grid.Column="1" Minimum="64" Maximum="{Binding MaxMemoryMb}" IsSnapToTickEnabled="False" 
                                            SmallChange="128" LargeChange="1024" Value="{Binding TargetMemoryMb}" Margin="10,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox Text="{Binding TargetMemoryMb, UpdateSourceTrigger=PropertyChanged}" Width="55" Padding="2" TextAlignment="Right" VerticalContentAlignment="Center" BorderBrush="#CCC"/>
                                        <TextBlock Text=" MB" FontWeight="SemiBold" Foreground="#6f42c1" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="예: 1024, 2048 등 정확한 MB 단위 용량을 직접 텍스트 박스에 입력하세요." FontSize="11" Foreground="#888" Margin="10,5,0,0"/>
                                </Grid>

                                <Button Command="{Binding UpdateResourcesCommand}" Content="⚡ 무중단 즉시 적용 (Apply Live)" Background="#6f42c1" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" FontWeight="Bold" HorizontalAlignment="Right">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Container Controls" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,0,20">
                            <UniformGrid Rows="1">
                                <Button Command="{Binding StartCommand}" Content="▶ Start" Background="#28a745" Foreground="White" BorderThickness="0" Padding="10,8" Margin="2" Cursor="Hand" FontWeight="Bold"/>
                                <Button Command="{Binding StopCommand}" Content="■ Stop" Background="#dc3545" Foreground="White" BorderThickness="0" Padding="10,8" Margin="2" Cursor="Hand" FontWeight="Bold"/>
                                <Button Command="{Binding PauseCommand}" Content="⏸ Pause" Background="#ffc107" Foreground="#333" BorderThickness="0" Padding="10,8" Margin="2" Cursor="Hand" FontWeight="Bold" ToolTip="Pause/Unpause"/>
                                <Button Command="{Binding RestartCommand}" Content="🔄 Restart" Background="#17a2b8" Foreground="White" BorderThickness="0" Padding="10,8" Margin="2" Cursor="Hand" FontWeight="Bold"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Lifecycle &amp; Policies" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Started At" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding StartedAt}" FontFamily="Consolas" Foreground="#333" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Finished At" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding FinishedAt}" FontFamily="Consolas" Foreground="#333" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Restart Policy" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding RestartPolicy}" FontWeight="SemiBold" Foreground="#333" FontSize="13"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Health Status" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding HealthStatus}" FontWeight="Bold" Foreground="{Binding HealthColor}" FontSize="13"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚙️ Configuration" FontSize="14" Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Environment Variables" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding EnvironmentVariables}" 
                             BorderBrush="#EEE" Background="#FAFAFA" Margin="0,0,0,20" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#D63384" Padding="3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="Port Bindings" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="3" ItemsSource="{Binding PortBindings}" 
                             BorderBrush="#EEE" Background="#FAFAFA" Margin="0,0,0,0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Padding="3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="🌐 Networks" FontSize="14" Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Connected Networks" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding NetworkDetailList}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderBrush="#EEE" Background="White" Margin="0,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Network Name" Binding="{Binding NetworkName}" Width="*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="IPv4 Address" Binding="{Binding IPv4}" Width="*" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="IPv6 Address" Binding="{Binding IPv6}" Width="*" FontFamily="Consolas"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="💾 Volumes" FontSize="14" Padding="15,8">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Current View : " FontWeight="Bold" FontSize="14" Foreground="#555"/>
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="📦 Named Volumes"/>
                                            <Setter Property="Foreground" Value="#007ACC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VolumeDisplayMode}" Value="1">
                                                    <Setter Property="Text" Value="🔗 Bind Mounts"/>
                                                    <Setter Property="Foreground" Value="#E67E22"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock FontSize="11" Foreground="#888">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="도커 엔진에서 관리하는 볼륨 목록입니다."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VolumeDisplayMode}" Value="1">
                                                <Setter Property="Text" Value="호스트 PC의 경로와 연결된 바인드 마운트 목록입니다."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding ToggleVolumeModeCommand}" Content="🔄 Switch Type" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1" Foreground="#333" Padding="15,5" Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding MountedVolumeList}" 
                             BorderBrush="#EEE" Background="#FAFAFA" Margin="0,0,0,0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#333" Padding="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="📁 File Transfer" FontSize="14" Padding="15,8">
                <StackPanel Margin="15">
                    <TextBlock Text="컨테이너 내부와 호스트(내 PC) 간에 파일/폴더를 복사합니다." Foreground="#888" Margin="0,0,0,20"/>

                    <TextBlock Text="Host Path (내 PC 경로)" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HostFilePath, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15" ToolTip="예: C:\temp\dump.sql"/>

                    <TextBlock Text="Container Path (컨테이너 내부 경로)" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ContainerFilePath, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,20" ToolTip="예: /var/lib/mysql/dump.sql"/>

                    <UniformGrid Columns="2">
                        <Button Command="{Binding CopyToContainerCommand}" Content="⬆️ Copy To Container (업로드)" Background="#28a745" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,5,0" Cursor="Hand" FontWeight="Bold"/>
                        <Button Command="{Binding CopyFromContainerCommand}" Content="⬇️ Copy From Container (다운로드)" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="10" Margin="5,0,0,0" Cursor="Hand" FontWeight="Bold"/>
                    </UniformGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="📄 Logs" FontSize="14" Padding="15,8">
                <Grid Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#2D2D2D" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍 Find:" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                                <TextBox x:Name="txtLogSearch" Width="150" Padding="3,2" Background="#444" Foreground="White" BorderThickness="1" BorderBrush="#555" VerticalContentAlignment="Center" 
                                         TextChanged="TxtLogSearch_TextChanged" ToolTip="검색어 입력 시 실시간으로 노란색 하이라이트됩니다."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding CopyLogsCommand}" Content="📋 Copy" Background="#444" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,5,0" Cursor="Hand"/>
                                <Button Command="{Binding ExportLogsCommand}" Content="💾 Export" Background="#444" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding RefreshLogsCommand}" Content="🔄 Refresh" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="lbLogs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True" 
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <Button Content="Close" Width="100" Height="35" HorizontalAlignment="Right" Background="#DDD" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
        </Border>
    </Grid>
</Window>