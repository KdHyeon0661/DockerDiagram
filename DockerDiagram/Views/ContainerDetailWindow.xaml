<Window x:Class="DockerDiagram.ContainerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="{Binding Name, StringFormat='Details &amp; Logs : {0}'}" 
        Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ContainerControlButtonBase" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E3E7EB"/>
                    <Setter Property="Foreground" Value="#68737D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartContainerButton" TargetType="Button" BasedOn="{StaticResource ContainerControlButtonBase}">
            <Setter Property="Background" Value="#28A745"/>
        </Style>
        <Style x:Key="StopContainerButton" TargetType="Button" BasedOn="{StaticResource ContainerControlButtonBase}">
            <Setter Property="Background" Value="#DC3545"/>
        </Style>
        <Style x:Key="PauseContainerButton" TargetType="Button" BasedOn="{StaticResource ContainerControlButtonBase}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="RestartContainerButton" TargetType="Button" BasedOn="{StaticResource ContainerControlButtonBase}">
            <Setter Property="Background" Value="#17A2B8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding ContainerId, StringFormat='ID: {0}'}" FontSize="12" Foreground="#888" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding ImageName, StringFormat=' | {0}'}" FontSize="12" Foreground="#007ACC" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DetailStatus}" FontSize="16" FontWeight="Bold" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Uptime}" FontSize="11" Foreground="#888" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="DetailTabControl" Grid.Row="1" Margin="15" Background="White" BorderBrush="#DDD" BorderThickness="1">

            <TabItem Header="☷ Swarm Service" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsSwarmService, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Service Summary" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Mode" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Column="1" Text="{Binding SwarmMode}" FontWeight="SemiBold" Margin="0,0,12,8"/>
                                <TextBlock Grid.Column="2" Text="Replicas" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Column="3" Text="{Binding SwarmReplicaSummary}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="Image" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ImageName}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="Ports" Foreground="#777"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PortInfo}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Scale" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#F8F0FF" BorderBrush="#E5D0FF" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="replicated mode service의 desired replica 수를 변경합니다." Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBox Grid.Column="1" Text="{Binding TargetSwarmReplicas, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="6,4" TextAlignment="Right" FontFamily="Consolas" Margin="10,0"/>
                                <Button Grid.Column="2" Command="{Binding ScaleSwarmServiceCommand}" Content="Apply" Background="#6f42c1" Foreground="White" BorderThickness="0" Padding="14,6" FontWeight="Bold" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Actions" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <UniformGrid Rows="1" Margin="0,0,0,18">
                            <Button Command="{Binding RefreshSwarmServiceCommand}" Content="Refresh" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="10,8" Margin="0,0,5,0" Cursor="Hand" FontWeight="Bold"/>
                            <Button Command="{Binding RemoveSwarmServiceCommand}" Content="Remove Service" Background="#dc3545" Foreground="White" BorderThickness="0" Padding="10,8" Margin="5,0,0,0" Cursor="Hand" FontWeight="Bold"/>
                        </UniformGrid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tasks" FontWeight="Bold" FontSize="14" Foreground="#555"/>
                            <TextBlock Text="{Binding SwarmTaskSummary}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#59636F"/>
                        </Grid>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,0,0,18">
                            <ListView ItemsSource="{Binding SwarmTasks}" BorderThickness="0" Background="Transparent" MaxHeight="220">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Slot" Width="48" DisplayMemberBinding="{Binding Slot}"/>
                                        <GridViewColumn Header="Task" Width="105" DisplayMemberBinding="{Binding ShortId}"/>
                                        <GridViewColumn Header="Node" Width="130" DisplayMemberBinding="{Binding NodeName}"/>
                                        <GridViewColumn Header="Desired" Width="80" DisplayMemberBinding="{Binding DesiredState}"/>
                                        <GridViewColumn Header="State" Width="95">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CurrentState}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Container" Width="105" DisplayMemberBinding="{Binding ShortContainerId}"/>
                                        <GridViewColumn Header="Error" Width="220" DisplayMemberBinding="{Binding Error}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <TextBlock Text="Raw Inspect" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SwarmServiceInspectJson}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0" Padding="10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="☸ Kubernetes Pod" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsKubernetesPod, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Pod Summary" FontWeight="Bold" FontSize="14" Foreground="#555"/>
                            <Button Command="{Binding RefreshKubernetesPodCommand}" Content="Refresh" HorizontalAlignment="Right"
                                    Background="#326CE5" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" FontWeight="Bold"/>
                        </Grid>

                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Namespace" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Column="1" Text="{Binding KubernetesNamespace}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,12,8"/>
                                <TextBlock Grid.Column="2" Text="Pod" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Column="3" Text="{Binding KubernetesPodName}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="Ready" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KubernetesReady}" FontFamily="Consolas" Margin="0,0,12,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Restarts" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding KubernetesRestarts}" FontFamily="Consolas" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="Pod IP" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KubernetesPodIp}" FontFamily="Consolas" Margin="0,0,12,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Node" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding KubernetesNodeName}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Text="Image" Foreground="#777"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ImageName}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <Border Background="#F7FAFF" BorderBrush="#D7E3FF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Live Actions" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Command="{Binding OpenKubernetesLogsFollowCommand}" Content="Follow Logs" Height="32" Margin="0,0,8,0"
                                            Padding="14,0"
                                            Background="#326CE5" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Command="{Binding OpenKubernetesPortForwardCommand}" Content="Port Forward" Height="32" Margin="0,0,8,0"
                                            Padding="14,0"
                                            Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Command="{Binding ExportKubernetesYamlCommand}" Content="Export YAML" Height="32" Margin="0,0,8,0"
                                            Padding="14,0"
                                            Background="#455A64" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Command="{Binding ApplyKubernetesManifestCommand}" Content="Apply Manifest" Height="32" Margin="0,0,8,0"
                                            Padding="14,0"
                                            Background="#00897B" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Command="{Binding DeleteKubernetesResourceCommand}" Content="Delete Pod" Height="32"
                                            Padding="14,0"
                                            Background="#D32F2F" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TabControl Background="White" BorderBrush="#DDD" BorderThickness="1">
                            <TabItem Header="Describe" Padding="10,6">
                                <TextBox Text="{Binding KubernetesPodDescribeText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="300"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0" Padding="10"/>
                            </TabItem>
                            <TabItem Header="YAML" Padding="10,6">
                                <TextBox Text="{Binding KubernetesPodYamlText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="300"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0" Padding="10"/>
                            </TabItem>
                            <TabItem Header="JSON" Padding="10,6">
                                <TextBox Text="{Binding KubernetesPodJsonText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="300"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0" Padding="10"/>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="☸ Kubernetes Resource" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsGenericKubernetesResource, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Resource Summary" FontWeight="Bold" FontSize="14" Foreground="#555"/>
                            <Button Command="{Binding RefreshKubernetesResourceCommand}" Content="Refresh" HorizontalAlignment="Right"
                                    Background="#326CE5" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" FontWeight="Bold"/>
                        </Grid>

                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Kind" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Column="1" Text="{Binding KubernetesKind}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,12,8"/>
                                <TextBlock Grid.Column="2" Text="Namespace" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Column="3" Text="{Binding KubernetesNamespace}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="Name" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KubernetesResourceName}" FontFamily="Consolas" Margin="0,0,12,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="API" Foreground="#777" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding KubernetesApiVersion}" FontFamily="Consolas" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="Status" Foreground="#777"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailStatus}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <Border Background="#F7FAFF" BorderBrush="#D7E3FF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,18"
                                Visibility="{Binding IsKubernetesDeployment, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Deployment Control" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Replicas" VerticalAlignment="Center" Foreground="#666"/>
                                    <TextBox Grid.Column="1" Text="{Binding TargetKubernetesReplicas, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Consolas"/>
                                    <Button Grid.Column="2" Command="{Binding ScaleKubernetesDeploymentCommand}" Content="Apply" Height="30" Padding="14,0" Margin="8,0,0,0"
                                            Background="#326CE5" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Grid.Column="3" Command="{Binding RestartKubernetesRolloutCommand}" Content="Rollout Restart" Height="30" Padding="14,0" Margin="8,0,0,0"
                                            Background="#6F42C1" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="4" Text="{Binding KubernetesReplicaSummary}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#666"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Resource Actions" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Command="{Binding OpenKubernetesPortForwardCommand}" Content="Port Forward" Height="32" Margin="0,0,8,0"
                                            Padding="14,0"
                                            Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Command="{Binding ExportKubernetesYamlCommand}" Content="Export YAML" Height="32" Margin="0,0,8,0"
                                            Padding="14,0"
                                            Background="#455A64" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Command="{Binding ApplyKubernetesManifestCommand}" Content="Apply Manifest" Height="32" Margin="0,0,8,0"
                                            Padding="14,0"
                                            Background="#00897B" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Command="{Binding DeleteKubernetesResourceCommand}" Content="Delete Resource" Height="32"
                                            Padding="14,0"
                                            Background="#D32F2F" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TabControl Background="White" BorderBrush="#DDD" BorderThickness="1">
                            <TabItem Header="Describe" Padding="10,6">
                                <TextBox Text="{Binding KubernetesPodDescribeText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="300"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0" Padding="10"/>
                            </TabItem>
                            <TabItem Header="YAML" Padding="10,6">
                                <TextBox Text="{Binding KubernetesPodYamlText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="300"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0" Padding="10"/>
                            </TabItem>
                            <TabItem Header="JSON" Padding="10,6">
                                <TextBox Text="{Binding KubernetesPodJsonText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="300"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0" Padding="10"/>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📊 Status" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsDockerRuntimeContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <TextBlock Text="Container Controls" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,0,20">
                            <UniformGrid Rows="1">
                                <Button Command="{Binding StartCommand}" Content="▶ Start" Style="{StaticResource StartContainerButton}"/>
                                <Button Command="{Binding StopCommand}" Content="■ Stop" Style="{StaticResource StopContainerButton}"/>
                                <Button Command="{Binding PauseCommand}" Content="⏸ Pause" Style="{StaticResource PauseContainerButton}" ToolTip="Pause/Unpause"/>
                                <Button Command="{Binding RestartCommand}" Content="🔄 Restart" Style="{StaticResource RestartContainerButton}"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Resource Usage (Live)" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="85"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,2">
                                        <TextBlock Text="CPU Usage" Foreground="#888" FontSize="12"/>
                                        <TextBlock Text="{Binding Monitoring.CpuUsage}" Foreground="#28a745" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <oxy:PlotView x:Name="cpuPlotView" Grid.Row="1" Model="{Binding Monitoring.CpuPlotModel}" Background="Transparent" Margin="0,5,0,0"/>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="85"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,2">
                                        <TextBlock Text="Memory Usage" Foreground="#888" FontSize="12"/>
                                        <TextBlock Text="{Binding Monitoring.MemoryUsage}" Foreground="#007ACC" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <oxy:PlotView x:Name="memoryPlotView" Grid.Row="1" Model="{Binding Monitoring.MemoryPlotModel}" Background="Transparent" Margin="0,5,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Expander IsExpanded="False" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="Runtime Resource Limits" FontWeight="Bold" FontSize="14" Foreground="#555"/>
                        </Expander.Header>
                        <Border Background="#F7F8FA" BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,8,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="CPU" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>

                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="{Binding Monitoring.MaxCpuCount}" IsSnapToTickEnabled="False"
                                            SmallChange="{Binding Monitoring.CpuAdjustmentStep}" LargeChange="1.0"
                                            Value="{Binding Monitoring.CpuSliderValue}" Margin="10,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Monitoring.TargetCpuCount, UpdateSourceTrigger=PropertyChanged}" Width="45" Padding="2" TextAlignment="Right" VerticalContentAlignment="Center" BorderBrush="#CCC"/>
                                        <TextBlock Text=" Core" FontWeight="SemiBold" Foreground="#6f42c1" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,6,0,0">
                                        <TextBlock Text="Step:" FontSize="11" Foreground="#777" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton Content="0.25" GroupName="CpuResourceStep" IsChecked="{Binding Monitoring.IsCpuStepQuarter, Mode=TwoWay}" FontSize="11" Margin="0,0,10,0"/>
                                        <RadioButton Content="0.5" GroupName="CpuResourceStep" IsChecked="{Binding Monitoring.IsCpuStepHalf, Mode=TwoWay}" FontSize="11" Margin="0,0,10,0"/>
                                        <RadioButton Content="1" GroupName="CpuResourceStep" IsChecked="{Binding Monitoring.IsCpuStepOne, Mode=TwoWay}" FontSize="11"/>
                                        <TextBlock Text=" Core" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Memory" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>

                                    <Slider Grid.Column="1" Minimum="64" Maximum="{Binding Monitoring.MaxMemoryMb}" IsSnapToTickEnabled="False"
                                            SmallChange="{Binding Monitoring.MemoryAdjustmentStepMb}" LargeChange="1024"
                                            Value="{Binding Monitoring.MemorySliderValue}" Margin="10,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Monitoring.TargetMemoryMb, UpdateSourceTrigger=PropertyChanged}" Width="55" Padding="2" TextAlignment="Right" VerticalContentAlignment="Center" BorderBrush="#CCC"/>
                                        <TextBlock Text=" MB" FontWeight="SemiBold" Foreground="#6f42c1" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,6,0,0">
                                        <TextBlock Text="Step:" FontSize="11" Foreground="#777" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton Content="64" GroupName="MemoryResourceStep" IsChecked="{Binding Monitoring.IsMemoryStep64, Mode=TwoWay}" FontSize="11" Margin="0,0,10,0"/>
                                        <RadioButton Content="128" GroupName="MemoryResourceStep" IsChecked="{Binding Monitoring.IsMemoryStep128, Mode=TwoWay}" FontSize="11" Margin="0,0,10,0"/>
                                        <RadioButton Content="256" GroupName="MemoryResourceStep" IsChecked="{Binding Monitoring.IsMemoryStep256, Mode=TwoWay}" FontSize="11"/>
                                        <TextBlock Text=" MB" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Changes are applied without restarting the container." FontSize="11" Foreground="#777" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                                <Button Command="{Binding UpdateResourcesCommand}" Content="Apply Changes" Background="#455A64" Foreground="White" BorderThickness="0" Padding="14,7" Cursor="Hand" FontWeight="SemiBold" HorizontalAlignment="Right">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                        </Expander>

                        <TextBlock Text="Lifecycle &amp; Policies" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Started At" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding StartedAt}" FontFamily="Consolas" Foreground="#333" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Last Finished At" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding FinishedAt}" FontFamily="Consolas" Foreground="#333" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Restart Policy" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding RestartPolicy}" FontWeight="SemiBold" Foreground="#333" FontSize="13"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Health Status" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding HealthStatus}" FontWeight="Bold" Foreground="{Binding HealthColor}" FontSize="13"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚙️ Configuration" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsDockerRuntimeContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="15" Grid.IsSharedSizeScope="True">
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8">
                            <Run Text="Environment Variables  "/>
                            <Run Text="{Binding ContainerOperations.EnvironmentItems.Count, Mode=OneWay}" Foreground="#007ACC"/>
                        </TextBlock>
                        <Border Background="#FAFAFA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Background="#F1F3F5" Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" SharedSizeGroup="ConfigKey"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Key" FontWeight="SemiBold" Foreground="#555" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" Foreground="#555" Margin="12,0" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding ContainerOperations.EnvironmentItems}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         PreviewKeyDown="ConfigurationList_OnPreviewKeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" SharedSizeGroup="ConfigKey"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#B42369" Margin="12,7" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="12" Foreground="#333" Margin="12,7" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="환경 변수가 없습니다." Foreground="#888" Margin="12" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContainerOperations.EnvironmentItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8">
                            <Run Text="Port Bindings  "/>
                            <Run Text="{Binding ContainerOperations.PortItems.Count, Mode=OneWay}" Foreground="#007ACC"/>
                        </TextBlock>
                        <Border Background="#FAFAFA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Grid Background="#F1F3F5" Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Host IP" FontWeight="SemiBold" Foreground="#555" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Host Port" FontWeight="SemiBold" Foreground="#555" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Container Port" FontWeight="SemiBold" Foreground="#555" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Protocol" FontWeight="SemiBold" Foreground="#555" Margin="12,0" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding ContainerOperations.PortItems}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         PreviewKeyDown="ConfigurationList_OnPreviewKeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HostIp}" FontFamily="Consolas" Margin="12,7" TextTrimming="CharacterEllipsis" ToolTip="{Binding HostIp}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding HostPort}" FontFamily="Consolas" Margin="12,7"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ContainerPort}" FontFamily="Consolas" Margin="12,7"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Protocol}" FontFamily="Consolas" Margin="12,7"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="게시된 포트가 없습니다." Foreground="#888" Margin="12" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContainerOperations.PortItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="🌐 Networks" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsDockerRuntimeContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Connected Networks" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <TextBlock Text="Review current addresses here. Expand a network only when its connection settings need to change."
                                   Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Network.Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NetworkName}" FontWeight="Bold" FontSize="14" Foreground="#333" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="IPv4 " Foreground="#888"/>
                                                    <TextBlock Text="{Binding IPv4}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#333"/>
                                                    <TextBlock Text="   ·   IPv6 " Foreground="#AAA"/>
                                                    <TextBlock Text="{Binding IPv6}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#333"/>
                                                </StackPanel>
                                            </Grid>

                                            <Expander IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}" Margin="0,12,0,0">
                                                <Expander.Header>
                                                    <TextBlock Text="Advanced network settings" FontWeight="SemiBold" Foreground="#555"/>
                                                </Expander.Header>
                                                <StackPanel Margin="0,8,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="125"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="Static IPv4" Foreground="#555" Margin="0,0,10,8" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding StaticIPv4, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="5,3" Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="1" Text="Static IPv6" Foreground="#555" Margin="0,0,10,8" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StaticIPv6, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="5,3" Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="2" Text="Aliases" Foreground="#555" Margin="0,0,10,8" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="3" Text="Endpoint options" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DriverOptionsText, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"/>
                                                    </Grid>
                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Applying changes briefly reconnects this network. Confirmation is required." Foreground="#9A6700" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <Button Grid.Column="1" Content="Apply Changes" Command="{Binding ApplyCommand}" Padding="12,6" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="💾 Volumes" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsDockerRuntimeContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="15">
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="#007ACC" Margin="0,0,0,3">
                            <Run Text="📦 Named Volumes  "/>
                            <Run Text="{Binding ContainerOperations.NamedVolumeItems.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Docker가 관리하는 볼륨과 컨테이너 내부 연결 위치입니다." Foreground="#888" FontSize="11" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ContainerOperations.NamedVolumeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Volume" Foreground="#888" FontSize="10"/>
                                                <TextBlock Text="{Binding Source}" FontFamily="Consolas" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="→" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Container path" Foreground="#888" FontSize="10"/>
                                                <TextBlock Text="{Binding Target}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}"/>
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="#E8F3FF" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Mode}" FontFamily="Consolas" Foreground="#0067A8"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="연결된 Named Volume이 없습니다." Foreground="#888" FontStyle="Italic" Margin="12,6,0,18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContainerOperations.NamedVolumeItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Separator Margin="0,10,0,16"/>
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="#E67E22" Margin="0,0,0,3">
                            <Run Text="🔗 Bind Mounts  "/>
                            <Run Text="{Binding ContainerOperations.BindMountItems.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="호스트 경로와 컨테이너 내부 연결 위치입니다." Foreground="#888" FontSize="11" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ContainerOperations.BindMountItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Host path" Foreground="#888" FontSize="10"/>
                                                <TextBlock Text="{Binding Source}" FontFamily="Consolas" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="→" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Container path" Foreground="#888" FontSize="10"/>
                                                <TextBlock Text="{Binding Target}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}"/>
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="#FFF1E5" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Mode}" FontFamily="Consolas" Foreground="#B45309"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="연결된 Bind Mount가 없습니다." Foreground="#888" FontStyle="Italic" Margin="12,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContainerOperations.BindMountItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📁 File Transfer" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsDockerRuntimeContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="15">
                        <TextBlock Text="컨테이너와 이 PC 사이에서 파일 또는 폴더를 복사합니다." Foreground="#777" Margin="0,0,0,12"/>
                        <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="5" Padding="16" MaxWidth="900" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Host Path (내 PC 경로)" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding HostFilePath, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" ToolTip="업로드할 파일/폴더 또는 다운로드할 대상 폴더"/>
                                    <Button Grid.Column="1" Command="{Binding ContainerOperations.BrowseHostFileCommand}" Content="File…" Padding="12,5" Margin="6,0,0,0" Background="#F1F3F5" BorderBrush="#C8CDD2" Cursor="Hand"/>
                                    <Button Grid.Column="2" Command="{Binding ContainerOperations.BrowseHostFolderCommand}" Content="Folder…" Padding="12,5" Margin="6,0,0,0" Background="#F1F3F5" BorderBrush="#C8CDD2" Cursor="Hand"/>
                                </Grid>

                                <TextBlock Text="Container Path (컨테이너 내부 경로)" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ContainerFilePath, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" Margin="0,0,0,12" ToolTip="예: /var/lib/mysql 또는 /app/data"/>

                                <Border Background="#F5F7F9" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="3" Padding="10,7" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding ContainerOperations.TransferStatus}" Foreground="#555" TextWrapping="Wrap"/>
                                </Border>

                                <UniformGrid Columns="2">
                                    <Button Command="{Binding CopyToContainerCommand}" Content="⬆ Copy To Container (업로드)" Background="#28A745" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,5,0" Cursor="Hand" FontWeight="Bold"/>
                                    <Button Command="{Binding CopyFromContainerCommand}" Content="⬇ Copy From Container (다운로드)" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="10" Margin="5,0,0,0" Cursor="Hand" FontWeight="Bold"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚡ Actions" FontSize="14" Padding="15,8"
                     Visibility="{Binding IsDockerRuntimeContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="15">
                        <TextBlock Text="Container Actions" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,8"/>
                        <TextBlock Text="이 컨테이너에 직접 적용되는 작업입니다." Foreground="#777" Margin="0,0,0,14"/>

                        <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,14">
                            <UniformGrid Columns="2">
                                <Button Content="Aa  이름 변경" Command="{Binding RenameContainerCommand}" Padding="12,10" Margin="0,0,6,8" Background="#F1F3F5" BorderBrush="#C8CDD2" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="&gt;_  명령 실행" Command="{Binding ExecContainerCommand}" Padding="12,10" Margin="6,0,0,8" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="⬆  이미지로 저장" Command="{Binding CommitContainerCommand}" Padding="12,10" Margin="0,0,6,0" Background="#28A745" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="!  강제 종료" Command="{Binding KillContainerCommand}" Padding="12,10" Margin="6,0,0,0" Background="#DC3545" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Advanced / Debug" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,8,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="5" Padding="16">
                            <Button Content="{}  Docker 원본 JSON 보기" Command="{Binding ViewRawInspectCommand}" Padding="12,9" Background="#F1F3F5" BorderBrush="#C8CDD2" Cursor="Hand" HorizontalAlignment="Left"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="📄 Logs" FontSize="14" Padding="15,8">
                <Grid Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#2D2D2D" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍 Find:" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                                <TextBox x:Name="txtLogSearch" Width="150" Padding="3,2" Background="#444" Foreground="White" BorderThickness="1" BorderBrush="#555" VerticalContentAlignment="Center" 
                                         TextChanged="TxtLogSearch_TextChanged" ToolTip="검색어가 포함된 로그만 표시하고 일치 부분을 강조합니다."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📋 Copy" Click="CopyVisibleLogs_Click" Background="#444" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,5,0" Cursor="Hand" ToolTip="현재 화면에 표시된 로그를 복사합니다."/>
                                <Button Command="{Binding ExportLogsCommand}" Content="💾 Export" Background="#444" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,10,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="lstLogs" Grid.Row="1"
                             Background="Transparent" Foreground="#D4D4D4" BorderThickness="0" Padding="10"
                             FontFamily="Consolas" FontSize="12" Focusable="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#D4D4D4" Margin="0,1" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <Button Content="Close" Width="100" Height="35" HorizontalAlignment="Right" Background="#DDD" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
