<Window x:Class="DockerDiagram.Views.SwarmStackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm Stack" Width="760" Height="680" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource DialogWindowBackgroundBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18" MinHeight="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Swarm Stack" Style="{StaticResource DialogTitleStyle}"/>
                <TextBlock Text="YAML을 저장하거나 Manager에 배포합니다. 선택한 YAML 폴더가 상대경로와 .env의 기준입니다. build는 실행하지 않으며 Registry의 image를 사용합니다."
                           Margin="0,4,0,0" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            <TextBlock Text="Stack 이름" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="StackNameTextBox" Grid.Column="1" MinHeight="38"
                         TextChanged="Input_TextChanged"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <TextBlock Text="원본 YAML" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="SourcePathTextBox" Grid.Column="1" MinHeight="38" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="찾아보기..." Margin="8,0,0,0" Style="{StaticResource DialogSecondaryButtonStyle}" Click="Browse_Click"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            <TextBlock Text="Stack YAML" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="YamlTextBox" Grid.Row="1" Style="{StaticResource DialogCodeTextBoxStyle}" AcceptsTab="True"
                         TextChanged="Input_TextChanged"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            <CheckBox x:Name="PruneCheckBox" Content="YAML에서 제거된 Service 정리" IsChecked="True" Margin="0,0,18,0"/>
            <CheckBox x:Name="RegistryAuthCheckBox" Grid.Column="1" Content="Registry 인증 정보 전송"/>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Text="명령 미리보기" FontSize="10" Foreground="{StaticResource DialogMutedTextBrush}"/>
                    <TextBlock x:Name="CommandPreviewText" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource DialogTextBrush}"
                               MaxWidth="390" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StateText" VerticalAlignment="Center" Foreground="{StaticResource DialogMutedTextBrush}" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="취소" MinWidth="86" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="초안 저장" MinWidth="96" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" Click="Save_Click"/>
            <Button Grid.Column="3" Content="배포" MinWidth="96" Style="{StaticResource DialogSwarmButtonStyle}" Click="Deploy_Click"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
