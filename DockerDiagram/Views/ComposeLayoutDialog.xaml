<Window x:Class="DockerDiagram.Views.ComposeLayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Compose 배치" Width="420" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20" Background="{StaticResource DialogSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="방향" Style="{StaticResource DialogSectionTitleStyle}"/>
        <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="0,0,0,18">
            <RadioButton x:Name="LeftToRightRadio" Content="왼쪽에서 오른쪽" GroupName="Direction" IsChecked="True" Margin="0,0,12,0"/>
            <RadioButton x:Name="TopToBottomRadio" Content="위에서 아래" GroupName="Direction"/>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
        <TextBlock Text="가로 간격" VerticalAlignment="Center"/>
            <Slider x:Name="HorizontalGapSlider" Grid.Column="1" Minimum="50" Maximum="220" TickFrequency="10" IsSnapToTickEnabled="True" Value="90"/>
            <TextBlock Grid.Column="2" Text="{Binding ElementName=HorizontalGapSlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
        <TextBlock Text="세로 간격" VerticalAlignment="Center"/>
            <Slider x:Name="VerticalGapSlider" Grid.Column="1" Minimum="20" Maximum="140" TickFrequency="5" IsSnapToTickEnabled="True" Value="35"/>
            <TextBlock Grid.Column="2" Text="{Binding ElementName=VerticalGapSlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

    <CheckBox x:Name="AdaptiveSpacingCheckBox" Grid.Row="4" Content="큰 프로젝트의 간격 자동 확대" IsChecked="True" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="적용" IsDefault="True" Click="Apply_Click" Width="84" Margin="0,0,8,0" Style="{StaticResource DialogPrimaryButtonStyle}"/>
        <Button Content="취소" IsCancel="True" Width="84" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
