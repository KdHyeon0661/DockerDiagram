<Window x:Class="DockerDiagram.Views.SshConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 원격 서버 연결" Width="400"
        MinHeight="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="원격 도커 데몬 연결 (SSH)" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

		<StackPanel Grid.Row="1">
			<TextBlock Text="프로필 이름 (표시용)" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
			<TextBox x:Name="txtName" Padding="5" Margin="0,0,0,10" Text="운영 서버 (Ubuntu)"/>

			<Grid Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="80"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0">
					<TextBlock Text="호스트 IP 주소" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
					<TextBox x:Name="txtIp" Padding="5" Text="192.168.1.100"/>
				</StackPanel>
				<StackPanel Grid.Column="2">
					<TextBlock Text="포트" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
					<TextBox x:Name="txtPort" Padding="5" Text="22"/>
				</StackPanel>
			</Grid>

			<TextBlock Text="SSH 접속 계정명 (Username)" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
			<TextBox x:Name="txtUser" Padding="5" Margin="0,0,0,10" Text="ubuntu"/>

			<TextBlock Text="인증 키 파일 (.pem / .ppk)" FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBox x:Name="txtKeyPath" Grid.Column="0" Padding="5" IsReadOnly="True" Background="#EEE" Foreground="#666"/>
				<Button x:Name="btnBrowseKey" Grid.Column="1" Content="찾아보기" Width="80" Margin="5,0,0,0" Cursor="Hand" Click="BtnBrowseKey_Click"/>
			</Grid>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,10">
			<TextBlock x:Name="txtStatus" Text="연결 중..." VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#007ACC" Visibility="Collapsed" FontWeight="Bold"/>

			<Button x:Name="btnConnect" Content="연결 및 시트 추가" Width="130" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnConnect_Click" IsDefault="True"/>
			<Button x:Name="btnCancel" Content="취소" Width="80" Height="35" Margin="10,0,0,0" Background="#DDD" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
		</StackPanel>
	</Grid>
</Window>