<Window x:Class="DockerDiagram.Views.StackTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Stack 템플릿"
        Width="520"
        Height="650"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource DialogWindowBackgroundBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeaderPanelStyle}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar" CornerRadius="3" Margin="0,2,14,2"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TemplateNameText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                    <TextBlock x:Name="TemplateDescriptionText" Margin="0,5,0,0" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TemplateSummaryText" Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource DialogDisabledTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,20">
                <TextBlock Text="프로젝트 이름" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBox x:Name="ProjectNameBox"
                         MinHeight="38"
                         Margin="0,7,0,20"
                         Padding="9,5"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource DialogBorderBrush}"
                         BorderThickness="1"/>

                <StackPanel x:Name="VariablesPanel"/>

                <Border Style="{StaticResource DialogInfoPanelStyle}" Padding="12" Margin="0,8,0,0">
                    <CheckBox x:Name="DeployToDockerCheckBox"
                          Content="Docker 리소스 생성 및 시작"
                              IsChecked="True"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource DialogTextBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="90" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button Content="생성" Width="100" MinHeight="38" Style="{StaticResource DialogPrimaryButtonStyle}" Click="Create_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
