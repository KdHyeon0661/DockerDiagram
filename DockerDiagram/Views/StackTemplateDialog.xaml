<Window x:Class="DockerDiagram.Views.StackTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stack Template"
        Width="520"
        Height="650"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D9DEE4" BorderThickness="0,0,0,1" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar" CornerRadius="3" Margin="0,2,14,2"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TemplateNameText" FontSize="20" FontWeight="SemiBold" Foreground="#252B33"/>
                    <TextBlock x:Name="TemplateDescriptionText" Margin="0,5,0,0" Foreground="#606A76" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TemplateSummaryText" Margin="0,7,0,0" FontSize="11" Foreground="#89929D"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,20">
                <TextBlock Text="Project name" FontWeight="SemiBold" Foreground="#3A424C"/>
                <TextBox x:Name="ProjectNameBox"
                         Height="34"
                         Margin="0,7,0,20"
                         Padding="9,5"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CCD3DA"
                         BorderThickness="1"/>

                <StackPanel x:Name="VariablesPanel"/>

                <Border Background="#EAF1F7" BorderBrush="#D4E1EC" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,8,0,0">
                    <CheckBox x:Name="DeployToDockerCheckBox"
                              Content="Create and start Docker resources"
                              IsChecked="True"
                              FontWeight="SemiBold"
                              Foreground="#34404C"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9DEE4" BorderThickness="0,1,0,0" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Create" Width="100" Height="34" Background="#287BAE" Foreground="White" BorderThickness="0" Click="Create_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
