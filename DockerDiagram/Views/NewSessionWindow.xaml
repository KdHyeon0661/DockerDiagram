<Window x:Class="DockerDiagram.Views.NewSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="새 세션"
        Width="900" Height="560" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource DialogWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="SessionCardStyle" TargetType="Border" BasedOn="{StaticResource DialogBodyCardStyle}">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="PrimarySessionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondarySessionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DialogInfoSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DialogInfoTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogInfoBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
        <TextBlock Text="새 세션" Style="{StaticResource DialogTitleStyle}"/>
        <TextBlock Text="먼저 플랫폼을 선택하세요. 연결 정보는 다음 단계에서 설정합니다."
                       Margin="0,6,0,0" Foreground="{StaticResource DialogMutedTextBrush}" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogInfoPanelStyle}" Padding="12,9" Margin="0,18,0,18">
        <TextBlock Text="SSH는 Docker 호스트 또는 Swarm Manager에 연결하며, Kubernetes는 현재 kubectl Context를 엽니다."
                       Foreground="{StaticResource DialogInfoTextBrush}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SessionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource DialogInfoSurfaceBrush}" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Left">
                        <Path Data="{StaticResource DialogDockerIcon}" Fill="{StaticResource DialogDockerBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Border>
                <TextBlock Grid.Row="1" Text="Docker 호스트" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}" Margin="0,12,0,0"/>
                <TextBlock Grid.Row="2" Text="로컬 또는 원격 Docker Engine 하나의 컨테이너, Compose 프로젝트, 네트워크, 볼륨을 관리합니다."
                               Foreground="{StaticResource DialogMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <StackPanel Grid.Row="4">
                <Button Content="로컬 Docker 열기" Style="{StaticResource PrimarySessionButtonStyle}" Click="OpenLocalDocker_Click"/>
                <Button Content="SSH로 연결" Style="{StaticResource SecondarySessionButtonStyle}" Margin="0,8,0,0" Click="OpenRemoteDocker_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SessionCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource DialogSwarmSurfaceBrush}" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Left">
                        <Path Data="{StaticResource DialogNetworkIcon}" Fill="{StaticResource DialogSwarmBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Docker Swarm" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}" Margin="0,12,0,0"/>
                <TextBlock Grid.Row="2" Text="Manager를 통해 단일 또는 다중 노드 Swarm 클러스터를 관리합니다."
                               Foreground="{StaticResource DialogMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <StackPanel Grid.Row="4">
                <Button Content="로컬 Manager 열기" Style="{StaticResource PrimarySessionButtonStyle}" Click="OpenLocalSwarm_Click"/>
                <Button Content="로컬 Swarm 설정..." Style="{StaticResource SecondarySessionButtonStyle}" Margin="0,8,0,0" Click="ConfigureLocalSwarm_Click"/>
                <Button Content="SSH로 Manager 연결" Style="{StaticResource SecondarySessionButtonStyle}" Margin="0,8,0,0" Click="OpenRemoteSwarm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SessionCardStyle}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource DialogInfoSurfaceBrush}" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Left">
                        <Path Data="{StaticResource DialogNetworkIcon}" Fill="{StaticResource DialogKubernetesBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Kubernetes" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}" Margin="0,12,0,0"/>
                <TextBlock Grid.Row="2" Text="현재 kubectl Context가 선택한 클러스터를 열어 노드와 워크로드를 관리합니다."
                               Foreground="{StaticResource DialogMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <Button Grid.Row="4" Content="현재 Context 열기" Style="{StaticResource PrimarySessionButtonStyle}" Click="OpenLocalKubernetes_Click"/>
                </Grid>
            </Border>

        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource DialogMutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="연결 관리" Margin="12,0,0,0" Padding="10,5" Click="ManageConnections_Click"/>
            </StackPanel>
        <Button Grid.Column="1" Content="취소" Width="88" MinHeight="38" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
