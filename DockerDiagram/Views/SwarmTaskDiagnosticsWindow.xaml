<Window x:Class="DockerDiagram.Views.SwarmTaskDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm Task 진단" Height="760" Width="1120"
        MinHeight="620" MinWidth="920" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}" ShowInTaskbar="False">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Style="{StaticResource DialogTitleStyle}"/>
                <TextBlock x:Name="SummaryTextBlock" Foreground="{StaticResource DialogMutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RefreshButton" Content="새로고침" Width="92" MinHeight="38" Margin="0,0,8,0" Click="RefreshButton_Click"
                        Style="{StaticResource DialogSwarmButtonStyle}"/>
            <Button x:Name="ServiceLogsButton" Content="Service 로그" Width="110" MinHeight="38" Click="ServiceLogsButton_Click"
                        Style="{StaticResource DialogSecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogBodyCardStyle}" Padding="0">
            <ListView x:Name="TasksListView" BorderThickness="0" SelectionChanged="TasksListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                            <GridViewColumn Header="슬롯" Width="60" DisplayMemberBinding="{Binding SlotLabel}"/>
                            <GridViewColumn Header="시도" Width="72" DisplayMemberBinding="{Binding AttemptLabel}"/>
                        <GridViewColumn Header="Task" Width="110" DisplayMemberBinding="{Binding ShortTaskId}"/>
                            <GridViewColumn Header="노드" Width="140" DisplayMemberBinding="{Binding NodeName}"/>
                            <GridViewColumn Header="희망 상태" Width="80" DisplayMemberBinding="{Binding DesiredState}"/>
                            <GridViewColumn Header="현재 상태" Width="90">
                            <GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding CurrentState}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                            </DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                            <GridViewColumn Header="분류" Width="125">
                            <GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                            </DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                            <GridViewColumn Header="종료 코드" Width="55" DisplayMemberBinding="{Binding ExitCode}"/>
                            <GridViewColumn Header="컨테이너" Width="110" DisplayMemberBinding="{Binding ShortContainerId}"/>
                            <GridViewColumn Header="메시지 / 오류" Width="280">
                            <GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding Error}" ToolTip="{Binding DiagnosticText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource DialogDangerBrush}"/>
                            </DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource DialogBodyCardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="선택한 Task 진단" FontWeight="Bold" Foreground="{StaticResource DialogTextBrush}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TaskDetailTextBox" Grid.Row="1" Style="{StaticResource DialogCodeTextBoxStyle}" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"
                             Background="{StaticResource DialogSubtleSurfaceBrush}" BorderThickness="0" Padding="8"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="진단 내용 복사" Width="112" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" Click="CopyDiagnosisButton_Click"/>
                <Button x:Name="TaskLogsButton" Content="Task 컨테이너 로그" Width="142" MinHeight="38"
                                IsEnabled="False" Click="TaskLogsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Background="{StaticResource DialogCodeBackgroundBrush}" BorderBrush="{StaticResource DialogTextBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="LogsHeaderTextBlock" Text="로그" FontWeight="Bold" Foreground="{StaticResource DialogCodeTextBrush}" Margin="0,0,0,8"/>
                    <TextBox x:Name="LogsTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             Background="{StaticResource DialogCodeBackgroundBrush}" Foreground="{StaticResource DialogCodeTextBrush}" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock" Foreground="{StaticResource DialogMutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="닫기" Width="92" MinHeight="38" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
