<Window x:Class="DockerDiagram.Views.SwarmNodeManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm 노드 관리" Height="570" Width="720"
        MinHeight="550" MinWidth="660" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogStrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DialogComboBoxStyle}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
        </Style>
        <Style TargetType="Border" x:Key="StatusBadge" BasedOn="{StaticResource DialogStatusBadgeStyle}">
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StatusBadgeText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionButton" BasedOn="{StaticResource DialogButtonBaseStyle}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogStrongBorderBrush}"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource DialogDangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DialogBorderBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DialogDisabledTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="CompactButton" BasedOn="{StaticResource DialogButtonBaseStyle}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogStrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <TextBlock Text="Swarm 노드 관리" Style="{StaticResource DialogTitleStyle}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Border x:Name="StatusBadgeBorder" Style="{StaticResource StatusBadge}"
                        Background="{StaticResource DialogSuccessSurfaceBrush}" BorderBrush="{StaticResource DialogSuccessBorderBrush}">
                    <TextBlock x:Name="StatusBadgeTextBlock" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource DialogSuccessTextBrush}"/>
                </Border>
                <Border Style="{StaticResource StatusBadge}" Background="{StaticResource DialogInfoSurfaceBrush}" BorderBrush="{StaticResource DialogInfoBorderBrush}">
                    <TextBlock x:Name="RoleBadgeTextBlock" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource DialogInfoTextBrush}"/>
                </Border>
                <Border x:Name="ManagerStatusBadge" Style="{StaticResource StatusBadge}"
                        Background="{StaticResource DialogSwarmSurfaceBrush}" BorderBrush="{StaticResource DialogSwarmBorderBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="ManagerStatusBadgeTextBlock" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource DialogSwarmBrush}"/>
                </Border>
                <TextBlock x:Name="RevisionTextBlock" VerticalAlignment="Center" Foreground="{StaticResource DialogMutedTextBrush}" FontSize="11"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogBodyCardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                <TextBlock Text="호스트 이름" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="HostnameTextBlock" Margin="0,7,0,0" FontSize="16" Foreground="{StaticResource DialogTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <TextBlock Text="노드 ID" Style="{StaticResource FieldLabel}"/>
                        <Border Margin="0,6,0,0" Padding="9,4" Background="{StaticResource DialogSubtleSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NodeIdTextBlock" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DialogTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="CopyNodeIdButton" Grid.Column="1" Content="복사"
                                        Margin="8,0,0,0" Style="{StaticResource CompactButton}"
                                        Click="CopyNodeIdButton_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                <TextBlock Text="역할" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="RoleComboBox" Margin="0,6,0,0">
                            <ComboBoxItem Tag="worker" Content="Worker"/>
                            <ComboBoxItem Tag="manager" Content="Manager"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <TextBlock Text="가용성" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="AvailabilityComboBox" Margin="0,6,0,0">
                    <ComboBoxItem Tag="active" Content="Active — Task 수락"/>
                    <ComboBoxItem Tag="pause" Content="Pause — 기존 Task 유지, 새 Task 거부"/>
                    <ComboBoxItem Tag="drain" Content="Drain — Service Task 재배치"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                <TextBlock Text="노드 레이블" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1" Text="한 줄에 key=value 하나 · 예시: zone=seoul"
                                   Foreground="{StaticResource DialogMutedTextBrush}" FontSize="11"/>
                    </Grid>
                    <TextBox x:Name="LabelsTextBox" Grid.Row="1" Height="104" Margin="0,8,0,0"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                             SpellCheck.IsEnabled="False"/>
                </Grid>

                <Border x:Name="SafetyNoticeBorder" Grid.Row="3" Margin="0,16,0,0"
                        Style="{StaticResource DialogWarningPanelStyle}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource DialogWarningBrush}" VerticalAlignment="Top">
                            <TextBlock Text="!" Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="운영 영향" FontWeight="SemiBold" Foreground="{StaticResource DialogWarningTextBrush}"/>
                            <TextBlock x:Name="SafetyNoticeTextBlock" Margin="0,3,0,0"
                                       Foreground="{StaticResource DialogWarningTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RemoveNodeButton" Content="노드 제거"
                    Style="{StaticResource DangerButton}" Click="RemoveButton_Click"/>
            <Border x:Name="ValidationBorder" Grid.Column="1" Margin="14,0"
                    Background="{StaticResource DialogErrorSurfaceBrush}" BorderBrush="{StaticResource DialogErrorBorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10,6" Visibility="Collapsed">
                <TextBlock x:Name="ValidationTextBlock" Foreground="{StaticResource DialogDangerBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"/>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="취소" Margin="0,0,8,0" IsCancel="True"
                        Style="{StaticResource SecondaryButton}"/>
            <Button Content="변경 적용" MinWidth="124" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
