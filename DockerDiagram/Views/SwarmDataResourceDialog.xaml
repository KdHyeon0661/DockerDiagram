<Window x:Class="DockerDiagram.Views.SwarmDataResourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm 리소스 생성" Height="560" Width="620"
        MinHeight="480" MinWidth="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}" ShowInTaskbar="False">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTextBlock" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock x:Name="DescriptionTextBlock" Style="{StaticResource DialogHintStyle}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogBodyCardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="90"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <TextBlock Text="이름 *" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBox x:Name="NameTextBox" Grid.Row="1" Padding="8,6" Margin="0,5,0,14" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>

        <TextBlock Grid.Row="2" Text="내용 *" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBox x:Name="DataTextBox" Grid.Row="3" Style="{StaticResource DialogCodeTextBoxStyle}" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Padding="8" Margin="0,5,0,14" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>

        <TextBlock Grid.Row="4" Text="레이블 (한 줄에 key=value 하나)" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBox x:Name="LabelsTextBox" Grid.Row="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Padding="8" Margin="0,5,0,8" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>
                <TextBlock Grid.Row="6" Text="내용은 Docker Engine으로만 전송되며 다이어그램 파일에는 저장하지 않습니다."
                           Foreground="{StaticResource DialogWarningBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationTextBlock" Foreground="{StaticResource DialogDangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="취소" Width="92" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True"/>
        <Button x:Name="CreateButton" Content="생성" Width="110" MinHeight="38" IsDefault="True"
                        Click="CreateButton_Click" Style="{StaticResource DialogSwarmButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
