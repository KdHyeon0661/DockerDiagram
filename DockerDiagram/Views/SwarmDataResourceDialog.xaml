<Window x:Class="DockerDiagram.Views.SwarmDataResourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Swarm Resource" Height="560" Width="620"
        MinHeight="480" MinWidth="540" WindowStartupLocation="CenterOwner"
        Background="#F6F7FB" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTextBlock" FontSize="24" FontWeight="Bold" Foreground="#17213A"/>
            <TextBlock x:Name="DescriptionTextBlock" Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DAE2" BorderThickness="1" CornerRadius="4" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="90"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name *" FontWeight="SemiBold" Foreground="#2B3140"/>
                <TextBox x:Name="NameTextBox" Grid.Row="1" Padding="8,6" Margin="0,5,0,14" BorderBrush="#C7CBD6"/>

                <TextBlock Grid.Row="2" Text="Content *" FontWeight="SemiBold" Foreground="#2B3140"/>
                <TextBox x:Name="DataTextBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Padding="8" Margin="0,5,0,14" BorderBrush="#C7CBD6"/>

                <TextBlock Grid.Row="4" Text="Labels (one key=value per line)" FontWeight="SemiBold" Foreground="#2B3140"/>
                <TextBox x:Name="LabelsTextBox" Grid.Row="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Padding="8" Margin="0,5,0,8" BorderBrush="#C7CBD6"/>
                <TextBlock Grid.Row="6" Text="내용은 Docker Engine으로만 전송되며 다이어그램 파일에는 저장하지 않습니다."
                           Foreground="#B54708" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationTextBlock" Foreground="#C62828" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Width="92" Height="34" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="CreateButton" Content="Create" Width="110" Height="34" IsDefault="True"
                        Click="CreateButton_Click" Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
