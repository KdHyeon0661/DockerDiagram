<Window x:Class="DockerDiagram.Views.ContainerExecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="명령 실행"
        Width="780"
        Height="560"
        MinWidth="560"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeaderPanelStyle}">
            <StackPanel>
                <TextBlock x:Name="ContainerTitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBlock x:Name="ContainerIdText" FontSize="12" Foreground="{StaticResource DialogMutedTextBrush}" FontFamily="Consolas" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14,14,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox"
                     MinHeight="38"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     FontFamily="Consolas"
                     BorderBrush="{StaticResource DialogStrongBorderBrush}"/>
            <Button x:Name="RunButton"
                    Grid.Column="1"
                        Content="실행"
                    Click="RunButton_Click"
                    Width="86"
                    MinHeight="38"
                    Margin="8,0,0,0"
                    Style="{StaticResource DialogPrimaryButtonStyle}"/>
        </Grid>

        <Border Grid.Row="2" Margin="14,0,14,8" Style="{StaticResource DialogBodyCardStyle}" Padding="0">
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="12"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Style="{StaticResource DialogCodeTextBoxStyle}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DialogFooterPanelStyle}" Padding="12">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource DialogMutedTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="복사" Click="CopyButton_Click" Width="72" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}"/>
            <Button Content="지우기" Click="ClearButton_Click" Width="72" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}"/>
            <Button Content="닫기" Click="CloseButton_Click" Width="72" MinHeight="38" Style="{StaticResource DialogSecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
