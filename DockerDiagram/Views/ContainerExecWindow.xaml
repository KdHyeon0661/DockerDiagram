<Window x:Class="DockerDiagram.Views.ContainerExecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exec Command"
        Width="780"
        Height="560"
        MinWidth="560"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="ContainerTitleText" FontSize="18" FontWeight="SemiBold" Foreground="#222"/>
                <TextBlock x:Name="ContainerIdText" FontSize="12" Foreground="#777" FontFamily="Consolas" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14,14,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     FontFamily="Consolas"
                     BorderBrush="#C8CDD3"/>
            <Button x:Name="RunButton"
                    Grid.Column="1"
                    Content="Run"
                    Click="RunButton_Click"
                    Width="86"
                    Height="32"
                    Margin="8,0,0,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"/>
        </Grid>

        <Border Grid.Row="2" Margin="14,0,14,8" Background="White" BorderBrush="#D8DDE3" BorderThickness="1">
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="12"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="White"/>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy" Click="CopyButton_Click" Width="72" Height="30" Margin="0,0,8,0"/>
                    <Button Content="Clear" Click="ClearButton_Click" Width="72" Height="30" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click" Width="72" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
