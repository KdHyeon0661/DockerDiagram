<Window x:Class="DockerDiagram.Views.ImagePushWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Push Image"
        Width="480"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Push Image" FontSize="18" FontWeight="SemiBold" Foreground="#222"/>
            <TextBlock Text="Push a tagged image to a registry." FontSize="12" Foreground="#777" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Repository" VerticalAlignment="Center" Foreground="#555"/>
            <TextBox x:Name="RepositoryBox" Grid.Column="1" Height="30" Padding="6" VerticalContentAlignment="Center" BorderBrush="#C8CDD3"/>

            <TextBlock Grid.Row="1" Text="Tag" VerticalAlignment="Center" Foreground="#555" Margin="0,10,0,0"/>
            <TextBox x:Name="ImageTagBox" Grid.Row="1" Grid.Column="1" Height="30" Padding="6" VerticalContentAlignment="Center" BorderBrush="#C8CDD3" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="2" Text="Registry server" VerticalAlignment="Center" Foreground="#555" Margin="0,10,0,0"/>
            <TextBox x:Name="ServerBox" Grid.Row="2" Grid.Column="1" Height="30" Padding="6" VerticalContentAlignment="Center" BorderBrush="#C8CDD3" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="3" Text="Username" VerticalAlignment="Center" Foreground="#555" Margin="0,10,0,0"/>
            <TextBox x:Name="UsernameBox" Grid.Row="3" Grid.Column="1" Height="30" Padding="6" VerticalContentAlignment="Center" BorderBrush="#C8CDD3" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center" Foreground="#555" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Height="30" Padding="6" BorderBrush="#C8CDD3" Margin="0,10,0,0"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Push" Click="PushButton_Click" Width="76" Height="30" Margin="0,0,8,0" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Click="CancelButton_Click" Width="76" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
