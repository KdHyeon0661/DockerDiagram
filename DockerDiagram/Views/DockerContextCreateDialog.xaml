<Window x:Class="DockerDiagram.Views.DockerContextCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Docker Context 생성"
        Width="460"
        Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource DialogWindowBackgroundBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Docker Context 생성" Style="{StaticResource DialogTitleStyle}"/>
        <TextBlock Grid.Row="1" Text="Docker CLI context를 생성합니다." Style="{StaticResource DialogHintStyle}" Margin="0,3,0,16"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="이름" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Grid.Column="1" MinHeight="38" Padding="6" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Docker 호스트" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBox x:Name="EndpointBox" Grid.Row="1" Grid.Column="1" MinHeight="38" Padding="6" Margin="0,10,0,0" VerticalContentAlignment="Center"
                     Text="npipe:////./pipe/docker_engine"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="예: npipe:////./pipe/docker_engine, unix:///var/run/docker.sock, tcp://host:2375, ssh://user@host"
                   FontSize="11" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap" Margin="110,8,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="생성" Width="88" Margin="0,0,8,0" Style="{StaticResource DialogPrimaryButtonStyle}" Click="CreateButton_Click"/>
            <Button Content="취소" Width="82" Style="{StaticResource DialogSecondaryButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
