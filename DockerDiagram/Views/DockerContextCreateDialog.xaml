<Window x:Class="DockerDiagram.Views.DockerContextCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Docker Context"
        Width="460"
        Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F7F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create Docker Context" FontSize="18" FontWeight="SemiBold" Foreground="#222"/>
        <TextBlock Grid.Row="1" Text="Docker CLI context를 생성합니다." FontSize="12" Foreground="#777" Margin="0,3,0,16"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Name" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Height="30" Padding="6" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Docker Host" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBox x:Name="EndpointBox" Grid.Row="1" Grid.Column="1" Height="30" Padding="6" Margin="0,10,0,0" VerticalContentAlignment="Center"
                     Text="npipe:////./pipe/docker_engine"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="예: npipe:////./pipe/docker_engine, unix:///var/run/docker.sock, tcp://host:2375, ssh://user@host"
                   FontSize="11" Foreground="#777" TextWrapping="Wrap" Margin="110,8,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create" Width="82" Height="30" Margin="0,0,8,0" Background="#007ACC" Foreground="White" BorderThickness="0" Click="CreateButton_Click"/>
            <Button Content="Cancel" Width="82" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
