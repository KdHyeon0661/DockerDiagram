<Window x:Class="DockerDiagram.Views.ContainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Container Configuration" Height="650" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabControl" Grid.Row="0" Margin="0,0,0,15" Background="White" BorderBrush="#DDD">

            <TabItem Header="🎛️ 직접 설정 (UI)">
                <Grid Margin="10">
                    <TabControl Background="#FAFAFA" BorderBrush="#EEE">

                        <TabItem Header="General">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15">
                                    <TextBlock Text="Container Name" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                    <TextBox x:Name="txtName" Padding="5" Margin="0,0,0,15" BorderBrush="#CCC"/>

                                    <TextBlock Text="Image Name" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtImage" Padding="5" BorderBrush="#CCC"
                                                 TextChanged="ImageName_TextChanged"/>
                                        <Button x:Name="btnInspectImage"
                                                Grid.Column="1"
                                                Content="↻"
                                                Width="34"
                                                Margin="6,0,0,0"
                                                FontSize="17"
                                                ToolTip="이미지 설정 조회"
                                                Click="InspectImage_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="txtImageLookupStatus"
                                               Text="이미지를 입력하면 포트와 볼륨 설정을 조회합니다."
                                               FontSize="10"
                                               Foreground="#78828C"
                                               Margin="1,0,0,15"
                                               TextWrapping="Wrap"/>

                                    <CheckBox x:Name="chkInteractive" Content="터미널 유지 (Keep STDIN open / TTY)" 
                                              FontWeight="Bold" Foreground="#333" Margin="0,5,0,0" ToolTip="컨테이너가 즉시 종료되는 것을 방지합니다 (-it)"/>

                                    <Expander Header="🔒 Private Registry (비공개 저장소 인증)" Margin="0,15,0,0" Background="#FDFDFD" BorderBrush="#DDD" BorderThickness="1">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="Registry URL (비워두면 기본 Docker Hub 사용)" Foreground="#555" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox x:Name="txtRegServer" Padding="5" Margin="0,0,0,10" BorderBrush="#CCC" ToolTip="예: https://ghcr.io 또는 https://12345.dkr.ecr.aws.com"/>

                                            <TextBlock Text="Username (아이디)" Foreground="#555" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBox x:Name="txtRegUser" Padding="5" Margin="0,0,0,10" BorderBrush="#CCC"/>

                                            <TextBlock Text="Password / Token (비밀번호/토큰)" Foreground="#555" FontSize="11" Margin="0,0,0,2"/>
                                            <PasswordBox x:Name="txtRegPass" Padding="5" Margin="0,0,0,5" BorderBrush="#CCC"/>
                                        </StackPanel>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="tabImageSetup" Header="Initial Setup">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="profileHeader"
                                        Background="#EEF5FA"
                                        BorderBrush="#BDD3E3"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="txtProfileCategory"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#5A7388"/>
                                        <TextBlock x:Name="txtProfileName"
                                                   Margin="0,2,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#244A66"/>
                                        <TextBlock x:Name="txtProfileDescription"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="#526675"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtProfileNotes"
                                                   Margin="0,5,0,0"
                                                   FontSize="10"
                                                   Foreground="#6D7883"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <StackPanel x:Name="pnlNoImageProfile"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                MaxWidth="380">
                                        <TextBlock Text="지원되는 서버 이미지를 입력하면 초기 설정 항목이 표시됩니다."
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="#5F6872"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="알 수 없는 이미지는 Env Vars 탭에서 직접 설정할 수 있습니다."
                                                   Margin="0,6,0,0"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="#8A929B"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <ScrollViewer x:Name="profileFormScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Visibility="Collapsed">
                                        <StackPanel x:Name="pnlProfileFields"/>
                                    </ScrollViewer>
                                </Grid>

                                <StackPanel x:Name="pnlProfileOptions"
                                            Grid.Row="2"
                                            Margin="0,10,0,0"
                                            Visibility="Collapsed">
                                    <CheckBox x:Name="chkApplyProfilePorts"
                                              Content="권장 포트 매핑 추가"
                                              IsChecked="True"
                                              Margin="0,0,0,6"/>
                                    <CheckBox x:Name="chkApplyProfileVolumes"
                                              Content="영속 데이터 볼륨 추가"
                                              IsChecked="True"/>
                                    <TextBlock x:Name="txtProfileCommandHint"
                                               Margin="0,7,0,0"
                                               FontSize="10"
                                               Foreground="#777"
                                               TextWrapping="Wrap"/>
                                    <Border x:Name="metadataSummaryBorder"
                                            Margin="0,10,0,0"
                                            Padding="9"
                                            Background="#F5F7F9"
                                            BorderBrush="#D9DEE3"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Detected image metadata"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3E4852"/>
                                            <TextBlock x:Name="txtMetadataSummary"
                                                       Margin="0,4,0,0"
                                                       FontSize="10"
                                                       Foreground="#68737E"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="btnApplyImageSuggestions"
                                            Content="Apply Suggestions"
                                            Margin="0,10,0,0"
                                            Height="32"
                                            HorizontalAlignment="Left"
                                            Padding="14,0"
                                            IsEnabled="False"
                                            Click="ApplyImageSuggestions_Click"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Ports">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Port Mappings (Host:Container)" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtPorts" Grid.Row="1" AcceptsReturn="True" 
                                         Padding="5" FontFamily="Consolas" BorderBrush="#CCC"
                                         ToolTip="Example:&#x0a;8080:80&#x0a;3306:3306"/>
                                <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                                           Text="One mapping per line" FontSize="10" Foreground="Gray" Margin="5"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Env Vars">
                            <Grid Margin="15" AllowDrop="True" Drop="Env_Drop" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Environment Variables (KEY=VALUE)" FontWeight="Bold" Margin="0,0,0,5"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="btnLoadEnv" 
                                            Content="📁 .env 파일 불러오기" 
                                            Padding="10,5" 
                                            Click="BtnLoadEnv_Click" 
                                            Background="#E0E0E0" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock Text="(또는 이 화면에 파일을 드래그하세요)" 
                                               Foreground="Gray" 
                                               VerticalAlignment="Center" 
                                               Margin="10,0,0,0"/>
                                </StackPanel>

                                <TextBox x:Name="txtEnv" Grid.Row="2" AcceptsReturn="True" Padding="5" FontFamily="Consolas" BorderBrush="#CCC" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Command">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Command / Entrypoint Override" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                <TextBlock Grid.Row="1" Text="이미지의 기본 실행 명령을 무시하고 강제로 실행할 명령어를 입력합니다." FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

                                <TextBox x:Name="txtCommand" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="5" FontFamily="Consolas" BorderBrush="#CCC" ToolTip="예: python app.py 또는 tail -f /dev/null"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Network">
                            <StackPanel Margin="15">
                                <TextBlock Text="Initial Network" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                <TextBlock Text="컨테이너가 처음 생성될 때 연결될 네트워크를 선택합니다." FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cmbNetwork" Padding="5" Margin="0,0,0,15" IsEditable="True" Text="bridge">
                                    <ComboBoxItem Content="bridge"/>
                                    <ComboBoxItem Content="host"/>
                                    <ComboBoxItem Content="none"/>
                                </ComboBox>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Resources">
                            <StackPanel Margin="15">
                                <TextBlock Text="Restart Policy" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbRestart" Margin="0,0,0,15" Padding="5">
                                    <ComboBoxItem Content="no" IsSelected="True"/>
                                    <ComboBoxItem Content="always"/>
                                    <ComboBoxItem Content="on-failure"/>
                                    <ComboBoxItem Content="unless-stopped"/>
                                </ComboBox>

                                <TextBlock Text="Memory Limit (MB)" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtMem" Padding="5" Margin="0,0,0,5" Text="0" PreviewTextInput="NumberValidationTextBox"/>
                                <TextBlock Text="0 = No limit" FontSize="10" Foreground="Gray" Margin="0,0,0,15"/>

                                <TextBlock Text="CPU Count" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCpu" Padding="5" Margin="0,0,0,5" Text="0" PreviewTextInput="NumberValidationTextBox"/>
                                <TextBlock Text="0 = No limit (e.g. 0.5 for half core)" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Volumes">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host Path / Vol Name" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Container Path" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>

                                    <TextBox x:Name="txtVolSource" Grid.Row="1" Grid.Column="0" Padding="5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"/>
                                    <TextBox x:Name="txtVolTarget" Grid.Row="1" Grid.Column="2" Padding="5"/>
                                    <Button Grid.Row="1" Grid.Column="3" Content="Add" Click="BtnAddVolume_Click" Width="50" Margin="10,0,0,0" Background="#E0E0E0" BorderBrush="#CCC"/>
                                </Grid>
                                <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="2">
                                    <ListBox x:Name="lstVolumes" BorderThickness="0" Background="#FAFAFA">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="5"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                                                    <Button Grid.Column="1" Content="✕" Foreground="Red" Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnRemoveVolume_Click" Tag="{Binding}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="💻 명령어로 생성 (CLI)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="인터넷에서 찾은 docker run ... 명령어를 아래에 붙여넣으세요.&#x0a;프로그램이 자동으로 분석하여 다이어그램에 생성합니다." 
                               Foreground="#555" Margin="0,0,0,15" TextWrapping="Wrap" LineHeight="18" FontWeight="SemiBold"/>

                    <TextBox x:Name="txtCliCommand" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             Padding="10" FontFamily="Consolas" FontSize="14" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#CCC"
                             ToolTip="docker run -d -p 80:80 --name my-nginx nginx"/>
                </Grid>
            </TabItem>

            <TabItem Header="🛠️ 도커파일 (Build)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="생성될 이미지 이름 (Tag)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                    <TextBlock Grid.Row="1" Text="도커파일을 빌드해서 만들어질 새로운 이미지의 이름을 지정합니다. (예: my-app:1.0)" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>

                    <TextBox x:Name="txtBuildImageTag" Grid.Row="2" Padding="5" Margin="0,0,0,15" BorderBrush="#CCC"/>

                    <TextBlock Grid.Row="3" Text="Dockerfile 내용 직접 작성 또는 불러오기" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="txtDockerfile" AcceptsReturn="True" TextWrapping="Wrap"
                                 Padding="10" FontFamily="Consolas" Background="#F8F9FA" BorderBrush="#CCC"
                                 VerticalScrollBarVisibility="Auto"/>
                        <Button x:Name="btnBrowseDockerfile" Content="📂 Dockerfile 찾아보기..." Grid.Row="1" Margin="0,10,0,0" Padding="8" Background="#E0E0E0" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnBrowseDockerfile_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOk" Content="Create / Run" IsDefault="True" Click="BtnOk_Click" 
                    Width="120" Height="35" Background="#007ACC" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>

            <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" 
                    Width="100" Height="35" Background="#E0E0E0" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
