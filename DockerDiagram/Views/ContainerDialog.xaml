<Window x:Class="DockerDiagram.Views.ContainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Container Configuration" Height="450" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,15" Background="White" BorderBrush="#DDD">

            <TabItem Header="General">
                <StackPanel Margin="15">
                    <TextBlock Text="Container Name" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                    <TextBox x:Name="txtName" Padding="5" Margin="0,0,0,15" BorderBrush="#CCC"/>

                    <TextBlock Text="Image Name" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                    <TextBox x:Name="txtImage" Padding="5" Margin="0,0,0,5" BorderBrush="#CCC"/>
                    <TextBlock Text="e.g. nginx:latest, mysql:5.7" FontSize="10" Foreground="Gray"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Ports">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Port Mappings (Host:Container)" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPorts" Grid.Row="1" AcceptsReturn="True" 
                             Padding="5" FontFamily="Consolas" BorderBrush="#CCC"
                             ToolTip="Example:&#x0a;8080:80&#x0a;3306:3306"/>
                    <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                               Text="One mapping per line" FontSize="10" Foreground="Gray" Margin="5"/>
                </Grid>
            </TabItem>

            <TabItem Header="Env Vars">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Environment Variables (KEY=VALUE)" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEnv" Grid.Row="1" AcceptsReturn="True" 
                             Padding="5" FontFamily="Consolas" BorderBrush="#CCC"
                             ToolTip="Example:&#x0a;MYSQL_ROOT_PASSWORD=1234&#x0a;APP_ENV=production"/>
                    <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                               Text="One variable per line" FontSize="10" Foreground="Gray" Margin="5"/>
                </Grid>
            </TabItem>

            <TabItem Header="Resources">
                <StackPanel Margin="15">
                    <TextBlock Text="Restart Policy" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbRestart" Margin="0,0,0,15" Padding="5">
                        <ComboBoxItem Content="no" IsSelected="True"/>
                        <ComboBoxItem Content="always"/>
                        <ComboBoxItem Content="on-failure"/>
                        <ComboBoxItem Content="unless-stopped"/>
                    </ComboBox>

                    <TextBlock Text="Memory Limit (MB)" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMem" Padding="5" Margin="0,0,0,5" Text="0" PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="0 = No limit" FontSize="10" Foreground="Gray" Margin="0,0,0,15"/>

                    <TextBlock Text="CPU Count" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtCpu" Padding="5" Margin="0,0,0,5" Text="0" PreviewTextInput="NumberValidationTextBox"/>
                    <TextBlock Text="0 = No limit (e.g. 0.5 for half core)" FontSize="10" Foreground="Gray"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Volumes">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host Path / Volume Name" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Container Path" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>

                        <TextBox x:Name="txtVolSource" Grid.Row="1" Grid.Column="0" Padding="5" ToolTip="e.g. C:/data or my-vol"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"/>
                        <TextBox x:Name="txtVolTarget" Grid.Row="1" Grid.Column="2" Padding="5" ToolTip="e.g. /app/data"/>

                        <Button Grid.Row="1" Grid.Column="3" Content="Add" Click="BtnAddVolume_Click" Width="60" Margin="10,0,0,0" Background="#E0E0E0" BorderBrush="#CCC"/>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="2">
                        <ListBox x:Name="lstVolumes" BorderThickness="0" Background="#FAFAFA">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding}" 
                                                   VerticalAlignment="Center" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#333"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding}"/>

                                        <Button Grid.Column="1" Content="✕" 
                                                Foreground="Red" Background="Transparent" BorderThickness="0" 
                                                FontWeight="Bold" Cursor="Hand"
                                                Click="BtnRemoveVolume_Click" Tag="{Binding}" 
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                               Text="* Format: [Host]:[Container]" 
                               FontSize="9" Foreground="Gray" Margin="0,0,5,5" IsHitTestVisible="False"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOk" Content="Create" IsDefault="True" Click="BtnOk_Click" 
                    Width="100" Height="35" Background="#007ACC" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>

            <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" 
                    Width="100" Height="35" Background="#E0E0E0" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>