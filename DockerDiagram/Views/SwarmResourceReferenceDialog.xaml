<Window x:Class="DockerDiagram.Views.SwarmResourceReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm 리소스 연결" Height="510" Width="590"
        MinHeight="480" MinWidth="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}" ShowInTaskbar="False">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTextBlock" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock x:Name="DescriptionTextBlock" Style="{StaticResource DialogHintStyle}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogBodyCardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <TextBlock Text="대상 파일 이름 또는 절대 경로 *" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBox x:Name="TargetTextBox" Grid.Row="1" Padding="8,6" Margin="0,5,0,14" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="UID *" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="GID *" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,5,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBox x:Name="UidTextBox" Padding="8,6" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>
                    <TextBox x:Name="GidTextBox" Grid.Column="2" Padding="8,6" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>
                </Grid>

        <TextBlock Grid.Row="4" Text="모드 (8진수) *" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBox x:Name="ModeTextBox" Grid.Row="5" Padding="8,6" Margin="0,5,0,14" BorderBrush="{StaticResource DialogStrongBorderBrush}"/>

                <Border Grid.Row="6" Style="{StaticResource DialogInfoPanelStyle}" Background="{StaticResource DialogSubtleSurfaceBrush}" Padding="10">
                    <TextBlock x:Name="HelpTextBlock" Foreground="{StaticResource DialogMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationTextBlock" Foreground="{StaticResource DialogDangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="취소" Width="92" MinHeight="38" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True"/>
        <Button Content="연결" Width="110" MinHeight="38" IsDefault="True"
                        Click="AttachButton_Click" Style="{StaticResource DialogSwarmButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
