<Window x:Class="DockerDiagram.Views.SwarmResourceReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attach Swarm Resource" Height="510" Width="590"
        MinHeight="480" MinWidth="540" WindowStartupLocation="CenterOwner"
        Background="#F6F7FB" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTextBlock" FontSize="24" FontWeight="Bold" Foreground="#17213A"/>
            <TextBlock x:Name="DescriptionTextBlock" Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DAE2" BorderThickness="1" CornerRadius="4" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Target file name or absolute path *" FontWeight="SemiBold" Foreground="#2B3140"/>
                <TextBox x:Name="TargetTextBox" Grid.Row="1" Padding="8,6" Margin="0,5,0,14" BorderBrush="#C7CBD6"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="UID *" FontWeight="SemiBold" Foreground="#2B3140"/>
                    <TextBlock Grid.Column="2" Text="GID *" FontWeight="SemiBold" Foreground="#2B3140"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,5,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBox x:Name="UidTextBox" Padding="8,6" BorderBrush="#C7CBD6"/>
                    <TextBox x:Name="GidTextBox" Grid.Column="2" Padding="8,6" BorderBrush="#C7CBD6"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="Mode (octal) *" FontWeight="SemiBold" Foreground="#2B3140"/>
                <TextBox x:Name="ModeTextBox" Grid.Row="5" Padding="8,6" Margin="0,5,0,14" BorderBrush="#C7CBD6"/>

                <Border Grid.Row="6" Background="#F2F4F7" Padding="10" CornerRadius="3">
                    <TextBlock x:Name="HelpTextBlock" Foreground="#475467" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationTextBlock" Foreground="#C62828" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Width="92" Height="34" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Attach" Width="110" Height="34" IsDefault="True"
                        Click="AttachButton_Click" Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
