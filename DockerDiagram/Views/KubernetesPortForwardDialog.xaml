<Window x:Class="DockerDiagram.Views.KubernetesPortForwardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Kubernetes 포트 전달" Width="420" Height="285"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20" Background="{StaticResource DialogSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DialogInfoPanelStyle}" BorderBrush="{StaticResource DialogKubernetesBrush}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource DialogPortIcon}" Fill="{StaticResource DialogKubernetesBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock x:Name="TargetTextBlock" FontWeight="SemiBold" Foreground="{StaticResource DialogKubernetesBrush}" TextWrapping="Wrap"/></StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
                <TextBlock Text="로컬 포트" VerticalAlignment="Center"/>
            <TextBox x:Name="LocalPortTextBox" Grid.Column="1" MinHeight="38" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
                <TextBlock Text="원격 포트" VerticalAlignment="Center"/>
            <TextBox x:Name="RemotePortTextBox" Grid.Column="1" MinHeight="38" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="{StaticResource DialogDangerBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="열기" IsDefault="True" Click="Open_Click" Width="84" Margin="0,0,8,0" Style="{StaticResource DialogKubernetesButtonStyle}"/>
            <Button Content="취소" IsCancel="True" Width="84" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
