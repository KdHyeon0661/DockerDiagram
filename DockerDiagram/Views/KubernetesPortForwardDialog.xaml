<Window x:Class="DockerDiagram.Views.KubernetesPortForwardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kubernetes Port Forward" Width="420" Height="245"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetTextBlock" FontWeight="SemiBold" Foreground="#343A43" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Local Port" VerticalAlignment="Center"/>
            <TextBox x:Name="LocalPortTextBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Remote Port" VerticalAlignment="Center"/>
            <TextBox x:Name="RemotePortTextBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="#D32F2F" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open" IsDefault="True" Click="Open_Click" Width="84" Height="30" Margin="0,0,8,0" Background="#326CE5" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" IsCancel="True" Width="84" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
