<Window x:Class="DockerDiagram.Views.NetworkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="네트워크 생성"
        SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="네트워크 이름:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="txtName" Padding="5" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="2" Text="드라이버:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" x:Name="cmbDriver" Padding="5" SelectedIndex="0" Margin="0,0,0,15" SelectionChanged="Driver_SelectionChanged">
            <ComboBoxItem Content="bridge"/>
            <ComboBoxItem x:Name="overlayDriverItem" Content="overlay" Visibility="Collapsed"/>
            <ComboBoxItem Content="host"/>
            <ComboBoxItem Content="none"/>
            <ComboBoxItem Content="macvlan"/>
            <ComboBoxItem Content="ipvlan"/>
        </ComboBox>

        <Expander Grid.Row="4" Header="고급 옵션" Background="{StaticResource DialogSurfaceBrush}" Foreground="{StaticResource DialogNetworkBrush}" FontWeight="SemiBold" Margin="0,0,0,10">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="서브넷" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSubnet" Padding="5" Margin="0,0,0,8" ToolTip="CIDR, 예: 172.28.0.0/16"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="게이트웨이" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtGateway" Padding="5" Margin="0,0,0,8" ToolTip="예: 172.28.0.1"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="IP 범위" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtIpRange" Padding="5" Margin="0,0,0,8" ToolTip="서브넷 내부의 CIDR 범위"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Compose 이름" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtComposeName" Padding="5" Margin="0,0,0,8" ToolTip="선택 사항: 실제 Docker/Compose 네트워크 이름"/>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,12">
                    <CheckBox x:Name="chkExternal" Content="외부 네트워크" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkInternal" Content="내부 전용" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkAttachable" Content="직접 연결 허용" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkEnableIPv6" Content="IPv6"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="보조 주소" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="txtAuxAddresses" Height="62" Padding="6"
                         AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         ToolTip="한 줄에 key=value 하나, 예: host1=172.28.0.5"/>

                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="레이블" FontWeight="Bold" Margin="0,12,0,5"/>
                <TextBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="txtLabels" Height="72" Padding="6"
                         AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         ToolTip="한 줄에 key=value 하나"/>

                <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="드라이버 옵션" FontWeight="Bold" Margin="0,12,0,5"/>
                <TextBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="txtDriverOptions" Height="72" Padding="6"
                         AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         ToolTip="한 줄에 key=value 하나, 예: parent=eth0"/>

                <StackPanel Grid.Row="11" Grid.ColumnSpan="2" x:Name="spDriverSpecificOptions" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="macvlan / ipvlan 옵션" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="상위 인터페이스" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="txtParentInterface" Padding="5" ToolTip="호스트 인터페이스, 예: eth0"/>
                    </Grid>
                    <Grid x:Name="gridMacvlanMode" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="macvlan 모드" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbMacvlanMode" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="bridge"/>
                            <ComboBoxItem Content="private"/>
                            <ComboBoxItem Content="vepa"/>
                            <ComboBoxItem Content="passthru"/>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="gridIpvlanMode" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="ipvlan 모드" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbIpvlanMode" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="l2"/>
                            <ComboBoxItem Content="l3"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Grid>
        </Expander>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button x:Name="btnCreate" Content="생성" IsDefault="True" Click="BtnOk_Click" Width="88" Margin="0,0,10,0" Style="{StaticResource DialogNetworkButtonStyle}"/>
        <Button Content="취소" IsCancel="True" Width="80" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
