<Window x:Class="DockerDiagram.Views.NetworkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Network"
        SizeToContent="Height" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Network Name:" FontWeight="Bold" Margin="0,0,0,5"/>
		<TextBox Grid.Row="1" x:Name="txtName" Padding="5" Margin="0,0,0,15"/>

		<TextBlock Grid.Row="2" Text="Driver:" FontWeight="Bold" Margin="0,0,0,5"/>
		<ComboBox Grid.Row="3" x:Name="cmbDriver" Padding="5" SelectedIndex="0" Margin="0,0,0,15">
			<ComboBoxItem Content="bridge"/>
			<ComboBoxItem Content="host"/>
			<ComboBoxItem Content="none"/>
			<ComboBoxItem Content="macvlan"/>
			<ComboBoxItem Content="ipvlan"/>
		</ComboBox>

		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button Content="Create" IsDefault="True" Click="BtnOk_Click" Width="80" Height="30" Margin="0,0,10,0" Background="#9B59B6" Foreground="White"/>
			<Button Content="Cancel" IsCancel="True" Width="80" Height="30"/>
		</StackPanel>
	</Grid>
</Window>