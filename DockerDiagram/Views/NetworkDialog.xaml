<Window x:Class="DockerDiagram.Views.NetworkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Network"
        SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Network Name:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="txtName" Padding="5" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="2" Text="Driver:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" x:Name="cmbDriver" Padding="5" SelectedIndex="0" Margin="0,0,0,15" SelectionChanged="Driver_SelectionChanged">
            <ComboBoxItem Content="bridge"/>
            <ComboBoxItem Content="host"/>
            <ComboBoxItem Content="none"/>
            <ComboBoxItem Content="macvlan"/>
            <ComboBoxItem Content="ipvlan"/>
        </ComboBox>

        <Expander Grid.Row="4" Header="Advanced Options" Margin="0,0,0,10">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subnet" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSubnet" Padding="5" Margin="0,0,0,8" ToolTip="CIDR, e.g. 172.28.0.0/16"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gateway" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtGateway" Padding="5" Margin="0,0,0,8" ToolTip="e.g. 172.28.0.1"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="IP Range" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtIpRange" Padding="5" Margin="0,0,0,8" ToolTip="CIDR range inside subnet"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Compose Name" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtComposeName" Padding="5" Margin="0,0,0,8" ToolTip="Optional actual Docker/Compose network name"/>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,12">
                    <CheckBox x:Name="chkExternal" Content="External" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkInternal" Content="Internal" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkAttachable" Content="Attachable" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkEnableIPv6" Content="IPv6"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Aux Addresses" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="txtAuxAddresses" Height="62" Padding="6"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         ToolTip="One key=value per line, e.g. host1=172.28.0.5"/>

                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Labels" FontWeight="Bold" Margin="0,12,0,5"/>
                <TextBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="txtLabels" Height="72" Padding="6"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         ToolTip="One key=value per line"/>

                <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="Driver Options" FontWeight="Bold" Margin="0,12,0,5"/>
                <TextBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="txtDriverOptions" Height="72" Padding="6"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         ToolTip="One key=value per line, e.g. parent=eth0"/>

                <StackPanel Grid.Row="11" Grid.ColumnSpan="2" x:Name="spDriverSpecificOptions" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="macvlan / ipvlan Options" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Parent" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="txtParentInterface" Padding="5" ToolTip="Host interface, e.g. eth0"/>
                    </Grid>
                    <Grid x:Name="gridMacvlanMode" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="macvlan mode" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbMacvlanMode" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="bridge"/>
                            <ComboBoxItem Content="private"/>
                            <ComboBoxItem Content="vepa"/>
                            <ComboBoxItem Content="passthru"/>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="gridIpvlanMode" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ipvlan mode" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbIpvlanMode" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="l2"/>
                            <ComboBoxItem Content="l3"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Grid>
        </Expander>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Create" IsDefault="True" Click="BtnOk_Click" Width="80" Height="30" Margin="0,0,10,0" Background="#9B59B6" Foreground="White"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
