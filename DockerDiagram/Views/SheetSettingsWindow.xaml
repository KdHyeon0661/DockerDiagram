<Window x:Class="DockerDiagram.Views.SheetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="시트 설정"
        Width="560"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource DialogWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeaderPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="{StaticResource DialogInfoSurfaceBrush}" Margin="0,0,12,0">
                    <Path Data="{StaticResource GearIcon}" Fill="{StaticResource DialogPrimaryBrush}" Width="20" Height="20" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="시트 설정" Style="{StaticResource DialogTitleStyle}"/>
                    <TextBlock Foreground="{StaticResource DialogMutedTextBrush}" Margin="0,3,0,0">
                        <Run Text="현재 시트: "/><Run Text="{Binding SheetManager.ActiveSheet.Title}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18">
                <Border x:Name="HistoryOptionsCard" Style="{StaticResource DialogBodyCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="편집 기록" Style="{StaticResource DialogSectionTitleStyle}"/>
                        <TextBlock Text="실행 취소 기록에 실제 Docker 리소스 작업을 포함할지 설정합니다."
                                   Style="{StaticResource DialogHintStyle}" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding History.IncludeDockerResourceHistory, Mode=TwoWay}"
                                  Margin="0,0,0,9"
                                  ToolTip="컨테이너·볼륨·네트워크 생성과 삭제를 실행 취소/다시 실행 기록에 포함합니다.">
                            <TextBlock Text="Docker 생성·삭제도 실행 취소 기록" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding History.IncludeVolumeBackupForUndo, Mode=TwoWay}"
                                  ToolTip="볼륨 삭제 전에 임시 tar 백업을 만들어 실행 취소할 때 데이터를 복원합니다.">
                            <TextBlock Text="실행 취소 전에 볼륨 백업" TextWrapping="Wrap"/>
                        </CheckBox>
                        <Border Background="{StaticResource DialogWarningSurfaceBrush}"
                                BorderBrush="{StaticResource DialogWarningBorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0">
                            <TextBlock Text="체크 옵션은 즉시 반영됩니다. Docker 작업 기록을 사용하면 실행 취소/다시 실행이 실제 Docker 리소스를 변경할 수 있습니다."
                                       Foreground="{StaticResource DialogWarningTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DialogBodyCardStyle}">
                    <StackPanel>
                        <TextBlock Text="시트 크기" Style="{StaticResource DialogSectionTitleStyle}"/>
                        <TextBlock Text="노드와 그룹을 배치할 수 있는 현재 시트의 전체 영역입니다."
                                   Style="{StaticResource DialogHintStyle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="너비" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox x:Name="SheetWidthTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="높이" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox x:Name="SheetHeightTextBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,9,0,0" Style="{StaticResource DialogHintStyle}">
                            <Run Text="최소 크기: "/><Run Text="500 × 300" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="시트 크기 적용" Click="Apply_Click" IsDefault="True" Width="124" Margin="0,0,10,0" Style="{StaticResource DialogPrimaryButtonStyle}"/>
                <Button Content="닫기" IsCancel="True" Width="80" Style="{StaticResource DialogSecondaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
