<Window x:Class="DockerDiagram.Views.ArrangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange Nodes" Height="200" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Columns (열):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="txtCols" Grid.Row="1" Text="3" Padding="5" Margin="0,0,10,0"/>

        <TextBlock Grid.Column="1" Text="Rows (행):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="txtRows" Grid.Column="1" Grid.Row="1" Text="Auto" IsReadOnly="True"  Padding="5" Background="#F0F0F0" ToolTip="자동 계산됩니다."/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Arrange" IsDefault="True" Click="BtnOk_Click" Width="80" Height="30" Margin="0,0,10,0" Background="#007ACC" Foreground="White"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>