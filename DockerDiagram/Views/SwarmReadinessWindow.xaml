<Window x:Class="DockerDiagram.Views.SwarmReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm 준비 상태" Width="780" Height="610" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource DialogWindowBackgroundBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Swarm 운영 준비 상태" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock Text="Docker 상태를 변경하지 않고 CLI, Manager, quorum, Node와 Service 조회 가능 여부를 점검합니다."
                       Margin="0,4,0,0" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogBodyCardStyle}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                <TextBlock x:Name="CheckedAtText" Grid.Column="1" Foreground="{StaticResource DialogMutedTextBrush}"/>
            </Grid>
        </Border>

        <ListView x:Name="ChecksList" Grid.Row="2" Style="{StaticResource DialogListViewStyle}">
            <ListView.View>
                <GridView>
                                <GridViewColumn Header="상태" Width="86">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                                <GridViewColumn Header="분류" Width="110" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="점검 항목" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="상세 내용" Width="390" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Foreground="{StaticResource DialogMutedTextBrush}"/>
            <Button Grid.Column="1" Content="보고서 복사" MinWidth="96" Margin="0,0,8,0" Style="{StaticResource DialogSecondaryButtonStyle}" Click="Copy_Click"/>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="새로고침" MinWidth="86" Margin="0,0,8,0" Style="{StaticResource DialogSwarmButtonStyle}" Click="Refresh_Click"/>
            <Button Grid.Column="3" Content="닫기" MinWidth="86" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
