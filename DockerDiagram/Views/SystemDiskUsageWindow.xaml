<Window x:Class="DockerDiagram.Views.SystemDiskUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Docker 디스크 사용량"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}"/>
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource DialogDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource DialogWindowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeaderPanelStyle}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                <TextBlock Text="Docker 디스크 사용량" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                    <TextBlock Text="{Binding ProfileName, StringFormat=Current engine: {0}}" FontSize="12" Foreground="{StaticResource DialogMutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="새로고침" Click="RefreshButton_Click" Width="86" MinHeight="38" Style="{StaticResource DialogSecondaryButtonStyle}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DialogBodyCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                        <TextBlock Text="레이어" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedLayersSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource DialogBodyCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                        <TextBlock Text="이미지" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedImagesSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DialogBodyCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                        <TextBlock Text="컨테이너" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedContainersSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource DialogBodyCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                        <TextBlock Text="볼륨" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedVolumesSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource DialogBodyCardStyle}" Padding="12">
                <StackPanel>
                        <TextBlock Text="빌드 캐시" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedBuildCacheSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" Margin="14,0,14,14">
                <TabItem Header="이미지">
                <DataGrid ItemsSource="{Binding Usage.Images}">
                    <DataGrid.Columns>
                                <DataGridTextColumn Header="저장소:태그" Binding="{Binding Repository}" Width="*"/>
                                <DataGridTextColumn Header="이미지 ID" Binding="{Binding ShortId}" Width="110"/>
                                <DataGridTextColumn Header="컨테이너" Binding="{Binding Containers}" Width="90"/>
                                <DataGridTextColumn Header="크기" Binding="{Binding FormattedSize}" Width="110"/>
                                <DataGridTextColumn Header="공유" Binding="{Binding FormattedSharedSize}" Width="110"/>
                                <DataGridTextColumn Header="생성 시각" Binding="{Binding CreatedText}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
                <TabItem Header="컨테이너">
                <DataGrid ItemsSource="{Binding Usage.Containers}">
                    <DataGrid.Columns>
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="컨테이너 ID" Binding="{Binding ShortId}" Width="110"/>
                                <DataGridTextColumn Header="이미지" Binding="{Binding Image}" Width="220"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="90"/>
                                <DataGridTextColumn Header="쓰기 가능" Binding="{Binding FormattedSizeRw}" Width="110"/>
                                <DataGridTextColumn Header="루트 파일 시스템" Binding="{Binding FormattedSizeRootFs}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
                <TabItem Header="볼륨">
                <DataGrid ItemsSource="{Binding Usage.Volumes}">
                    <DataGrid.Columns>
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="드라이버" Binding="{Binding Driver}" Width="120"/>
                                <DataGridTextColumn Header="크기" Binding="{Binding FormattedSize}" Width="120"/>
                                <DataGridTextColumn Header="참조 수" Binding="{Binding RefCount}" Width="80"/>
                                <DataGridTextColumn Header="마운트 지점" Binding="{Binding Mountpoint}" Width="260"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
                <TabItem Header="빌드 캐시">
                <DataGrid ItemsSource="{Binding Usage.BuildCache}">
                    <DataGrid.Columns>
                                <DataGridTextColumn Header="캐시 ID" Binding="{Binding ShortId}" Width="110"/>
                                <DataGridTextColumn Header="종류" Binding="{Binding Type}" Width="110"/>
                                <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="크기" Binding="{Binding FormattedSize}" Width="110"/>
                                <DataGridCheckBoxColumn Header="사용 중" Binding="{Binding InUse}" Width="80"/>
                                <DataGridCheckBoxColumn Header="공유" Binding="{Binding Shared}" Width="80"/>
                                <DataGridTextColumn Header="마지막 사용" Binding="{Binding LastUsedText}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{StaticResource DialogFooterPanelStyle}" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="닫기" Click="CloseButton_Click" Width="82" MinHeight="38" Style="{StaticResource DialogSecondaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
