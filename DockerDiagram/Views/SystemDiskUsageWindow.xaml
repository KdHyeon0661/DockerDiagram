<Window x:Class="DockerDiagram.Views.SystemDiskUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Docker Disk Usage"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DDE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Docker Disk Usage" FontSize="20" FontWeight="SemiBold" Foreground="#222"/>
                    <TextBlock Text="{Binding ProfileName, StringFormat=Current engine: {0}}" FontSize="12" Foreground="#777" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" Width="86" Height="30"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Layers" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedLayersSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Images" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedImagesSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Containers" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedContainersSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Volumes" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedVolumesSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Build Cache" Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Usage.FormattedBuildCacheSize}" Style="{StaticResource SummaryValueStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" Margin="14,0,14,14">
            <TabItem Header="Images">
                <DataGrid ItemsSource="{Binding Usage.Images}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Repository:Tag" Binding="{Binding Repository}" Width="*"/>
                        <DataGridTextColumn Header="Image ID" Binding="{Binding ShortId}" Width="110"/>
                        <DataGridTextColumn Header="Containers" Binding="{Binding Containers}" Width="90"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="110"/>
                        <DataGridTextColumn Header="Shared" Binding="{Binding FormattedSharedSize}" Width="110"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Containers">
                <DataGrid ItemsSource="{Binding Usage.Containers}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Container ID" Binding="{Binding ShortId}" Width="110"/>
                        <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="220"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                        <DataGridTextColumn Header="Writable" Binding="{Binding FormattedSizeRw}" Width="110"/>
                        <DataGridTextColumn Header="Root FS" Binding="{Binding FormattedSizeRootFs}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Volumes">
                <DataGrid ItemsSource="{Binding Usage.Volumes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="120"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="120"/>
                        <DataGridTextColumn Header="Refs" Binding="{Binding RefCount}" Width="80"/>
                        <DataGridTextColumn Header="Mountpoint" Binding="{Binding Mountpoint}" Width="260"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Build Cache">
                <DataGrid ItemsSource="{Binding Usage.BuildCache}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cache ID" Binding="{Binding ShortId}" Width="110"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="110"/>
                        <DataGridCheckBoxColumn Header="In Use" Binding="{Binding InUse}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Shared" Binding="{Binding Shared}" Width="80"/>
                        <DataGridTextColumn Header="Last Used" Binding="{Binding LastUsedText}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Click="CloseButton_Click" Width="82" Height="30"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
