<Window x:Class="DockerDiagram.Views.BuildImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="이미지만 빌드" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource DialogWindowBackgroundBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="생성될 이미지 이름 (Tag)" Style="{StaticResource DialogSectionTitleStyle}"/>
        <TextBox x:Name="txtImageTag" Grid.Row="1" Padding="5" Margin="0,0,0,15" BorderBrush="{StaticResource DialogStrongBorderBrush}" ToolTip="예: my-custom-app:latest"/>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,5">
                <TextBlock Text="Dockerfile 내용" Style="{StaticResource DialogSectionTitleStyle}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Click="BtnBrowse_Click" Style="{StaticResource DialogSecondaryButtonStyle}" MinHeight="38" MinWidth="108">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource DialogFolderIcon}" Fill="{StaticResource DialogDockerBrush}" Width="14" Height="14" Stretch="Uniform"/><TextBlock Text="찾아보기..." Margin="6,0,0,0"/></StackPanel>
                </Button>
            </Grid>
            <TextBox x:Name="txtDockerfile" Grid.Row="1" Style="{StaticResource DialogCodeTextBoxStyle}" TextWrapping="Wrap" Padding="10"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="빌드" Width="100" Margin="0,0,10,0" Click="BtnBuild_Click" Style="{StaticResource DialogPrimaryButtonStyle}"/>
        <Button Content="취소" Width="80" Click="BtnCancel_Click" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
