<Window x:Class="DockerDiagram.Views.SwarmSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swarm Setup"
        Width="660" Height="610" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9CED4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#7652A8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7652A8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Docker Swarm 설정" FontSize="23" FontWeight="SemiBold" Foreground="#27313B"/>
            <TextBlock Text="현재 Docker Engine의 가입 상태와 가능한 클러스터 작업을 확인합니다."
                       Margin="0,5,0,0" FontSize="12" Foreground="#68727E"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14"
                Background="White" BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="12" Height="12" CornerRadius="6" Background="#7652A8" VerticalAlignment="Top" Margin="0,5,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusTitleText" Text="상태 확인 중..." FontSize="16" FontWeight="SemiBold" Foreground="#343A43"/>
                    <TextBlock x:Name="StatusDescriptionText" Margin="0,4,0,0" Foreground="#68727E" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="새로고침" Width="86" Height="30" Margin="14,0,0,0"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="14" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="7" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Node ID" Foreground="#68727E"/>
                        <TextBlock x:Name="NodeIdText" Grid.Column="1" Text="-" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="Node Address" Foreground="#68727E" Margin="0,8,0,0"/>
                        <TextBlock x:Name="NodeAddressText" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Text="Managers" Foreground="#68727E" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ManagersText" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="SemiBold"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="InactiveActionsPanel" Visibility="Collapsed">
                    <TextBlock Text="가능한 작업" FontWeight="SemiBold" Foreground="#343A43" Margin="2,0,0,8"/>
                    <Border Padding="14" Margin="0,0,0,10" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="새 Swarm 초기화" FontWeight="SemiBold" FontSize="14" Foreground="#343A43"/>
                            <TextBlock x:Name="InitializationGuidanceText"
                                       Text="여러 PC를 연결하려면 다른 노드에서 접근 가능한 LAN 주소를 선택하세요. 자동 후보가 맞지 않으면 직접 입력할 수 있습니다."
                                       Margin="0,4,0,12" FontSize="10.5" Foreground="#68727E" TextWrapping="Wrap"/>

                            <TextBlock Text="Advertise Address" FontWeight="SemiBold" Foreground="#4C5661"/>
                            <ComboBox x:Name="AdvertiseAddressBox" IsEditable="True" Margin="0,4,0,10" Height="30"
                                      IsTextSearchEnabled="False" StaysOpenOnEdit="True"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Listen Address" FontWeight="SemiBold" Foreground="#4C5661"/>
                                    <TextBox x:Name="ListenAddressTextBox" Text="0.0.0.0:2377" Margin="0,4,0,0" Height="30" Padding="7,4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Data Path Port" FontWeight="SemiBold" Foreground="#4C5661"/>
                                    <TextBox x:Name="DataPathPortTextBox" Text="0" Margin="0,4,0,0" Height="30" Padding="7,4"
                                             ToolTip="0이면 Docker 기본값(일반적으로 UDP 4789)을 사용합니다."/>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="AutoLockManagersCheckBox" Content="Manager 자동 잠금 활성화"
                                      Visibility="Collapsed" IsEnabled="False"/>

                            <Button x:Name="InitializeButton" Content="새 Swarm 초기화"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0" HorizontalContentAlignment="Center"
                                    Click="InitializeSwarm_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="2,0,0,10" TextWrapping="Wrap" Foreground="#68727E"
                               Text="기존 Swarm에 이 PC를 추가하려면 Manager 세션의 Swarm 설정에서 '다른 PC를 노드로 추가'를 사용하세요."/>
                </StackPanel>

                <StackPanel x:Name="ManagerActionsPanel" Visibility="Collapsed">
                    <TextBlock Text="Manager 작업" FontWeight="SemiBold" Foreground="#343A43" Margin="2,0,0,8"/>
                    <Button x:Name="AddTargetNodeButton" Content="다른 PC를 노드로 추가"
                            Style="{StaticResource PrimaryActionButtonStyle}" Click="AddTargetNode_Click"
                            ToolTip="SSH로 대상 Docker Engine과 Swarm 미가입 상태를 먼저 검증합니다."/>
                    <Border x:Name="TargetConnectionPanel" Visibility="Collapsed" Padding="14" Margin="0,0,0,10"
                            Background="#EAF6EF" BorderBrush="#8DC6A2" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="검증된 대상 PC" FontWeight="SemiBold" FontSize="14" Foreground="#295D3C"/>
                            <TextBlock x:Name="TargetConnectionSummaryText" Margin="0,5,0,10" Foreground="#3E5C49" TextWrapping="Wrap"/>
                            <Button x:Name="RecheckTargetButton" Content="대상 상태 다시 확인"
                                    Style="{StaticResource ActionButtonStyle}" Click="RecheckTarget_Click"/>
                            <TextBlock Text="Manager Endpoint" FontWeight="SemiBold" Foreground="#3E5C49"/>
                            <TextBox x:Name="TargetManagerAddressTextBox" Margin="0,4,0,10" Height="30" Padding="7,4"
                                     ToolTip="대상 PC가 접근할 수 있는 Manager 주소와 포트입니다."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DisconnectTargetButton" Content="연결 해제" Style="{StaticResource ActionButtonStyle}"
                                        HorizontalContentAlignment="Center" Margin="0" Click="DisconnectTarget_Click"/>
                                <Button x:Name="JoinTargetButton" Grid.Column="2" Content="Swarm Join 실행"
                                        Style="{StaticResource PrimaryActionButtonStyle}" HorizontalContentAlignment="Center"
                                        Margin="0" Click="JoinTarget_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button x:Name="JoinInfoButton" Content="Worker / Manager Join 정보 보기"
                            Style="{StaticResource ActionButtonStyle}" Click="ShowJoinInfo_Click"/>
                    <Button x:Name="LeaveManagerButton" Content="이 Manager를 Swarm에서 탈퇴"
                            Style="{StaticResource ActionButtonStyle}" Click="LeaveSwarm_Click"/>

                    <Border x:Name="JoinInfoPanel" Visibility="Collapsed" Padding="14" Margin="0,4,0,10"
                            Background="White" BorderBrush="#B9A2D4" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="Join 정보" FontWeight="SemiBold" FontSize="14" Foreground="#343A43"/>
                            <TextBlock Text="Token은 이 창의 메모리에서만 유지되며 저장 파일이나 로그에 기록하지 않습니다."
                                       Margin="0,4,0,12" FontSize="10.5" Foreground="#68727E" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="WorkerRoleRadio" Content="Worker" GroupName="JoinRole"
                                             IsChecked="True" Checked="JoinRole_Changed" Margin="0,0,18,0"/>
                                <RadioButton x:Name="ManagerRoleRadio" Content="Manager" GroupName="JoinRole"
                                             Checked="JoinRole_Changed"/>
                            </StackPanel>

                            <TextBlock Text="Manager Address" FontWeight="SemiBold" Foreground="#4C5661"/>
                            <TextBox x:Name="JoinManagerAddressTextBox" Margin="0,4,0,2" Height="30" Padding="7,4"
                                     TextChanged="JoinManagerAddress_TextChanged"/>
                            <TextBlock x:Name="ManagerAddressErrorText" Foreground="#B33A3A" FontSize="10" Margin="0,0,0,8"/>

                            <TextBlock Text="Join Token" FontWeight="SemiBold" Foreground="#4C5661"/>
                            <Grid Margin="0,4,0,6">
                                <PasswordBox x:Name="JoinTokenPasswordBox" Height="30" Padding="7,4" IsEnabled="False"/>
                                <TextBox x:Name="JoinTokenVisibleTextBox" Height="30" Padding="7,4"
                                         IsReadOnly="True" Visibility="Collapsed"/>
                            </Grid>
                            <CheckBox x:Name="RevealJoinTokenCheckBox" Content="Token과 명령 표시"
                                      Margin="0,0,0,10" Checked="RevealJoinToken_Changed" Unchecked="RevealJoinToken_Changed"/>

                            <TextBlock Text="Join Command" FontWeight="SemiBold" Foreground="#4C5661"/>
                            <TextBox x:Name="JoinCommandTextBox" Margin="0,4,0,10" MinHeight="52" Padding="7"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Token 복사" Style="{StaticResource ActionButtonStyle}"
                                        HorizontalContentAlignment="Center" Margin="0" Click="CopyJoinToken_Click"/>
                                <Button Grid.Column="2" Content="Join 명령 복사" Style="{StaticResource PrimaryActionButtonStyle}"
                                        HorizontalContentAlignment="Center" Margin="0" Click="CopyJoinCommand_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="WorkerActionsPanel" Visibility="Collapsed">
                    <TextBlock Text="Worker 작업" FontWeight="SemiBold" Foreground="#343A43" Margin="2,0,0,8"/>
                    <Button x:Name="WorkerManagerInfoButton" Content="현재 Manager 정보 보기"
                            Style="{StaticResource ActionButtonStyle}" Click="ShowCurrentManagerInfo_Click"/>
                    <Button x:Name="LeaveWorkerButton" Content="이 Worker를 Swarm에서 탈퇴"
                            Style="{StaticResource ActionButtonStyle}" Click="LeaveSwarm_Click"/>
                </StackPanel>

                <Border x:Name="WaitingPanel" Visibility="Collapsed" Padding="14"
                        Background="#FFF8E5" BorderBrush="#E8CE86" BorderThickness="1" CornerRadius="6">
                    <TextBlock Text="참가 처리가 끝난 뒤 새로고침해 주세요. 처리 중에는 중복 Join을 실행하지 않습니다."
                               Foreground="#6E5A20" TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Padding="14"
                        Background="#FDEEEE" BorderBrush="#E2A8A8" BorderThickness="1" CornerRadius="6">
                    <TextBlock x:Name="ErrorText" Foreground="#8B3333" TextWrapping="Wrap"/>
                </Border>

                <Border Margin="0,14,0,0" Padding="12" Background="#EEE8F7" CornerRadius="6">
                    <TextBlock Text="실패하거나 응답이 끊기면 상태를 다시 확인해 주세요. 이미 가입한 노드에는 Join을 재실행하지 않습니다."
                               FontSize="10.5" Foreground="#5D467B" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="LoadingText" Text="" Foreground="#68727E" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Content="닫기" Width="90" Height="32" HorizontalAlignment="Right" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
