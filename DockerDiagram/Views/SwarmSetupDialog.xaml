<Window x:Class="DockerDiagram.Views.SwarmSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="Swarm 설정"
        Width="660" Height="610" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonBaseStyle}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DialogSwarmBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogSwarmBrush}"/>
        </Style>
        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DialogDangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBrush}"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Docker Swarm 설정" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock Text="현재 Docker Engine의 가입 상태와 가능한 클러스터 작업을 확인합니다."
                       Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource DialogMutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14" Style="{StaticResource DialogBodyCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource DialogSwarmBrush}" VerticalAlignment="Top" Margin="0,5,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusTitleText" Text="상태 확인 중..." FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}"/>
                    <TextBlock x:Name="StatusDescriptionText" Margin="0,4,0,0" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="새로고침" Width="86" MinHeight="38" Margin="14,0,0,0"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="14" Style="{StaticResource DialogBodyCardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <TextBlock Text="노드 ID" Foreground="{StaticResource DialogMutedTextBrush}"/>
                        <TextBlock x:Name="NodeIdText" Grid.Column="1" Text="-" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="노드 주소" Foreground="{StaticResource DialogMutedTextBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="NodeAddressText" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Text="Manager 수" Foreground="{StaticResource DialogMutedTextBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ManagersText" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="SemiBold"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="InactiveActionsPanel" Visibility="Collapsed">
                    <TextBlock Text="가능한 작업" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}" Margin="2,0,0,8"/>
                    <Border Padding="14" Margin="0,0,0,10" Style="{StaticResource DialogBodyCardStyle}">
                        <StackPanel>
                            <TextBlock Text="새 Swarm 초기화" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource DialogTextBrush}"/>
                            <TextBlock x:Name="InitializationGuidanceText"
                                       Text="여러 PC를 연결하려면 다른 노드에서 접근 가능한 LAN 주소를 선택하세요. 자동 후보가 맞지 않으면 직접 입력할 수 있습니다."
                                       Margin="0,4,0,12" FontSize="10.5" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>

                        <TextBlock Text="광고 주소 (Advertise Address)" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            <ComboBox x:Name="AdvertiseAddressBox" IsEditable="True" Margin="0,4,0,10" MinHeight="38"
                                      IsTextSearchEnabled="False" StaysOpenOnEdit="True"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                <TextBlock Text="수신 주소 (Listen Address)" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                                    <TextBox x:Name="ListenAddressTextBox" Text="0.0.0.0:2377" Margin="0,4,0,0" MinHeight="38" Padding="7,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                <TextBlock Text="데이터 경로 포트" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                                    <TextBox x:Name="DataPathPortTextBox" Text="0" Margin="0,4,0,0" MinHeight="38" Padding="7,5"
                                             ToolTip="0이면 Docker 기본값(일반적으로 UDP 4789)을 사용합니다."/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="InitializeButton" Content="새 Swarm 초기화"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0" HorizontalContentAlignment="Center"
                                    Click="InitializeSwarm_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="2,0,0,10" TextWrapping="Wrap" Foreground="{StaticResource DialogMutedTextBrush}"
                               Text="기존 Swarm에 이 PC를 추가하려면 Manager 세션의 Swarm 설정에서 '다른 PC를 노드로 추가'를 사용하세요."/>
                </StackPanel>

                <StackPanel x:Name="ManagerActionsPanel" Visibility="Collapsed">
                    <TextBlock Text="Manager 작업" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}" Margin="2,0,0,8"/>
                    <Button x:Name="AddTargetNodeButton" Content="다른 PC를 노드로 추가"
                            Style="{StaticResource PrimaryActionButtonStyle}" Click="AddTargetNode_Click"
                            ToolTip="SSH로 대상 Docker Engine과 Swarm 미가입 상태를 먼저 검증합니다."/>
                    <Border x:Name="TargetConnectionPanel" Visibility="Collapsed" Padding="14" Margin="0,0,0,10"
                            Background="{StaticResource DialogSuccessSurfaceBrush}" BorderBrush="{StaticResource DialogSuccessBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="검증된 대상 PC" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource DialogSuccessTextBrush}"/>
                            <TextBlock x:Name="TargetConnectionSummaryText" Margin="0,5,0,10" Foreground="{StaticResource DialogSuccessTextBrush}" TextWrapping="Wrap"/>
                            <Button x:Name="RecheckTargetButton" Content="대상 상태 다시 확인"
                                    Style="{StaticResource ActionButtonStyle}" Click="RecheckTarget_Click"/>
                                    <TextBlock Text="Manager 엔드포인트" FontWeight="SemiBold" Foreground="{StaticResource DialogSuccessTextBrush}"/>
                            <TextBox x:Name="TargetManagerAddressTextBox" Margin="0,4,0,10" MinHeight="38" Padding="7,5"
                                     ToolTip="대상 PC가 접근할 수 있는 Manager 주소와 포트입니다."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DisconnectTargetButton" Content="연결 해제" Style="{StaticResource ActionButtonStyle}"
                                        HorizontalContentAlignment="Center" Margin="0" Click="DisconnectTarget_Click"/>
                                <Button x:Name="JoinTargetButton" Grid.Column="2" Content="Swarm Join 실행"
                                        Style="{StaticResource PrimaryActionButtonStyle}" HorizontalContentAlignment="Center"
                                        Margin="0" Click="JoinTarget_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button x:Name="JoinInfoButton" Content="Worker / Manager Join 정보 보기"
                            Style="{StaticResource ActionButtonStyle}" Click="ShowJoinInfo_Click"/>
                    <Button x:Name="LeaveManagerButton" Content="이 Manager를 Swarm에서 탈퇴"
                            Style="{StaticResource DangerActionButtonStyle}" Click="LeaveSwarm_Click"/>

                    <Border x:Name="JoinInfoPanel" Visibility="Collapsed" Padding="14" Margin="0,4,0,10"
                            Background="{StaticResource DialogSurfaceBrush}" BorderBrush="{StaticResource DialogSwarmBorderBrush}" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="Join 정보" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource DialogTextBrush}"/>
                            <TextBlock Text="Token은 이 창의 메모리에서만 유지되며 저장 파일이나 로그에 기록하지 않습니다."
                                       Margin="0,4,0,12" FontSize="10.5" Foreground="{StaticResource DialogMutedTextBrush}" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="WorkerRoleRadio" Content="Worker" GroupName="JoinRole"
                                             IsChecked="True" Checked="JoinRole_Changed" Margin="0,0,18,0"/>
                                <RadioButton x:Name="ManagerRoleRadio" Content="Manager" GroupName="JoinRole"
                                             Checked="JoinRole_Changed"/>
                            </StackPanel>

                        <TextBlock Text="Manager 주소" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            <TextBox x:Name="JoinManagerAddressTextBox" Margin="0,4,0,2" MinHeight="38" Padding="7,5"
                                     TextChanged="JoinManagerAddress_TextChanged"/>
                            <TextBlock x:Name="ManagerAddressErrorText" Foreground="{StaticResource DialogErrorTextBrush}" FontSize="10" Margin="0,0,0,8"/>

                        <TextBlock Text="Join 토큰" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            <Grid Margin="0,4,0,6">
                                <PasswordBox x:Name="JoinTokenPasswordBox" MinHeight="38" Padding="7,5" IsEnabled="False"/>
                                <TextBox x:Name="JoinTokenVisibleTextBox" MinHeight="38" Padding="7,5"
                                         IsReadOnly="True" Visibility="Collapsed"/>
                            </Grid>
                            <CheckBox x:Name="RevealJoinTokenCheckBox" Content="Token과 명령 표시"
                                      Margin="0,0,0,10" Checked="RevealJoinToken_Changed" Unchecked="RevealJoinToken_Changed"/>

                        <TextBlock Text="Join 명령" FontWeight="SemiBold" Foreground="{StaticResource DialogMutedTextBrush}"/>
                            <TextBox x:Name="JoinCommandTextBox" Margin="0,4,0,10" MinHeight="52" Padding="7"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Token 복사" Style="{StaticResource ActionButtonStyle}"
                                        HorizontalContentAlignment="Center" Margin="0" Click="CopyJoinToken_Click"/>
                                <Button Grid.Column="2" Content="Join 명령 복사" Style="{StaticResource PrimaryActionButtonStyle}"
                                        HorizontalContentAlignment="Center" Margin="0" Click="CopyJoinCommand_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="WorkerActionsPanel" Visibility="Collapsed">
                    <TextBlock Text="Worker 작업" FontWeight="SemiBold" Foreground="{StaticResource DialogTextBrush}" Margin="2,0,0,8"/>
                    <Button x:Name="WorkerManagerInfoButton" Content="현재 Manager 정보 보기"
                            Style="{StaticResource ActionButtonStyle}" Click="ShowCurrentManagerInfo_Click"/>
                    <Button x:Name="LeaveWorkerButton" Content="이 Worker를 Swarm에서 탈퇴"
                            Style="{StaticResource DangerActionButtonStyle}" Click="LeaveSwarm_Click"/>
                </StackPanel>

                <Border x:Name="WaitingPanel" Visibility="Collapsed" Padding="14" Style="{StaticResource DialogWarningPanelStyle}">
                    <TextBlock Text="참가 처리가 끝난 뒤 새로고침해 주세요. 처리 중에는 중복 Join을 실행하지 않습니다."
                               Foreground="{StaticResource DialogWarningTextBrush}" TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Padding="14" Style="{StaticResource DialogErrorPanelStyle}">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DialogErrorTextBrush}" TextWrapping="Wrap"/>
                </Border>

                <Border Margin="0,14,0,0" Padding="12" Background="{StaticResource DialogSwarmSurfaceBrush}" CornerRadius="6">
                    <TextBlock Text="실패하거나 응답이 끊기면 상태를 다시 확인해 주세요. 이미 가입한 노드에는 Join을 재실행하지 않습니다."
                               FontSize="10.5" Foreground="{StaticResource DialogSwarmTextBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="LoadingText" Text="" Style="{StaticResource DialogLoadingTextStyle}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Content="닫기" Width="90" MinHeight="38" HorizontalAlignment="Right" Style="{StaticResource DialogSecondaryButtonStyle}" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
