<Window x:Class="DockerDiagram.Views.ContainerRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindowStyle}"
        Title="컨테이너 이름 변경"
        Width="420"
        Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource DialogWindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DialogControlDefaults.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="컨테이너 이름 변경" Style="{StaticResource DialogTitleStyle}"/>
        <TextBlock Grid.Row="1" Text="새 Docker 컨테이너 이름" Margin="0,12,0,4" Foreground="{StaticResource DialogTextBrush}"/>
        <TextBox x:Name="NameBox"
                 Grid.Row="2"
                 MinHeight="38"
                 VerticalContentAlignment="Center"
                 Padding="6"
                 BorderBrush="{StaticResource DialogStrongBorderBrush}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" Click="OkButton_Click" Width="76" Margin="0,0,8,0" Style="{StaticResource DialogPrimaryButtonStyle}"/>
            <Button Content="취소" Click="CancelButton_Click" Width="76" Style="{StaticResource DialogSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
